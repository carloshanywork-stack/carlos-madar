NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Optional local path overrides. Leave unset to use the defaults.
# MADAR_V2_DATA_DIR=./data
# MADAR_V2_DATABASE_PATH=./data/madar-v2.sqlite
# MADAR_V2_STORAGE_ROOT=../storage
# MADAR_V2_BACKUP_ROOT=./Backups
# Optional local raster MBTiles map package (defaults to ./data/offline-maps.mbtiles).
# MADAR_V2_OFFLINE_MAP_PATH=./data/offline-maps.mbtiles
# Ubuntu dual-partition deployment: set this to the exact mounted filesystem
# root. Defaults become <mount>/data, <mount>/uploads, and <mount>/Backups.
# The service refuses to start unless this is a mounted Linux filesystem on a
# different device from /. Any explicit MADAR_V2_* path must remain under it.
# STORAGE_MOUNT_PATH=/mnt/storage
# Optional: unattended first administrator bootstrap (12+ characters).
# Otherwise, create the administrator in the first-run setup screen.
# MADAR_INITIAL_ADMIN_PASSWORD=
# Optional V2-specific signing key. If unset, the repository-root JWT_SECRET is used.
# MADAR_V2_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Offline representative attendance older than this is preserved for administrator review.
# Must be a positive finite number; defaults to 24 hours.
# REP_ATTENDANCE_MAX_OFFLINE_AGE_HOURS=24
# COOKIE_SECURE defaults to true in production; keep false only for local HTTP.
# COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Default MADAR V2 API host. Normal Android builds bundle the UI and connect to
# this HTTPS API. Android build scripts ignore stale live-reload environment
# flags; local live reload requires passing --live-reload to the build command.
MADAR_REP_SERVER_URL=https://carlos-pc.tail852ef0.ts.net
# For local USB live-reload only, temporarily use this URL and pass
# --live-reload to android:sync or android:debug, then run adb reverse tcp:3000 tcp:3000.
# MADAR_REP_SERVER_URL=http://localhost:3000
