<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Completely omit RepLocationService and continuous background GPS tracking in Manager app -->
        <service
            android:name=".RepLocationService"
            tools:node="remove" />
    </application>

    <!-- Completely omit background location tracking permissions in Manager app -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove" />
</manifest>
