#madar-app .madar-footer { display: flex; justify-content: space-between; gap: 10px; padding: 0 clamp(18px, 3vw, 42px) 20px; color: #8995a6; font-size: 9px; }
#madar-app .madar-operations-alert { position: sticky; z-index: 70; top: 0; display: flex; align-items: center; gap: 14px; padding: 10px clamp(18px, 3vw, 42px); color: #66480f; border-bottom: 1px solid #ead39c; background: #fff4d8; font-size: 12px; font-weight: 750; }
#madar-app .madar-operations-alert span { flex: 1; }
