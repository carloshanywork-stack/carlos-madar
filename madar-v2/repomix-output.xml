#madar-app .madar-sidebar-caption { padding: 0 12px; color: #8193a9; font-size: 10px; font-weight: 800; letter-spacing: .12em; }
#madar-app .madar-nav { display: grid; gap: 5px; margin-top: 10px; }
#madar-app .madar-nav-link {
