<file path="client/src/modules/accounting/MonthlyAttendanceMatrix.jsx">
import { Fragment, useCallback, useEffect, useMemo, useState } from 'react';
import { api } from '../../lib/api.js';
import { errorMessage } from '../../lib/format.js';
import Alert from '../../components/ui/Alert.jsx';
import Button from '../../components/ui/Button.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Toast from '../../components/ui/Toast.jsx';
import { useToast } from '../../lib/useToast.js';
import './MonthlyAttendanceMatrix.css';

const STATUS = {
  present: { label: 'حاضر', icon: '✔', className: 'badge-present' },
  absent: { label: 'غائب', icon: '✖', className: 'badge-absent' },
  leave: { label: 'إجازة', icon: '🏖️', className: 'badge-leave' },
  late: { label: 'متأخر / نصف يوم', icon: '⏰', className: 'badge-late' },
};
const WEEKDAY = ['ح', 'ن', 'ث', 'ر', 'خ', 'ج', 'س'];
const MONTH_PATTERN = /^\d{4}-(0[1-9]|1[0-2])$/;

function localMonth(date = new Date()) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
}

function dateFor(month, day) {
  return `${month}-${String(day).padStart(2, '0')}`;
}

function cellKey(employeeId, date) {
  return `${employeeId}:${date}`;
}

function recordMap(records) {
  return Object.fromEntries(records.map((record) => [cellKey(record.employee_id, record.date), {
    status: record.status,
    overtimeHours: Number(record.overtime_hours ?? 0),
    notes: record.notes ?? '',
  }]));
}

function daySummary(employeeId, days, records) {
  let present = 0;
  let absent = 0;
  let leave = 0;
  let overtime = 0;
  for (const day of days) {
    const record = records[cellKey(employeeId, day.date)];
    if (!record) continue;
    if (['present', 'late'].includes(record.status)) present += 1;
    if (record.status === 'absent') absent += 1;
    if (record.status === 'leave') leave += 1;
    overtime += Number(record.overtimeHours ?? 0);
  }
  return { present, absent, leave, overtime: Math.round(overtime * 100) / 100 };
}

export default function MonthlyAttendanceMatrix() {
  const [month, setMonth] = useState(localMonth);
  const [employees, setEmployees] = useState([]);
  const [records, setRecords] = useState({});
  const [dirty, setDirty] = useState(() => new Set());
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const [editor, setEditor] = useState(null);
  const { notice, showToast, clearToast } = useToast();

  const daysInMonth = useMemo(() => {
    if (!MONTH_PATTERN.test(month)) return 0;
    const [year, number] = month.split('-').map(Number);
    return new Date(year, number, 0).getDate();
  }, [month]);
  const days = useMemo(() => Array.from({ length: daysInMonth }, (_, index) => {
    const number = index + 1;
    const date = dateFor(month, number);
    const weekday = new Date(`${date}T12:00:00`).getDay();
    return { number, date, weekday, label: WEEKDAY[weekday], weekend: weekday === 5 || weekday === 6 };
  }), [daysInMonth, month]);
  const departments = useMemo(() => [...new Set(employees.map((employee) => employee.department || '—'))], [employees]);
  const today = new Date();
  const todayDate = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
  const dirtyCount = dirty.size;

  const loadMonth = useCallback(async (selectedMonth, { preserveError = false } = {}) => {
    setLoading(true);
    if (!preserveError) setError('');
    try {
      const data = await api.get(`/api/employees/attendance/monthly?month=${encodeURIComponent(selectedMonth)}`);
      setEmployees(data.employees ?? []);
      setRecords(recordMap(data.records ?? []));
      setDirty(new Set());
    } catch (caught) {
      setError(errorMessage(caught));
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void loadMonth(month); }, [month, loadMonth]);

  useEffect(() => {
    const refreshAttendance = (event) => {
      const update = event.detail ?? {};
      const affectsMonth = update.month === month || update.workDate?.startsWith(`${month}-`);
      if (affectsMonth && dirty.size === 0) void loadMonth(month);
    };
    window.addEventListener('madar:attendance-updated', refreshAttendance);
    return () => window.removeEventListener('madar:attendance-updated', refreshAttendance);
  }, [dirty.size, loadMonth, month]);

  function editCell(employeeId, date, patch) {
    const key = cellKey(employeeId, date);
    setRecords((current) => ({
      ...current,
      [key]: { status: 'present', overtimeHours: 0, notes: '', ...current[key], ...patch },
    }));
    setDirty((current) => new Set(current).add(key));
  }

  function toggleAttendance(employeeId, date) {
    const current = records[cellKey(employeeId, date)];
    editCell(employeeId, date, { status: current?.status === 'present' ? 'absent' : 'present' });
  }

  function openEditor(event, employeeId, date) {
    const rect = event.currentTarget.getBoundingClientRect();
    const width = Math.min(340, window.innerWidth - 24);
    setEditor({
      employeeId,
      date,
      left: Math.max(12, Math.min(rect.left, window.innerWidth - width - 12)),
      top: Math.max(12, Math.min(rect.bottom + 5, window.innerHeight - 260)),
    });
  }

  async function saveChanges() {
    if (!dirty.size) return;
    setSaving(true);
    setError('');
    try {
      const changedRecords = [...dirty].map((key) => {
        const [employeeId, date] = key.split(':');
        const record = records[key];
        return {
          employeeId: Number(employeeId), date, status: record.status,
          overtimeHours: Number(record.overtimeHours ?? 0), notes: record.notes ?? '',
        };
      });
      const saved = await api.post('/api/employees/attendance/monthly', { month, records: changedRecords });
      setRecords(recordMap(saved.records ?? []));
      setEmployees(saved.employees ?? []);
      setDirty(new Set());
      setEditor(null);
      showToast(`تم حفظ ${changedRecords.length} سجل حضور لهذا الشهر.`);
    } catch (caught) {
      setError(errorMessage(caught));
    } finally {
      setSaving(false);
    }
  }

  async function markAllForToday() {
    if (dirty.size) return;
    setSaving(true);
    setError('');
    try {
      const result = await api.post('/api/employees/attendance/mark-all-present', { date: todayDate });
      await loadMonth(month, { preserveError: true });
      showToast(`تم تسجيل الحضور لجميع الموظفين النشطين (${result.count}).`);
    } catch (caught) {
      setError(errorMessage(caught));
    } finally {
      setSaving(false);
    }
  }

  async function exportMonthly() {
    setError('');
    try {
      const response = await fetch(`/api/employees/attendance/export-monthly?month=${encodeURIComponent(month)}`, { credentials: 'include' });
      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        throw new Error(payload.error || `تعذر التصدير (${response.status})`);
      }
      const file = await response.blob();
      const url = URL.createObjectURL(file);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `كشف-الحضور-${month}.xlsx`;
      document.body.append(anchor);
      anchor.click();
      anchor.remove();
      URL.revokeObjectURL(url);
    } catch (caught) {
      setError(errorMessage(caught));
    }
  }

  function changeMonth(delta) {
    if (dirty.size && !window.confirm('توجد تعديلات غير محفوظة. هل تريد تغيير الشهر وإهمالها؟')) return;
    const [year, number] = month.split('-').map(Number);
    const next = new Date(year, number - 1 + delta, 1);
    setMonth(localMonth(next));
    setEditor(null);
  }

  function chooseMonth(value) {
    if (!MONTH_PATTERN.test(value)) return;
    if (dirty.size && !window.confirm('توجد تعديلات غير محفوظة. هل تريد تغيير الشهر وإهمالها؟')) return;
    setMonth(value);
    setEditor(null);
  }

  const totalColumns = 2 + daysInMonth + 4;

  return (
    <section className="madar-attendance-matrix madar-panel madar-section">
      <div className="madar-panel-header madar-attendance-toolbar">
        <div>
          <h2>مصفوفة الحضور الشهري</h2>
          <p>انقر ✔ / ✖ للتبديل السريع، أو افتح خيارات الخلية لتسجيل الإجازة والتأخير والإضافي والملاحظات.</p>
        </div>
        <div className="madar-attendance-toolbar-actions">
          <div className="madar-attendance-month-nav" dir="ltr">
            <Button variant="secondary" size="small" aria-label="الشهر السابق" onClick={() => changeMonth(-1)}>◀</Button>
            <input aria-label="الشهر المحدد" type="month" value={month} onChange={(event) => chooseMonth(event.target.value)} />
            <Button variant="secondary" size="small" aria-label="الشهر التالي" onClick={() => changeMonth(1)}>▶</Button>
          </div>
          {todayDate.startsWith(`${month}-`) && <Button variant="secondary" size="small" disabled={saving || Boolean(dirtyCount)} title={dirtyCount ? 'احفظ التعديلات قبل التحضير الجماعي' : ''} onClick={markAllForToday}>⚡ تحضير كل موظفي اليوم</Button>}
          <Button variant="secondary" size="small" disabled={saving || Boolean(dirtyCount)} title={dirtyCount ? 'احفظ التعديلات قبل التصدير' : ''} onClick={exportMonthly}>📥 تصدير كشف الحضور (Excel)</Button>
          <Button icon="check" disabled={saving || !dirtyCount} onClick={saveChanges}>{saving ? 'جارٍ الحفظ…' : dirtyCount ? `حفظ كشف الحضور (${dirtyCount})` : 'حفظ كشف الحضور'}</Button>
        </div>
      </div>
      {error && <div className="madar-panel-pad"><Alert tone="error">{error}</Alert></div>}
      {loading ? <div className="madar-panel-pad"><LoadingState /></div> : employees.length ? (
        <div className="madar-attendance-grid-scroll">
          <table className="madar-attendance-grid" dir="rtl">
            <thead>
              <tr>
                <th className="madar-attendance-sticky madar-attendance-employee">الموظف</th>
                <th className="madar-attendance-sticky madar-attendance-department">القسم</th>
                {days.map((day) => <th key={day.date} className={day.weekend ? 'madar-day-weekend' : ''}>
                  <span className="madar-attendance-weekday">{day.label}</span>
                  <strong>{day.number}</strong>
                  {day.date === todayDate && <button type="button" className="madar-attendance-bulk" disabled={saving || Boolean(dirtyCount)} title="تحضير جميع الموظفين النشطين" onClick={markAllForToday}>⚡ الكل</button>}
                </th>)}
                <th className="madar-attendance-summary-head">حضور</th>
                <th className="madar-attendance-summary-head">غياب</th>
                <th className="madar-attendance-summary-head">إجازات</th>
                <th className="madar-attendance-summary-head">إضافي (س)</th>
              </tr>
            </thead>
            <tbody>
              {departments.map((department) => <Fragment key={department}>
                <tr key={`department-${department}`} className="madar-attendance-department-row">
                  <th colSpan={totalColumns}>{department}</th>
                </tr>
                {employees.filter((employee) => (employee.department || '—') === department).map((employee) => {
                  const summary = daySummary(employee.employee_id, days, records);
                  return <tr key={employee.employee_id}>
                    <th scope="row" className="madar-attendance-sticky madar-attendance-employee">{employee.name}</th>
                    <td className="madar-attendance-sticky madar-attendance-department">{employee.department || '—'}</td>
                    {days.map((day) => {
                      const key = cellKey(employee.employee_id, day.date);
                      const record = records[key];
                      const badge = record ? STATUS[record.status] : null;
                      return <td key={day.date} className={`madar-attendance-cell ${day.weekend ? 'madar-day-weekend' : ''} ${dirty.has(key) ? 'is-dirty' : ''}`}>
                        <button type="button" className={`madar-attendance-cell-status ${badge?.className ?? 'badge-empty'}`} title={`${employee.name} · ${day.date}${badge ? ` · ${badge.label}` : ' · غير مسجل'}`} disabled={saving} onClick={() => toggleAttendance(employee.employee_id, day.date)}>
                          {badge?.icon ?? '—'}
                        </button>
                        <button type="button" className="madar-attendance-cell-edit" aria-label={`خيارات حضور ${employee.name} بتاريخ ${day.date}`} title="الحالة والإضافي والملاحظات" disabled={saving} onClick={(event) => openEditor(event, employee.employee_id, day.date)}>⋯</button>
                      </td>;
                    })}
                    <td className="madar-attendance-summary-value">{summary.present}</td>
                    <td className="madar-attendance-summary-value">{summary.absent}</td>
                    <td className="madar-attendance-summary-value">{summary.leave}</td>
                    <td className="madar-attendance-summary-value">{summary.overtime}</td>
                  </tr>;
                })}
              </Fragment>)}
            </tbody>
          </table>
        </div>
      ) : <div className="madar-panel-pad"><EmptyState icon="users" title="لا يوجد موظفون نشطون" description="أضف موظفاً نشطاً لبدء تسجيل الحضور." /></div>}

      {editor && (() => {
        const employee = employees.find((item) => item.employee_id === editor.employeeId);
        const key = cellKey(editor.employeeId, editor.date);
        const record = records[key] ?? { status: 'present', overtimeHours: 0, notes: '' };
        return <div className="madar-attendance-cell-editor" role="dialog" aria-label={`خيارات حضور ${employee?.name ?? ''}`} style={{ left: editor.left, top: editor.top }}>
          <div className="madar-attendance-editor-header"><strong>{employee?.name} · {editor.date}</strong><button type="button" aria-label="إغلاق" onClick={() => setEditor(null)}>×</button></div>
          <label>الحالة<select value={record.status} onChange={(event) => editCell(editor.employeeId, editor.date, { status: event.target.value })}>{Object.entries(STATUS).map(([value, item]) => <option key={value} value={value}>{item.icon} {item.label}</option>)}</select></label>
          <label>ساعات إضافية<input type="number" min="0" max="24" step="0.25" value={record.overtimeHours} onChange={(event) => editCell(editor.employeeId, editor.date, { overtimeHours: event.target.value === '' ? 0 : Number(event.target.value) })} /></label>
          <label>ملاحظات<input maxLength="1000" value={record.notes} onChange={(event) => editCell(editor.employeeId, editor.date, { notes: event.target.value })} /></label>
          <Button size="small" onClick={() => setEditor(null)}>تم</Button>
        </div>;
      })()}
      <Toast notice={notice} onClose={clearToast} />
    </section>
  );
}
</file>

<file path="client/src/modules/archive/ArchivePage.jsx">
import { useState } from 'react';
import { Link } from 'react-router-dom';
import { api } from '../../lib/api.js';
import { errorMessage, formatDate } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import Alert from '../../components/ui/Alert.jsx';
import Badge from '../../components/ui/Badge.jsx';
import Button from '../../components/ui/Button.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import Icon from '../../components/ui/Icon.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import PageHeader from '../../components/ui/PageHeader.jsx';
import Tabs from '../../components/ui/Tabs.jsx';
import MaintenanceAreaAnalysis from './MaintenanceAreaAnalysis.jsx';
import MaintenancePptxExportModal from '../maintenance/MaintenancePptxExportModal.jsx';

export default function ArchivePage({ isAdmin = false }) {
  const [tab, setTab] = useState('maintenance');
  const { data: maintenance, loading: maintenanceLoading, error: maintenanceError } = useApi('/api/maintenance/orders?status=archived');
  const { data: workshop, loading: workshopLoading, error: workshopError } = useApi('/api/workshop/orders?status=delivered_archived');
  const [reportOrder, setReportOrder] = useState(null);
  const [report, setReport] = useState(null);
  const [reportLoading, setReportLoading] = useState(false);
  const [reportError, setReportError] = useState('');
  const [pptxExportOpen, setPptxExportOpen] = useState(false);
  const [pptxExportOrder, setPptxExportOrder] = useState(null);
  const [orderToDelete, setOrderToDelete] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const orders = tab === 'maintenance' ? maintenance : tab === 'workshop' ? workshop : [];
  const loading = tab === 'maintenance' ? maintenanceLoading : workshopLoading;
  const error = tab === 'maintenance' ? maintenanceError : workshopError;

  async function openPhotoReport(order) {
    setReportOrder(order);
    setReport(null);
    setReportError('');
    setReportLoading(true);
    try { setReport(await api.get(`/api/maintenance/orders/${order.id}`)); }
    catch (caught) { setReportError(errorMessage(caught)); }
    finally { setReportLoading(false); }
  }

  function openPptxExport(order = null) {
    setPptxExportOrder(order);
    setPptxExportOpen(true);
  }

  return (
    <>
      <PageHeader kicker="الأعمال المكتملة · السجل التاريخي" title="الأرشيف والتقارير" description="تصفح أوامر الصيانة المؤرشفة وأوامر الورشة المسلّمة. يمكن للمدير إزالة تقرير الصيانة من الأرشيف مع الاحتفاظ بسجله التاريخي." actions={tab === 'maintenance' && <Button icon="presentation" onClick={() => openPptxExport()}>تصدير تقرير PowerPoint</Button>} />
      <div className="madar-integration-notice"><Alert tone="info">يمكن تنزيل تقارير الصيانة المؤرشفة بصيغ PowerPoint وWord، أو طباعة المعاينة وحفظها PDF.</Alert></div>
      <div className="madar-section"><Tabs items={[
        { value: 'maintenance', label: 'أرشيف الصيانة', count: maintenance?.length },
        { value: 'workshop', label: 'أوامر الورشة المسلّمة', count: workshop?.length },
        { value: 'analysis', label: 'تحليل الأرشيف والمناطق (Archive & Area Analysis)' },
      ]} value={tab} onChange={setTab} ariaLabel="أقسام الأرشيف" /></div>
      {tab === 'analysis' ? <MaintenanceAreaAnalysis /> : <>
        {error && <div className="madar-section"><Alert tone="error">{error}</Alert></div>}
        <section className="madar-panel madar-section">
          {loading ? <LoadingState label="جارٍ تحميل الأرشيف" /> : orders?.length ? <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>رقم الأمر</th><th>العميل</th>{tab === 'maintenance' && <th>المناطق</th>}<th>{tab === 'maintenance' ? 'الآلات' : 'المنتج'}</th><th>تاريخ الإغلاق</th><th>الحالة</th><th>عرض / تصدير</th></tr></thead><tbody>{orders.map((order) => {
            const areas = order.areas?.length ? order.areas : order.area ? [order.area] : [];
            return <tr key={order.id}>
              <td className="madar-code">{order.order_code}</td>
              <td>{order.client_name}</td>
              {tab === 'maintenance' && <td>{areas.length ? <div className="madar-inline-wrap" style={{ gap: '4px', maxWidth: '280px', flexWrap: 'wrap' }}>
                {areas.map((areaName) => <span key={areaName} className="madar-badge madar-badge-info" style={{
                  fontSize: '11px', padding: '2px 8px', borderRadius: '6px', background: 'rgba(56, 189, 248, 0.12)',
                  color: '#38bdf8', border: '1px solid rgba(56, 189, 248, 0.25)', fontWeight: 600,
                }}>{areaName}</span>)}
              </div> : <span className="madar-muted">—</span>}</td>}
              <td>{tab === 'maintenance' ? order.card_count : order.product_name}</td>
              <td>{formatDate(order.archived_at ?? order.delivered_at)}</td>
              <td><Badge status={order.status} /></td>
              <td>{tab === 'maintenance' ? <div className="madar-inline-wrap"><Button size="small" variant="secondary" icon="image" onClick={() => openPhotoReport(order)}>معاينة</Button><Button size="small" variant="primary" icon="presentation" onClick={() => openPptxExport(order)}>تصدير PowerPoint</Button><Button size="small" variant="secondary" icon="file" onClick={() => { window.location.href = `/api/maintenance/orders/${order.id}/export.docx`; }}>Word</Button>{isAdmin && <Button size="small" variant="danger" icon="trash" onClick={() => setOrderToDelete(order)}>حذف</Button>}</div> : <Link className="madar-button madar-button-secondary madar-button-small" to={`/workshop/${order.id}`}>تفاصيل الأمر <Icon name="chevron" size={12} /></Link>}</td>
            </tr>;
          })}</tbody></table></div> : <EmptyState icon="archive" title="لا توجد سجلات مؤرشفة" description="ستظهر هنا الطلبات المكتملة مع الاحتفاظ بسجلها التاريخي." />}
        </section>
      </>}
      <Modal open={reportOrder !== null} onClose={() => setReportOrder(null)} title="معاينة تقرير الصيانة" description={reportOrder ? `${reportOrder.order_code} · ${reportOrder.client_name}` : ''} wide>
        <div className="madar-report-actions"><Alert tone="info">يمكنك طباعة هذه المعاينة أو اختيار “حفظ كـ PDF” من نافذة الطباعة.</Alert><Button icon="printer" variant="secondary" onClick={() => window.print()} disabled={!report}>طباعة / حفظ PDF</Button></div>
        {reportLoading ? <LoadingState label="جارٍ تجهيز معاينة الصور" /> : reportError ? <Alert tone="error">{reportError}</Alert> : report && <div className="madar-print-report">
          <div className="madar-report-heading"><div className="madar-report-wordmark">MADAR</div><div><span>تقرير صيانة ميدانية</span><h2>{report.client?.name}</h2><p>{report.order_code} · {report.archived_at?.slice(0, 10)}</p></div></div>
          {report.cards.map((card) => <section className="madar-report-machine" key={card.id}><h3>{card.machine_name_ar} · {card.machine_code}</h3><p>{card.machine_area}</p><div className="madar-report-photo-columns"><ReportPhotoColumn title="قبل الصيانة" urls={card.before_photo_urls} /><ReportPhotoColumn title="بعد الصيانة" urls={card.after_photo_urls} /></div></section>)}
          {!report.cards.length && <EmptyState icon="image" title="لا توجد صور مرتبطة" />}
        </div>}
      </Modal>
      <MaintenancePptxExportModal
        open={pptxExportOpen}
        onClose={() => setPptxExportOpen(false)}
        currentOrder={pptxExportOrder}
        defaultScope={pptxExportOrder ? 'current' : 'archive'}
      />
      <Modal
        open={Boolean(orderToDelete)}
        onClose={() => !deleting && setOrderToDelete(null)}
        title="تأكيد إزالة التقرير من الأرشيف"
        description={orderToDelete ? `${orderToDelete.order_code} · ${orderToDelete.client_name}` : ''}
      >
        <div className="madar-delete-confirm">
          <Alert tone="error">
            سيُخفى أمر الصيانة من الأرشيف وتُحذف ملفات صوره المؤرشفة من التخزين المحلي. ستظل بيانات الأمر وبطاقاته وسجل التدقيق محفوظة.
          </Alert>
          <div className="madar-modal-actions" style={{ marginTop: '1.5rem', display: 'flex', gap: '0.75rem', justifyContent: 'flex-end' }}>
            <Button variant="secondary" onClick={() => setOrderToDelete(null)} disabled={deleting}>
              إلغاء
            </Button>
            <Button
              variant="danger"
              icon="trash"
              disabled={deleting}
              aria-busy={deleting}
              onClick={async () => {
                if (!orderToDelete || deleting) return;
                setDeleting(true);
                try {
                  await api.delete(`/api/maintenance/orders/${orderToDelete.id}`);
                  setOrderToDelete(null);
                  window.location.reload();
                } catch (err) {
                  window.alert(err.message || 'تعذر إزالة التقرير من الأرشيف.');
                } finally {
                  setDeleting(false);
                }
              }}
            >
              {deleting ? 'جارٍ الإزالة…' : 'تأكيد الإزالة من الأرشيف'}
            </Button>
          </div>
        </div>
      </Modal>
    </>
  );
}

function ReportPhotoColumn({ title, urls }) {
  return <div><h4>{title}</h4>{urls.length ? <div className="madar-report-photos">{urls.map((url, index) => <img src={url} key={`${url}-${index}`} alt={`${title} ${index + 1}`} />)}</div> : <p className="madar-muted madar-small">لا توجد صور</p>}</div>;
}
</file>

<file path="client/src/modules/archive/MaintenanceAreaAnalysis.jsx">
import { useMemo, useState } from 'react';
import { api } from '../../lib/api.js';
import { useApi } from '../../lib/useApi.js';
import Alert from '../../components/ui/Alert.jsx';
import Badge from '../../components/ui/Badge.jsx';
import Button from '../../components/ui/Button.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import { Input, Select } from '../../components/ui/Field.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';

function queryString(from, to, reasonId) {
  const query = new URLSearchParams();
  if (from) query.set('from', from);
  if (to) query.set('to', to);
  if (reasonId) query.set('reasonId', reasonId);
  return query.toString();
}

export default function MaintenanceAreaAnalysis() {
  const [from, setFrom] = useState('');
  const [to, setTo] = useState('');
  const [reasonId, setReasonId] = useState('');
  const search = queryString(from, to, reasonId);
  const path = `/api/maintenance/analysis/areas${search ? `?${search}` : ''}`;
  const { data: areas, loading, error } = useApi(path);
  const { data: reasons } = useApi('/api/maintenance/reasons');

  const totals = useMemo(() => (areas ?? []).reduce((sum, area) => ({
    total: sum.total + area.total_count,
    completed: sum.completed + area.completed_count,
    missing: sum.missing + area.missing_count,
  }), { total: 0, completed: 0, missing: 0 }), [areas]);

  function downloadMaintenanceExcel() {
    const query = queryString(from, to, reasonId);
    window.location.href = `/api/maintenance/analysis/export.xlsx${query ? `?${query}` : ''}`;
  }

  return (
    <section className="madar-section madar-area-analysis">
      <div className="madar-section-head">
        <div>
          <h2 className="madar-section-title">تحليل الأرشيف والمناطق</h2>
          <div className="madar-section-note">تُحسب الماكينة منجزة عند وجود بطاقة مكتملة لها في أمر صيانة مؤرشف ضمن الفلاتر المحددة.</div>
        </div>
        <Button icon="file" variant="secondary" onClick={downloadMaintenanceExcel}>
          تصدير إكسيل تقرير الصيانة والأعطال (Excel)
        </Button>
      </div>

      <div className="madar-analysis-filters">
        <Input label="من تاريخ الخدمة" type="date" value={from} onChange={(event) => setFrom(event.target.value)} />
        <Input label="إلى تاريخ الخدمة" type="date" value={to} onChange={(event) => setTo(event.target.value)} />
        <Select label="سبب العطل" value={reasonId} onChange={(event) => setReasonId(event.target.value)}>
          <option value="">كل الأسباب</option>
          {(reasons ?? []).map((reason) => <option key={reason.id} value={reason.id}>{reason.name}</option>)}
        </Select>
      </div>

      {error && <div className="madar-section"><Alert tone="error">{error}</Alert></div>}
      {loading ? <div className="madar-section"><LoadingState label="جارٍ تحليل إنجاز الصيانة حسب المنطقة" /></div> : error ? null : <>
        <div className="madar-analysis-summary madar-section" aria-label="ملخص إنجاز الصيانة">
          <article className="madar-analysis-metric"><span>إجمالي الماكينات</span><strong>{totals.total.toLocaleString('ar-EG')}</strong></article>
          <article className="madar-analysis-metric"><span>الماكينات المنجزة</span><strong>{totals.completed.toLocaleString('ar-EG')}</strong></article>
          <article className="madar-analysis-metric"><span>الماكينات المتبقية</span><strong>{totals.missing.toLocaleString('ar-EG')}</strong></article>
        </div>

        {areas?.length ? <div className="madar-analysis-areas madar-section">
          {areas.map((area) => {
            const percent = Math.min(100, Math.max(0, Math.round(area.completion_ratio * 100)));
            const complete = area.missing_count === 0;
            return (
              <article className="madar-area-progress-card" key={area.area}>
                <div className="madar-area-progress-heading">
                  <h3>{area.area}</h3>
                  <Badge tone={complete ? 'success' : 'warning'}>{percent}%</Badge>
                </div>
                <div className="madar-area-progress-track" role="progressbar" aria-label={`نسبة إنجاز ${area.area}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent}>
                  <div className={`madar-area-progress-fill ${complete ? 'complete' : ''}`} style={{ width: `${percent}%` }} />
                </div>
                <div className="madar-area-progress-count">
                  <span><strong>{area.completed_count.toLocaleString('ar-EG')} من {area.total_count.toLocaleString('ar-EG')}</strong> ماكينة أُنجزت</span>
                  <span>{area.missing_count.toLocaleString('ar-EG')} متبقية</span>
                </div>
                {area.missing_count > 0 && <details className="madar-area-missing">
                  <summary>عرض الماكينات المتبقية ({area.missing_count})</summary>
                  <ul className="madar-area-missing-list">
                    {area.missing_machines.map((machine) => <li key={machine.id}><span>{machine.name_ar}</span><span className="madar-code">{machine.code}</span></li>)}
                  </ul>
                </details>}
                {complete && <p className="madar-small madar-muted">اكتملت تغطية ماكينات المنطقة ضمن الفلاتر المحددة.</p>}
              </article>
            );
          })}
        </div> : <div className="madar-section"><EmptyState icon="chart" title="لا توجد ماكينات ضمن التحليل" description="غيّر الفترة أو تحقق من دليل الماكينات النشطة." /></div>}
      </>}
    </section>
  );
}
</file>

<file path="client/src/modules/auth/SignInPage.jsx">
import { useEffect, useState } from 'react';
import { api } from '../../lib/api.js';
import { isNativeRepApp, saveNativeSession } from '../rep/native-session.js';

export default function SignInPage({ setupRequired, initialError = '', onLoginSuccess, theme, onThemeToggle }) {
  const [form, setForm] = useState({ fullName: '', username: '', password: '', confirmPassword: '' });
  const [showPassword, setShowPassword] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState(initialError);
  const [accountMode, setAccountMode] = useState('staff');
  const [serverState, setServerState] = useState('checking');

  useEffect(() => {
    let active = true;
    const checkServer = async () => {
      if (!navigator.onLine) {
        if (active) setServerState('offline');
        return;
      }
      try {
        await api.get('/api/health', { timeoutMs: 4000 });
        if (active) setServerState('online');
      } catch {
        if (active) setServerState('offline');
      }
    };
    const onOnline = () => { void checkServer(); };
    const onOffline = () => setServerState('offline');
    void checkServer();
    window.addEventListener('online', onOnline);
    window.addEventListener('offline', onOffline);
    return () => {
      active = false;
      window.removeEventListener('online', onOnline);
      window.removeEventListener('offline', onOffline);
    };
  }, []);

  const update = (field) => (event) => {
    setForm((current) => ({ ...current, [field]: event.target.value }));
    if (error) setError('');
  };

  const submit = async (event) => {
    event.preventDefault();
    if (setupRequired && form.password !== form.confirmPassword) {
      setError('The passwords do not match.');
      return;
    }

    setSubmitting(true);
    setError('');
    try {
      let result;
      if (setupRequired) {
        result = await api.post('/api/auth/setup', {
          fullName: form.fullName,
          username: form.username,
          password: form.password,
        });
      } else if (accountMode === 'rep') {
        result = await api.post('/api/rep/login', {
          username: form.username,
          password: form.password,
        }, isNativeRepApp() ? { headers: { 'X-Madar-Native-Client': 'android' } } : {});
        if (isNativeRepApp() && result.token) await saveNativeSession(result.token, result.rep);
      } else {
        result = await api.post('/api/auth/login', {
          username: form.username,
          password: form.password,
        });
      }
      onLoginSuccess(accountMode === 'rep' && !setupRequired ? result.rep : result.user);
    } catch (requestError) {
      setError(requestError.message || 'Unable to sign in. Please try again.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <main className="auth-screen" dir={accountMode === 'rep' ? 'rtl' : 'ltr'}>
      <header className="auth-header">
        <div className="auth-wordmark" aria-label="تسجيل الدخول إلى مدار">
          <span className="auth-brand-mark">M</span>
          <span className="auth-brand-copy"><strong>MADAR</strong><small>{accountMode === 'rep' ? 'تطبيق المندوب الميداني' : 'نظام إدارة التشغيل والصيانة'}</small></span>
        </div>
        <button
          className="auth-theme-toggle"
          type="button"
          onClick={onThemeToggle}
          aria-label={`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`}
        >
          <span aria-hidden="true">{theme === 'dark' ? '☼' : '☾'}</span>
          {theme === 'dark' ? 'Light mode' : 'Dark mode'}
        </button>
      </header>

      <section className="auth-layout" aria-label={setupRequired ? 'Administrator setup' : 'Sign in'}>
        <div className="auth-story">
          <div className="auth-story-orbit auth-story-orbit-one" />
          <div className="auth-story-orbit auth-story-orbit-two" />
          <div className="auth-story-content">
            <span className="auth-eyebrow"><span className="auth-eyebrow-dot" /> LOCAL-FIRST OPERATIONS</span>
            <h1>{accountMode === 'rep' ? 'كل زيارة محفوظة، حتى خارج التغطية.' : 'Clarity for every part of your operation.'}</h1>
            <p>{accountMode === 'rep' ? 'مسارك وصورك تُحفظ على هاتفك أولاً، ثم تُزامن مع نظام مدار عند توفر الاتصال.' : 'One calm workspace for maintenance, workshop, inventory and finance.'}</p>
            <div className="auth-story-points">
              {accountMode === 'rep' ? <>
                <span><i>01</i> مسار اليوم حسب المنطقة</span>
                <span><i>02</i> توثيق قبل وبعد</span>
                <span><i>03</i> حفظ محلي ومزامنة تلقائية</span>
              </> : <>
                <span><i>01</i> Work orders & machine history</span>
                <span><i>02</i> Stock, invoices & treasury</span>
                <span><i>03</i> Your data stays on your system</span>
              </>}
            </div>
          </div>
          <div className="auth-story-foot"><span>BUILT FOR THE WORK BEHIND THE WORK</span><span>V2.0</span></div>
        </div>

        <div className="auth-card-wrap">
          <div className="auth-card">
            <div className="auth-card-kicker">{setupRequired ? 'الإعداد لأول مرة' : accountMode === 'rep' ? 'الدخول الميداني' : 'مساحة عمل آمنة'}</div>
            <h2>{setupRequired ? 'إنشاء حساب المدير' : accountMode === 'rep' ? 'مرحباً بك يا مندوب' : 'مرحباً بعودتك'}</h2>
            <p className="auth-card-description" dir="rtl">
              {setupRequired
                ? 'أنشئ حساب المدير لتأمين مساحة عمل MADAR.'
                : accountMode === 'rep' ? 'سجّل الدخول لتنزيل مسار اليوم ومتابعة زياراتك.' : 'سجّل الدخول باستخدام حساب MADAR للمتابعة.'}
            </p>

            {!setupRequired && <div className="auth-account-switch" role="group" aria-label="نوع الحساب">
              <button type="button" className={accountMode === 'staff' ? 'active' : ''} onClick={() => setAccountMode('staff')}>موظف / إدارة</button>
              <button type="button" className={accountMode === 'rep' ? 'active' : ''} onClick={() => setAccountMode('rep')}>مندوب ميداني</button>
            </div>}

            <div className={`auth-server-status ${serverState === 'online' ? 'online' : ''} ${serverState === 'checking' ? 'checking' : ''}`} role="status">
              <i />{serverState === 'online' ? 'الخادم متصل وجاهز لتسجيل الدخول' : serverState === 'checking' ? 'جارٍ فحص اتصال الخادم…' : 'الخادم غير متاح · يلزم الاتصال لتسجيل الدخول'}
            </div>

            <form className="auth-form" dir="rtl" onSubmit={submit}>
              {setupRequired && (
                <label className="auth-field">
                  <span>الاسم الكامل</span>
                  <input
                    autoComplete="name"
                    autoFocus
                    maxLength={120}
                    name="fullName"
                    onChange={update('fullName')}
                    placeholder="الاسم الكامل"
                    required
                    value={form.fullName}
                  />
                </label>
              )}

              <label className="auth-field">
                <span>{accountMode === 'rep' && !setupRequired ? 'كود المندوب' : 'اسم المستخدم'}</span>
                <input
                  dir="ltr"
                  autoComplete="username"
                  autoCapitalize="none"
                  autoCorrect="off"
                  autoFocus={!setupRequired}
                  maxLength={64}
                  name="username"
                  onChange={update('username')}
                  placeholder={accountMode === 'rep' && !setupRequired ? 'أدخل كود المندوب' : 'أدخل اسم المستخدم'}
                  required
                  value={form.username}
                />
              </label>

              <label className="auth-field">
                <span>كلمة المرور</span>
                <span className="auth-password-input">
                  <input
                    dir="ltr"
                    autoComplete={setupRequired ? 'new-password' : 'current-password'}
                    maxLength={72}
                    minLength={setupRequired ? 4 : 1}
                    name="password"
                    onChange={update('password')}
                    placeholder={setupRequired ? '4 خانات على الأقل' : 'أدخل كلمة المرور'}
                    required
                    type={showPassword ? 'text' : 'password'}
                    value={form.password}
                  />
                  <button type="button" onClick={() => setShowPassword((visible) => !visible)}>
                    {showPassword ? 'إخفاء' : 'إظهار'}
                  </button>
                </span>
                {setupRequired && <small>استخدم 4 خانات على الأقل. سيكون لهذا الحساب صلاحيات المدير.</small>}
              </label>

              {setupRequired && (
                <label className="auth-field">
                  <span>تأكيد كلمة المرور</span>
                  <input
                    autoComplete="new-password"
                    maxLength={72}
                    minLength={4}
                    name="confirmPassword"
                    onChange={update('confirmPassword')}
                    placeholder="أعد إدخال كلمة المرور"
                    required
                    dir="ltr"
                    type={showPassword ? 'text' : 'password'}
                    value={form.confirmPassword}
                  />
                </label>
              )}

              {error && <p className="auth-error" role="alert">{error}</p>}

              <button className="auth-submit" disabled={submitting} type="submit">
                {submitting && <span className="auth-submit-spinner" aria-hidden="true" />}
                {submitting ? 'جارٍ تسجيل الدخول...' : setupRequired ? 'إنشاء حساب المدير' : 'تسجيل الدخول'}
                {!submitting && <span aria-hidden="true">←</span>}
              </button>
            </form>

            <div className="auth-security-note">
              <span className="auth-security-icon" aria-hidden="true">⌑</span>
                <span><strong>جلسة محمية</strong><small>يُحفظ تسجيل الدخول في ملف ارتباط محمي من نوع HTTP-only. لا يُخزّن التوكن في الهاتف.</small></span>
            </div>
          </div>
          <p className="auth-local-note"><span /> مساحة عمل خاصة <b>·</b> بيانات محلية</p>
        </div>
      </section>

      <footer className="auth-footer"><span>© MADAR OPERATIONS</span><span>مصمم لفريقك</span></footer>
    </main>
  );
}
</file>

<file path="client/src/modules/clients/ClientsPage.jsx">
import { useMemo, useState } from 'react';
import { api } from '../../lib/api.js';
import { errorMessage, formatMoney, initials } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import { useToast } from '../../lib/useToast.js';
import Alert from '../../components/ui/Alert.jsx';
import Button from '../../components/ui/Button.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import Icon from '../../components/ui/Icon.jsx';
import { Input, Textarea } from '../../components/ui/Field.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import PageHeader from '../../components/ui/PageHeader.jsx';
import Toast from '../../components/ui/Toast.jsx';

export default function ClientsPage({ canViewFinancialDetails = false }) {
  const { data: clients, loading, error, reload } = useApi('/api/clients');
  const [search, setSearch] = useState('');
  const [createOpen, setCreateOpen] = useState(false);
  const [editOpen, setEditOpen] = useState(false);
  const [deactivateOpen, setDeactivateOpen] = useState(false);
  const [selectedId, setSelectedId] = useState(null);
  const [statementOpen, setStatementOpen] = useState(false);
  const [saving, setSaving] = useState(false);
  const [deactivating, setDeactivating] = useState(false);
  const [formError, setFormError] = useState('');
  const [editError, setEditError] = useState('');
  const [deactivateError, setDeactivateError] = useState('');
  const { notice, showToast, clearToast } = useToast();
  const filtered = useMemo(() => (clients ?? []).filter((client) =>
    `${client.name} ${client.code} ${client.phone ?? ''} ${client.contact_name ?? ''}`.toLowerCase().includes(search.toLowerCase())),
  [clients, search]);
  const { data: profile, loading: profileLoading, error: profileError, reload: reloadProfile } = useApi(
    selectedId ? `/api/clients/${selectedId}` : '', { enabled: selectedId !== null },
  );
  const { data: statement, loading: statementLoading, error: statementError } = useApi(
    selectedId ? `/api/clients/${selectedId}/statement` : '', { enabled: statementOpen && selectedId !== null },
  );

  async function createClient(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      await api.post('/api/clients', {
        name: form.get('name'),
        contactName: form.get('contactName') || undefined,
        phone: form.get('phone') || undefined,
        email: form.get('email') || undefined,
        address: form.get('address') || undefined,
      });
      setCreateOpen(false);
      await reload();
      showToast('تم إنشاء ملف العميل بنجاح.');
    } catch (caught) {
      setFormError(errorMessage(caught));
    } finally {
      setSaving(false);
    }
  }

  async function updateClient(event) {
    event.preventDefault();
    if (!selectedId) return;
    setSaving(true);
    setEditError('');
    const form = new FormData(event.currentTarget);
    try {
      await api.put(`/api/clients/${selectedId}`, {
        code: form.get('code'),
        nameAr: form.get('nameAr'),
        nameEn: form.get('nameEn'),
        contactName: form.get('contactName'),
        phone: form.get('phone'),
        email: form.get('email'),
        address: form.get('address'),
        notes: form.get('notes'),
      });
      setEditOpen(false);
      await Promise.all([reload(), reloadProfile()]);
      showToast('تم تحديث بيانات العميل بنجاح.');
    } catch (caught) {
      setEditError(errorMessage(caught));
    } finally {
      setSaving(false);
    }
  }

  async function deactivateClient() {
    if (!selectedId) return;
    setDeactivating(true);
    setDeactivateError('');
    try {
      await api.delete(`/api/clients/${selectedId}`);
      setDeactivateOpen(false);
      setSelectedId(null);
      await reload();
      showToast('تم إيقاف ملف العميل مع الاحتفاظ بسجلاته.');
    } catch (caught) {
      setDeactivateError(errorMessage(caught));
    } finally {
      setDeactivating(false);
    }
  }

  async function uploadLogo(event) {
    const file = event.target.files?.[0];
    if (!file || !selectedId) return;
    const form = new FormData();
    form.append('logo', file);
    try {
      await api.upload(`/api/clients/${selectedId}/logo`, form);
      await reloadProfile();
      await reload();
      showToast('تم تحديث شعار العميل.');
    } catch (caught) {
      showToast(errorMessage(caught), 'error');
    } finally {
      event.target.value = '';
    }
  }

  const selectedClient = profile ?? clients?.find((client) => client.id === selectedId);

  return (
    <>
      <PageHeader
        kicker="العلاقات · العملاء"
        title="عملاؤنا"
        description="بطاقات تعريفية بملف كل عميل، أصوله التشغيلية، وموقفه المالي."
        actions={<Button icon="plus" onClick={() => { setFormError(''); setCreateOpen(true); }}>إضافة عميل</Button>}
      />
      {error && <Alert tone="error">{error}</Alert>}
      <div className="madar-toolbar madar-section">
        <label className="madar-field madar-search"><Icon name="search" size={15} /><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="ابحث بالاسم أو الكود أو الهاتف" aria-label="بحث العملاء" /></label>
        <span className="madar-muted madar-small">{filtered.length} عميل</span>
      </div>
      {loading ? <LoadingState label="جارٍ تحميل العملاء" /> : filtered.length ? (
        <div className="madar-grid madar-grid-3 madar-section">
          {filtered.map((client) => (
            <button className="madar-client-card madar-card madar-card-interactive" type="button" key={client.id} onClick={() => setSelectedId(client.id)}>
              <span className="madar-client-card-top">
                {client.logo_path ? <img className="madar-client-avatar-image" src={`/api/clients/${client.id}/logo`} alt="" /> : <span className="madar-client-avatar">{initials(client.name)}</span>}
                <span className="madar-client-card-copy">
                  <strong className="madar-client-name">{client.name}</strong>
                  <small className="madar-code">{client.code}</small>
                </span>
                <Icon name="chevron" size={15} className="madar-client-chevron" />
              </span>
              <span className="madar-client-contact">{client.contact_name || 'جهة اتصال غير محددة'}{client.phone ? ` · ${client.phone}` : ''}</span>
              <span className="madar-client-card-footer">فتح الملف <Icon name="arrow" size={13} /></span>
            </button>
          ))}
        </div>
      ) : <div className="madar-panel madar-section"><EmptyState icon="users" title={search ? 'لا توجد نتائج مطابقة' : 'ابدأ بإضافة أول عميل'} description={search ? 'جرّب البحث باسم أو كود مختلف.' : 'ملفات العملاء تربط أوامر الصيانة والورشة والفواتير.'} action={!search && <Button icon="plus" onClick={() => setCreateOpen(true)}>إضافة عميل</Button>} /></div>}

      <Modal open={createOpen} onClose={() => setCreateOpen(false)} title="إنشاء ملف عميل" description="أدخل بيانات التواصل الأساسية. سيُنشأ كود العميل تلقائياً.">
        <form onSubmit={createClient}>
          <div className="madar-form-grid">
            <Input label="اسم العميل *" name="name" required maxLength={200} autoFocus />
            <Input label="اسم مسؤول التواصل" name="contactName" maxLength={200} />
            <Input label="رقم الهاتف" name="phone" type="tel" maxLength={80} />
            <Input label="البريد الإلكتروني" name="email" type="email" maxLength={254} />
            <Input className="madar-form-full" label="العنوان" name="address" maxLength={1000} />
          </div>
          {formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setCreateOpen(false)}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ الحفظ…' : 'حفظ العميل'}</Button></div>
        </form>
      </Modal>

      <Modal open={selectedId !== null && !statementOpen} onClose={() => { setSelectedId(null); setStatementOpen(false); }} title={selectedClient?.name ?? 'ملف العميل'} description={selectedClient?.code} wide>
        {profileLoading ? <LoadingState label="جارٍ تحميل ملف العميل" /> : profileError ? <Alert tone="error">{profileError}</Alert> : profile && (
          <div className="madar-stack">
            <div className="madar-profile-banner">
              <div className="madar-client-avatar-wrap">{profile.logo_url ? <img className="madar-client-avatar-image large" src={profile.logo_url} alt={`شعار ${profile.name}`} /> : <span className="madar-client-avatar large">{initials(profile.name)}</span>}</div>
              <div className="madar-profile-heading"><h3>{profile.name}</h3><span className="madar-code">{profile.code}</span><p>{profile.contact_name || 'جهة اتصال غير محددة'}{profile.phone ? ` · ${profile.phone}` : ''}</p></div>
              <div className="madar-profile-actions">
                 {canViewFinancialDetails && <Button variant="secondary" icon="file" onClick={() => setStatementOpen(true)}>كشف الحساب</Button>}
                <Button variant="secondary" onClick={() => { setEditError(''); setEditOpen(true); }}>تعديل البيانات</Button>
                <label className="madar-button madar-button-ghost madar-button-small madar-logo-upload"><Icon name="upload" size={14} /> تحديث الشعار<input type="file" accept="image/jpeg,image/png,image/webp" onChange={uploadLogo} /></label>
                <Button variant="danger" icon="trash" onClick={() => { setDeactivateError(''); setDeactivateOpen(true); }}>إيقاف العميل</Button>
              </div>
            </div>
            {profile.name_en && <p className="madar-muted madar-small" dir="ltr">{profile.name_en}</p>}
            {profile.notes && <p className="madar-muted madar-small">{profile.notes}</p>}
            <div className="madar-grid madar-grid-3">
              <div className="madar-stat-tile"><span>صيانة نشطة</span><strong>{profile.statistics.activeMaintenanceOrders}</strong></div>
              <div className="madar-stat-tile"><span>زيارات مكتملة</span><strong>{profile.statistics.completedMaintenanceVisits}</strong></div>
              <div className="madar-stat-tile"><span>أوامر ورشة نشطة</span><strong>{profile.statistics.activeWorkshopOrders}</strong></div>
            </div>
            <section className="madar-panel">
              <div className="madar-panel-header"><div><h3>الآلات ومواقع الخدمة</h3><p>{profile.machines.length} أصل مرتبط بالعميل</p></div></div>
              {profile.machines.length ? <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>الآلة</th><th>الاسم</th><th>المنطقة</th><th>آخر متابعة</th></tr></thead><tbody>{profile.machines.map((machine) => <tr key={machine.id}><td className="madar-code">{machine.code}</td><td>{machine.name_ar}{machine.name_en ? ` · ${machine.name_en}` : ''}</td><td>{machine.site_area}</td><td>{machine.last_seen_at?.slice(0, 10) ?? '—'}</td></tr>)}</tbody></table></div> : <EmptyState icon="factory" title="لا توجد آلات مرتبطة بعد" description="تُسجل علاقة الآلة بالعميل عند إضافتها إلى بطاقة صيانة." />}
            </section>
          </div>
        )}
      </Modal>

      <Modal open={editOpen && selectedId !== null} onClose={() => setEditOpen(false)} title="تعديل بيانات العميل" description="يُحفظ كود العميل وأسماء العرض دون تغيير روابط الملفات والسجلات الحالية." wide>
        {selectedClient && <form onSubmit={updateClient}>
          <div className="madar-form-grid">
            <Input label="كود العميل *" name="code" required maxLength={64} pattern="[A-Za-z0-9][A-Za-z0-9._-]*" defaultValue={selectedClient.code} />
            <Input label="اسم العميل بالعربية *" name="nameAr" required maxLength={200} defaultValue={selectedClient.name_ar || selectedClient.name} />
            <Input label="اسم العميل بالإنجليزية" name="nameEn" maxLength={200} defaultValue={selectedClient.name_en ?? ''} />
            <Input label="اسم مسؤول التواصل" name="contactName" maxLength={200} defaultValue={selectedClient.contact_name ?? ''} />
            <Input label="رقم الهاتف" name="phone" type="tel" maxLength={80} defaultValue={selectedClient.phone ?? ''} />
            <Input label="البريد الإلكتروني" name="email" type="email" maxLength={254} defaultValue={selectedClient.email ?? ''} />
            <Input className="madar-form-full" label="العنوان" name="address" maxLength={1000} defaultValue={selectedClient.address ?? ''} />
            <Textarea className="madar-form-full" label="ملاحظات" name="notes" maxLength={10000} defaultValue={selectedClient.notes ?? ''} rows={3} />
          </div>
          {editError && <div className="madar-form-error"><Alert tone="error">{editError}</Alert></div>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setEditOpen(false)}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ الحفظ…' : 'حفظ التعديلات'}</Button></div>
        </form>}
      </Modal>

      <Modal open={deactivateOpen && selectedId !== null} onClose={() => setDeactivateOpen(false)} title="إيقاف ملف العميل" description="سيُخفى العميل من القوائم، مع الاحتفاظ بالفواتير والأوامر والملفات المرتبطة به.">
        <div className="madar-stack">
          <p>هل تريد إيقاف <strong>{selectedClient?.name}</strong>؟ لا يمكن تنفيذ ذلك ما دامت هناك أوامر صيانة أو ورشة نشطة.</p>
          {deactivateError && <Alert tone="error">{deactivateError}</Alert>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setDeactivateOpen(false)}>إلغاء</Button><Button variant="danger" icon="trash" disabled={deactivating} onClick={deactivateClient}>{deactivating ? 'جارٍ الإيقاف…' : 'تأكيد إيقاف العميل'}</Button></div>
        </div>
      </Modal>

      {canViewFinancialDetails && <Modal open={statementOpen} onClose={() => setStatementOpen(false)} title="كشف حساب العميل" description={selectedClient ? `${selectedClient.name} · ${selectedClient.code}` : ''}>
        {statementLoading ? <LoadingState label="جارٍ إعداد كشف الحساب" /> : statementError ? <Alert tone="error">{statementError}</Alert> : statement && (
          <div className="madar-stack">
            <div className="madar-statement-summary">
              <div><span>إجمالي الفواتير</span><strong>{formatMoney(statement.totalBilledCents)}</strong></div>
              <div><span>إجمالي المقبوضات</span><strong>{formatMoney(statement.totalPaidCents)}</strong></div>
              <div className="outstanding"><span>الرصيد المستحق</span><strong>{formatMoney(statement.outstandingBalanceCents)}</strong></div>
            </div>
            <div className="madar-section-head"><h3 className="madar-section-title">الفواتير المتأخرة أكثر من 60 يوماً</h3>{statement.hasOverdueDebt && <span className="madar-badge madar-badge-danger">توجد مديونية متأخرة</span>}</div>
            {statement.overdueInvoices.length ? <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>الفاتورة</th><th>تاريخها</th><th>أيام التأخير</th><th>المتبقي</th></tr></thead><tbody>{statement.overdueInvoices.map((invoice) => <tr key={invoice.id}><td className="madar-code">{invoice.code}</td><td>{invoice.created_at?.slice(0, 10)}</td><td>{invoice.days_overdue}</td><td className="madar-money">{formatMoney(invoice.remaining_cents)}</td></tr>)}</tbody></table></div> : <div className="madar-alert madar-alert-success"><Icon name="check" size={14} /> لا توجد فواتير متأخرة.</div>}
          </div>
        )}
      </Modal>}
      <Toast notice={notice} onClose={clearToast} />
    </>
  );
}
