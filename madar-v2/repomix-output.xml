#madar-app .madar-status-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--madar-border); border-radius: 999px; color: #58667b; background: #fff; font-size: 10px; font-weight: 700; white-space: nowrap; }
