#madar-app .madar-page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
#madar-app .madar-page-heading { margin: 0; color: var(--madar-text); font-size: clamp(21px, 2.3vw, 27px); font-weight: 850; letter-spacing: -.025em; }
#madar-app .madar-page-description { max-width: 720px; margin: 7px 0 0; color: var(--madar-muted); font-size: 12px; }
