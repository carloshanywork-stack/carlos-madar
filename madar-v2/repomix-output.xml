#madar-app .madar-release-dot { display: inline-block; width: 7px; height: 7px; margin-left: 6px; border-radius: 50%; background: #59c59e; }
#madar-app .madar-workspace { min-height: 100vh; margin-right: 260px; }
#madar-app .madar-topbar {
