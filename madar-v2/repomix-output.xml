        versionCode 1
        versionName "1.0"
        buildConfigField "String", "REP_SERVER_URL", "\"${(System.getenv('MADAR_REP_SERVER_URL') ?: 'https://carlos-pc.tail852ef0.ts.net').replace('\\', '\\\\').replace('"', '\\"')}\""
