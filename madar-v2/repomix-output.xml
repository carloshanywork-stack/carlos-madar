#madar-app .madar-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
#madar-app .madar-grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
#madar-app .madar-panel { min-width: 0; overflow: hidden; border: 1px solid var(--madar-border); border-radius: 16px; background: var(--madar-surface); box-shadow: 0 4px 18px rgba(32, 49, 70, .025); }
#madar-app .madar-panel-pad { padding: 18px; }
#madar-app .madar-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 18px; border-bottom: 1px solid var(--madar-border); }
#madar-app .madar-panel-header h2, #madar-app .madar-panel-header h3 { margin: 0; font-size: 13px; font-weight: 800; }
#madar-app .madar-panel-header p { margin: 3px 0 0; color: var(--madar-muted); font-size: 10px; }
#madar-app .madar-panel-body { padding: 16px 18px; }
