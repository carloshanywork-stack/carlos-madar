<file path="server/modules/auth/routes.js">
import { Router } from 'express';
import { asyncHandler, allowOnlyKeys, HttpError, requireObject, requireText } from '../http.js';
import {
  authCookieOptions,
  createFirstAdmin,
  createSession,
  getSessionUserFromRequest,
  isDisabledRepSessionFromRequest,
  getTokenFromRequest,
  isSetupRequired,
  refreshRepPresence,
  revokeSession,
  authenticateUser,
  REP_ACCOUNT_DISABLED_MESSAGE,
} from './service.js';
import { env } from '../../config/env.js';
import { syncRepTracking } from '../rep/service.js';
import { loginRateLimiter } from './login-rate-limit.js';

const router = Router();

function setSessionCookie(req, res, token) {
  res.cookie(env.authCookieName, token, {
    ...authCookieOptions(req),
    maxAge: 7 * 24 * 60 * 60 * 1000,
  });
}

router.get('/status', (req, res) => {
  const user = getSessionUserFromRequest(req);
  const status = {
    authenticated: Boolean(user),
    user,
    setupRequired: isSetupRequired(),
  };
  if (!user && isDisabledRepSessionFromRequest(req)) status.message = REP_ACCOUNT_DISABLED_MESSAGE;
  res.json(status);
});

router.post('/setup', asyncHandler(async (req, res) => {
  const user = await createFirstAdmin(req.body);
  const token = createSession(user);
  setSessionCookie(req, res, token);
  res.status(201).json({ authenticated: true, user, setupRequired: false });
}));

router.post('/login', loginRateLimiter, asyncHandler(async (req, res) => {
  const body = requireObject(req.body);
  allowOnlyKeys(body, ['username', 'password']);
  const username = requireText(body.username, 'Username', { minLength: 1, maxLength: 64 });
  const password = body.password;
  if (typeof password !== 'string' || !password || password.length > 1024) {
    throw new HttpError(400, 'Username and password are required.');
  }
  const result = authenticateUser(username, password, undefined, {
    allowedRoles: ['admin', 'sales', 'operations', 'purchasing', 'finance', 'accountant'],
  });
  if (!result) {
    res.status(401).json({ error: 'اسم المستخدم أو كلمة المرور غير صحيحة' });
    return;
  }
  const { user, token } = result;
  setSessionCookie(req, res, token);
  res.json({ ok: true, user, token });
}));

router.post('/logout', (req, res) => {
  const user = getSessionUserFromRequest(req);
  if (user?.role === 'rep') syncRepTracking(user, { onDuty: false });
  revokeSession(getTokenFromRequest(req));
  if (user?.role === 'rep') refreshRepPresence(user.id);
  res.clearCookie(env.authCookieName, authCookieOptions(req));
  res.json({ ok: true });
});

export default router;
</file>

<file path="server/modules/auth/service.js">
import { createHash, randomUUID } from 'node:crypto';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import { env } from '../../config/env.js';
import { db } from '../../database/connection.js';
import { HttpError, allowOnlyKeys, requireObject, requireText } from '../http.js';
import { recordAudit } from '../audit.js';
import { syncEmployeeForUser } from '../employees/user-sync.js';

const sessionLifetimeSeconds = 7 * 24 * 60 * 60;
const failedLoginLimit = 5;
const accountLockoutMs = 15 * 60 * 1000;
const dummyPasswordHash = bcrypt.hashSync('MADAR-invalid-login-timing-only', 12);
export const REP_ACCOUNT_DISABLED_MESSAGE = 'تم تعطيل حسابك من قبل الإدارة';

function publicUser(row) {
  const user = {
    id: Number(row.id),
    username: row.username,
    fullName: row.full_name,
    role: row.role,
  };
  if (row.role !== 'rep') return user;

  let assignedRegions = [];
  try {
    const parsed = JSON.parse(row.assigned_regions_json ?? '[]');
    if (Array.isArray(parsed)) assignedRegions = parsed.filter((region) => typeof region === 'string');
  } catch {
    assignedRegions = [];
  }

  let lastLocation = null;
  try {
    const parsed = row.last_location_json ? JSON.parse(row.last_location_json) : null;
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)
        && Number.isFinite(parsed.latitude) && Number.isFinite(parsed.longitude)) {
      lastLocation = {
        latitude: parsed.latitude,
        longitude: parsed.longitude,
        accuracy: Number.isFinite(parsed.accuracy) ? parsed.accuracy : null,
        updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : null,
      };
    }
  } catch {
    lastLocation = null;
  }

  return {
    ...user,
    assignedRegions,
    isOnline: Boolean(row.is_online),
    lastLocation,
  };
}

function hashToken(token) {
  return createHash('sha256').update(token).digest('hex');
}

function readPassword(value, { setup = false } = {}) {
  if (typeof value !== 'string' || value.length < (setup ? 4 : 1) || value.length > 1024) {
    throw new HttpError(400, setup
      ? 'يجب أن تتكون كلمة المرور من 4 خانات على الأقل (أرقام أو حروف).'
      : 'Username and password are required.');
  }
  if (Buffer.byteLength(value, 'utf8') > 72) {
    throw new HttpError(400, 'يجب ألا تتجاوز كلمة المرور 72 بايتاً بترميز UTF-8.');
  }
  return value;
}

export function isSetupRequired(database = db) {
  return database.prepare('SELECT COUNT(*) AS count FROM users WHERE deleted_at IS NULL').get().count === 0;
}

export async function createFirstAdmin(input, database = db) {
  const body = requireObject(input);
  allowOnlyKeys(body, ['username', 'fullName', 'password']);
  const username = requireText(body.username, 'Username', { minLength: 3, maxLength: 64 });
  if (!/^[\p{L}\p{N}][\p{L}\p{N}._-]*$/u.test(username)) {
    throw new HttpError(400, 'Username may contain letters, numbers, dots, underscores, and hyphens.');
  }
  const fullName = requireText(body.fullName, 'Full name', { minLength: 2, maxLength: 120 });
  const password = readPassword(body.password, { setup: true });

  if (!isSetupRequired(database)) {
    throw new HttpError(409, 'Administrator setup has already been completed.');
  }

  const passwordHash = await bcrypt.hash(password, 12);
  try {
    const create = database.transaction(() => {
      if (!isSetupRequired(database)) {
        throw new HttpError(409, 'Administrator setup has already been completed.');
      }
      const result = database.prepare(`
        INSERT INTO users (username, password_hash, full_name, role)
        VALUES (?, ?, ?, 'admin')
      `).run(username, passwordHash, fullName);
      const userId = Number(result.lastInsertRowid);
      syncEmployeeForUser(database, database.prepare(`
        SELECT id, full_name, role, active, deleted_at, created_at FROM users WHERE id = ?
      `).get(userId), { audit: true });
      return publicUser(database.prepare(`
        SELECT id, username, full_name, role FROM users WHERE id = ?
      `).get(userId));
    });
    return create.immediate();
  } catch (error) {
    if (error.code === 'SQLITE_CONSTRAINT_UNIQUE') {
      throw new HttpError(409, 'That username is already in use.');
    }
    throw error;
  }
}

export function authenticateUser(username, password, database = db, { allowedRoles } = {}) {
  if (typeof username !== 'string' || !username.trim() || username.length > 64) return null;
  if (typeof password !== 'string' || !password || password.length > 1024
      || Buffer.byteLength(password, 'utf8') > 72) return null;
  const roles = allowedRoles === undefined ? null : [...new Set(allowedRoles)];
  const roleClause = roles === null ? '' : `AND role IN (${roles.map(() => '?').join(', ')})`;
  const row = database.prepare(`
    SELECT id, username, password_hash, full_name, role,
      assigned_regions_json, is_online, last_location_json, failed_login_attempts, locked_until
    FROM users
    WHERE username = ? COLLATE NOCASE AND active = 1 AND deleted_at IS NULL
      ${roleClause}
    LIMIT 1
  `).get(username.trim(), ...(roles ?? []));
  const locked = row?.locked_until && Date.parse(row.locked_until) > Date.now();
  const passwordMatches = bcrypt.compareSync(password, row && !locked ? row.password_hash : dummyPasswordHash);
  if (!row) return null;
  return finishAuthentication(row.id, passwordMatches, database, roles);
}

/** Authenticate a representative while preserving a distinct response for a valid but disabled account. */
export function authenticateRepUser(username, password, database = db) {
  if (typeof username !== 'string' || !username.trim() || username.length > 64) return null;
  if (typeof password !== 'string' || !password || password.length > 1024
      || Buffer.byteLength(password, 'utf8') > 72) return null;
  const row = database.prepare(`
    SELECT id, username, password_hash, full_name, role, active,
      assigned_regions_json, is_online, last_location_json, failed_login_attempts, locked_until
    FROM users
    WHERE username = ? COLLATE NOCASE AND role = 'rep' AND deleted_at IS NULL
    LIMIT 1
  `).get(username.trim());
  const locked = row?.locked_until && Date.parse(row.locked_until) > Date.now();
  const passwordMatches = bcrypt.compareSync(password, row && !locked ? row.password_hash : dummyPasswordHash);
  if (!row) return null;
  return finishAuthentication(row.id, passwordMatches, database, ['rep']);
}

function finishAuthentication(userId, passwordMatches, database, allowedRoles) {
  const finish = database.transaction(() => {
    const account = database.prepare(`SELECT id, username, password_hash, full_name, role, active, deleted_at,
      failed_login_attempts, locked_until, assigned_regions_json, is_online, last_location_json
      FROM users WHERE id = ?`).get(userId);
    if (!account) return null;

    const now = Date.now();
    const lockUntil = account.locked_until ? Date.parse(account.locked_until) : NaN;
    if (Number.isFinite(lockUntil) && lockUntil > now) return null;

    let failedAttempts = Number(account.failed_login_attempts) || 0;
    if (account.locked_until && (!Number.isFinite(lockUntil) || lockUntil <= now)) {
      failedAttempts = 0;
      database.prepare('UPDATE users SET failed_login_attempts = 0, locked_until = NULL WHERE id = ?').run(userId);
    }

    if (!passwordMatches) {
      failedAttempts += 1;
      const lockedUntil = failedAttempts >= failedLoginLimit ? new Date(now + accountLockoutMs).toISOString() : null;
      database.prepare('UPDATE users SET failed_login_attempts = ?, locked_until = ? WHERE id = ?')
        .run(failedAttempts, lockedUntil, userId);
      return null;
    }

    database.prepare('UPDATE users SET failed_login_attempts = 0, locked_until = NULL WHERE id = ?').run(userId);
    const roleAllowed = allowedRoles === null || allowedRoles.includes(account.role);
    if (Number(account.active) !== 1 || account.deleted_at || !roleAllowed) {
      return account.role === 'rep' && (Number(account.active) !== 1 || account.deleted_at)
        ? { disabled: true }
        : null;
    }

    const user = {
      id: Number(account.id),
      username: account.username,
      password_hash: account.password_hash,
      full_name: account.full_name,
      role: account.role,
      assigned_regions_json: account.assigned_regions_json,
      is_online: account.is_online,
      last_location_json: account.last_location_json,
    };
    const token = createSession(user, database);
    const refreshed = account.role === 'rep'
      ? database.prepare(`SELECT id, username, full_name, role, assigned_regions_json, is_online, last_location_json
        FROM users WHERE id = ?`).get(userId)
      : user;
    return { user: publicUser(refreshed), token };
  });
  return finish.immediate();
}

export function createSession(user, database = db) {
  const token = jwt.sign(
    { sub: String(user.id) },
    env.jwtSecret,
    { algorithm: 'HS256', expiresIn: sessionLifetimeSeconds, jwtid: randomUUID() },
  );
  const decoded = jwt.decode(token);
  const expiresAt = new Date(decoded.exp * 1000).toISOString();
  const create = database.transaction(() => {
    database.prepare("DELETE FROM sessions WHERE datetime(expires_at) <= datetime('now')").run();
    database.prepare(`
      INSERT INTO sessions (token_hash, user_id, expires_at)
      VALUES (?, ?, ?)
    `).run(hashToken(token), user.id, expiresAt);
    if (user.role === 'rep') {
      database.prepare('UPDATE users SET is_online = 1 WHERE id = ? AND role = \'rep\' AND active = 1 AND deleted_at IS NULL')
        .run(user.id);
    }
    recordAudit({
      database,
      actorId: user.id,
      action: 'login',
      entityType: 'user',
      entityId: user.id,
      newValues: { username: user.username, role: user.role },
    });
  });
  create();
  return token;
}

export function getTokenFromRequest(req) {
  const authorization = req.get('authorization') ?? '';
  const match = /^Bearer\s+(.+)$/i.exec(authorization);
  if (match?.[1]) return match[1];

  const cookieHeader = req.headers.cookie ?? '';
  for (const part of cookieHeader.split(';')) {
    const separator = part.indexOf('=');
    if (separator < 0 || part.slice(0, separator).trim() !== env.authCookieName) continue;
    try {
      return decodeURIComponent(part.slice(separator + 1).trim());
    } catch {
      return null;
    }
  }
  return null;
}

export function verifyToken(token, database = db) {
  if (!token || typeof token !== 'string' || token.length > 8192) return null;
  let claims;
  try {
    claims = jwt.verify(token, env.jwtSecret, { algorithms: ['HS256'] });
  } catch {
    return null;
  }
  const userId = Number(claims.sub);
  if (!Number.isSafeInteger(userId) || userId < 1) return null;

  const row = database.prepare(`
    SELECT user.id, user.username, user.full_name, user.role,
      user.assigned_regions_json, user.is_online, user.last_location_json
    FROM sessions session
    JOIN users user ON user.id = session.user_id
    WHERE session.token_hash = ? AND session.user_id = ?
      AND session.revoked_at IS NULL
      AND datetime(session.expires_at) > datetime('now')
      AND user.active = 1 AND user.deleted_at IS NULL
    LIMIT 1
  `).get(hashToken(token), userId);
  return row ? publicUser(row) : null;
}

export const getSessionUser = verifyToken;

export function getSessionUserFromRequest(req, database = db) {
  return getSessionUser(getTokenFromRequest(req), database);
}

function getRepSessionState(token, database = db) {
  if (!token || typeof token !== 'string' || token.length > 8192) return null;
  let claims;
  try {
    claims = jwt.verify(token, env.jwtSecret, { algorithms: ['HS256'] });
  } catch {
    return null;
  }
  const userId = Number(claims.sub);
  if (!Number.isSafeInteger(userId) || userId < 1) return null;
  const row = database.prepare(`
    SELECT user.id, user.username, user.full_name, user.role, user.active, user.deleted_at,
      user.assigned_regions_json, user.is_online, user.last_location_json,
      session.revoked_at
    FROM sessions session
    JOIN users user ON user.id = session.user_id
    WHERE session.token_hash = ? AND session.user_id = ?
      AND datetime(session.expires_at) > datetime('now')
    LIMIT 1
  `).get(hashToken(token), userId);
  if (!row) return null;
  return {
    user: publicUser(row),
    role: row.role,
    active: Number(row.active),
    deletedAt: row.deleted_at,
    revokedAt: row.revoked_at,
  };
}

export function getRepSessionStateFromRequest(req, database = db) {
  return getRepSessionState(getTokenFromRequest(req), database);
}

/** Check role and current account state from SQLite on every representative API request. */
export function requireActiveRep(req, res, next) {
  const session = getRepSessionStateFromRequest(req);
  if (!session) {
    res.status(401).json({ error: 'Authentication required.' });
    return;
  }
  if (session.role !== 'rep') {
    res.status(403).json({ error: 'Field representative access is required.' });
    return;
  }
  if (session.active !== 1 || session.deletedAt) {
    res.clearCookie(env.authCookieName, authCookieOptions(req));
    res.status(403).json({ success: false, message: REP_ACCOUNT_DISABLED_MESSAGE });
    return;
  }
  if (session.revokedAt) {
    res.status(401).json({ error: 'Authentication required.' });
    return;
  }
  req.user = session.user;
  next();
}

export function isDisabledRepSessionFromRequest(req, database = db) {
  const session = getRepSessionStateFromRequest(req, database);
  return Boolean(session?.role === 'rep' && (session.active !== 1 || session.deletedAt));
}

export function revokeSession(token, database = db) {
  if (!token || typeof token !== 'string' || token.length > 8192) return;
  database.prepare(`
    UPDATE sessions SET revoked_at = CURRENT_TIMESTAMP
    WHERE token_hash = ? AND revoked_at IS NULL
  `).run(hashToken(token));
}

export function refreshRepPresence(userId, database = db) {
  database.prepare(`
    UPDATE users
    SET is_online = CASE WHEN active = 1 AND deleted_at IS NULL AND EXISTS (
      SELECT 1 FROM sessions
      WHERE sessions.user_id = users.id
        AND sessions.revoked_at IS NULL
        AND datetime(sessions.expires_at) > datetime('now')
    ) THEN 1 ELSE 0 END
    WHERE id = ? AND role = 'rep'
  `).run(userId);
}

export function requireAuthentication(req, res, next) {
  const user = getSessionUserFromRequest(req);
  if (!user) {
    res.status(401).json({ error: 'Authentication required.' });
    return;
  }
  req.user = user;
  next();
}

export function authCookieOptions(req) {
  const standaloneAndroid = req?.get?.('origin') === 'https://localhost';
  return {
    httpOnly: true,
    secure: standaloneAndroid || env.authCookieSecure,
    sameSite: standaloneAndroid ? 'none' : 'strict',
    path: '/',
  };
}
</file>

<file path="server/modules/auth/users.js">
import { Router } from 'express';
import bcrypt from 'bcryptjs';
import { db } from '../../database/connection.js';
import { recordAudit } from '../audit.js';
import { requestActorId } from '../actor.js';
import { asyncHandler, allowOnlyKeys, HttpError, requireObject, requireText } from '../http.js';
import { syncEmployeeForUser } from '../employees/user-sync.js';

const router = Router();
const USER_ROLES = ['admin', 'sales', 'operations', 'purchasing', 'finance', 'accountant', 'rep'];

function requireAdmin(req, res, next) {
  if (req.user?.role !== 'admin') {
    res.status(403).json({ error: 'Administrator access is required.' });
    return;
  }
  next();
}

router.use(requireAdmin);

function normalizeAssignedRegions(value) {
  if (!Array.isArray(value)) throw new HttpError(400, 'assignedRegions must be an array of region names.');
  if (value.length > 100) throw new HttpError(400, 'assignedRegions cannot contain more than 100 regions.');
  const regions = [];
  const seen = new Set();
  for (let index = 0; index < value.length; index += 1) {
    const region = requireText(value[index], `assignedRegions[${index}]`, { maxLength: 160 });
    const key = region.normalize('NFKC').toLocaleLowerCase('ar');
    if (seen.has(key)) continue;
    seen.add(key);
    regions.push(region);
  }
  return regions;
}

function parseAssignedRegions(value) {
  try {
    const parsed = JSON.parse(value ?? '[]');
    return Array.isArray(parsed) ? parsed.filter((region) => typeof region === 'string') : [];
  } catch {
    return [];
  }
}

function serializeUser(row) {
  const user = {
    id: Number(row.id),
    username: row.username,
    full_name: row.full_name,
    role: row.role,
    active: row.active,
    isActive: Number(row.active),
    created_at: row.created_at,
  };
  if (row.role !== 'rep') return user;
  let lastLocation = null;
  try {
    const parsed = row.last_location_json ? JSON.parse(row.last_location_json) : null;
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)
        && Number.isFinite(parsed.latitude) && Number.isFinite(parsed.longitude)) {
      lastLocation = {
        latitude: parsed.latitude,
        longitude: parsed.longitude,
        accuracy: Number.isFinite(parsed.accuracy) ? parsed.accuracy : null,
        updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : null,
      };
    }
  } catch {
    lastLocation = null;
  }
  return {
    ...user,
    assignedRegions: parseAssignedRegions(row.assigned_regions_json),
    isOnline: Boolean(row.is_online),
    lastLocation,
  };
}

function normalizeActive(value, label = 'isActive') {
  if (value === true || value === 1) return 1;
  if (value === false || value === 0) return 0;
  throw new HttpError(400, `${label} must be true, false, 1, or 0.`);
}

function normalizeUsername(value) {
  const username = requireText(value, 'username', { minLength: 3, maxLength: 64 });
  if (!/^[\p{L}\p{N}][\p{L}\p{N}._-]*$/u.test(username)) {
    throw new HttpError(400, 'username contains unsupported characters.');
  }
  return username;
}

router.get('/', (req, res) => {
  res.json(db.prepare(`SELECT id, username, full_name, role, active, created_at,
      assigned_regions_json, is_online, last_location_json FROM users
    WHERE deleted_at IS NULL ORDER BY active DESC, username COLLATE NOCASE, id`).all().map(serializeUser));
});

router.post('/', asyncHandler(async (req, res) => {
  const body = requireObject(req.body);
  allowOnlyKeys(body, ['username', 'full_name', 'fullName', 'role', 'password', 'assignedRegions', 'active', 'isActive']);
  if (body.active !== undefined && body.isActive !== undefined) throw new HttpError(400, 'Provide either active or isActive, not both.');
  const username = normalizeUsername(body.username);
  const fullName = requireText(body.full_name ?? body.fullName, 'full_name', { minLength: 2, maxLength: 120 });
  const role = body.role ?? (req.baseUrl === '/api/users' ? 'rep' : undefined);
  if (!USER_ROLES.includes(role)) throw new HttpError(400, `role must be one of: ${USER_ROLES.join(', ')}.`);
  const assignedRegions = normalizeAssignedRegions(body.assignedRegions ?? []);
  const active = body.isActive === undefined && body.active === undefined
    ? 1
    : normalizeActive(body.isActive ?? body.active);
  if (role !== 'rep' && assignedRegions.length) throw new HttpError(400, 'assignedRegions can only be set for rep users.');
  if (typeof body.password !== 'string' || body.password.length < 4 || Buffer.byteLength(body.password, 'utf8') > 72) {
    throw new HttpError(400, 'يجب أن تتكون كلمة المرور من 4 خانات على الأقل وألا تتجاوز 72 بايتاً.');
  }
  const passwordHash = await bcrypt.hash(body.password, 12);
  try {
    const created = db.transaction(() => {
      const result = db.prepare(`INSERT INTO users
        (username, password_hash, full_name, role, active, assigned_regions_json)
        VALUES (?, ?, ?, ?, ?, ?)`)
        .run(username, passwordHash, fullName, role, active, JSON.stringify(assignedRegions));
      const id = Number(result.lastInsertRowid);
      const user = db.prepare(`SELECT id, full_name, role, active, deleted_at, created_at FROM users WHERE id = ?`).get(id);
      syncEmployeeForUser(db, user, { actorId: requestActorId(req), audit: true });
      recordAudit({ database: db, actorId: requestActorId(req), action: 'create', entityType: 'user', entityId: id,
        newValues: { username, full_name: fullName, role, active, assigned_regions: assignedRegions } });
      return db.prepare(`SELECT id, username, full_name, role, active, created_at,
        assigned_regions_json, is_online, last_location_json FROM users WHERE id = ?`).get(id);
    }).immediate();
    res.status(201).json(serializeUser(created));
  } catch (error) {
    if (error.code === 'SQLITE_CONSTRAINT_UNIQUE') throw new HttpError(409, 'That username is already in use.');
    throw error;
  }
}));

const updateUser = asyncHandler(async (req, res) => {
  const id = Number(req.params.id);
  if (!Number.isSafeInteger(id) || id < 1) throw new HttpError(400, 'id must be a positive integer.');
  const body = requireObject(req.body);
  allowOnlyKeys(body, ['username', 'full_name', 'fullName', 'role', 'password', 'active', 'isActive', 'assignedRegions']);
  if (body.active !== undefined && body.isActive !== undefined) throw new HttpError(400, 'Provide either active or isActive, not both.');
  if (!Object.keys(body).length) throw new HttpError(400, 'At least one user field must be provided.');
  const current = db.prepare(`SELECT id, username, full_name, role, active, created_at,
    assigned_regions_json, is_online, last_location_json FROM users WHERE id = ? AND deleted_at IS NULL`).get(id);
  if (!current) throw new HttpError(404, 'User was not found.');
  if (body.role !== undefined && !USER_ROLES.includes(body.role)) throw new HttpError(400, `role must be one of: ${USER_ROLES.join(', ')}.`);
  const requestedRegions = body.assignedRegions === undefined ? null : normalizeAssignedRegions(body.assignedRegions);
  const requestedActive = body.isActive ?? body.active;
  const suppliedName = body.full_name ?? body.fullName;
  const nextUsername = body.username === undefined ? current.username : normalizeUsername(body.username);
  const nextFullName = suppliedName === undefined
    ? current.full_name
    : requireText(suppliedName, 'full_name', { minLength: 2, maxLength: 120 });
  if (body.password !== undefined && (typeof body.password !== 'string' || body.password.length < 4 || Buffer.byteLength(body.password, 'utf8') > 72)) {
    throw new HttpError(400, 'يجب أن تتكون كلمة المرور من 4 خانات على الأقل وألا تتجاوز 72 بايتاً.');
  }
  const nextRole = body.role ?? current.role;
  const nextActive = requestedActive === undefined ? current.active : normalizeActive(requestedActive, body.isActive !== undefined ? 'isActive' : 'active');
  if (nextRole !== 'rep' && requestedRegions?.length) throw new HttpError(400, 'assignedRegions can only be set for rep users.');
  const nextRegions = nextRole === 'rep'
    ? (requestedRegions ?? parseAssignedRegions(current.assigned_regions_json))
    : [];
  const identityChanged = nextUsername !== current.username || nextRole !== current.role || body.password !== undefined;
  const nextOnline = nextRole === 'rep' && nextActive === 1 && !identityChanged
    ? current.is_online
    : 0;
  if (current.id === requestActorId(req) && (nextActive === 0 || nextRole !== 'admin')) {
    throw new HttpError(409, 'You cannot deactivate or demote your own administrator account.');
  }
  const remainingAdmin = db.prepare(`SELECT COUNT(*) AS count FROM users WHERE role = 'admin' AND active = 1 AND deleted_at IS NULL AND id != ?`).get(id).count;
  if (current.role === 'admin' && current.active === 1 && (nextRole !== 'admin' || nextActive === 0) && remainingAdmin === 0) {
    throw new HttpError(409, 'At least one active administrator must remain.');
  }
  const passwordHash = body.password === undefined ? null : await bcrypt.hash(body.password, 12);
  db.transaction(() => {
    db.prepare(`UPDATE users SET username = ?, full_name = ?, role = ?, active = ?, password_hash = COALESCE(?, password_hash),
      assigned_regions_json = ?, is_online = ? WHERE id = ?`)
      .run(nextUsername, nextFullName, nextRole, nextActive, passwordHash, JSON.stringify(nextRegions), nextOnline, id);
    const updatedUser = db.prepare(`SELECT id, full_name, role, active, deleted_at, created_at FROM users WHERE id = ?`).get(id);
    syncEmployeeForUser(db, updatedUser, { actorId: requestActorId(req), audit: true });
    if (nextActive === 0 || identityChanged) {
      db.prepare('UPDATE sessions SET revoked_at = CURRENT_TIMESTAMP WHERE user_id = ? AND revoked_at IS NULL').run(id);
    }
    if (nextActive === 0) {
      db.prepare(`UPDATE rep_duty_sessions SET ended_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
        WHERE rep_user_id = ? AND ended_at IS NULL`).run(id);
    }
    recordAudit({ database: db, actorId: requestActorId(req), action: 'update', entityType: 'user', entityId: id,
      oldValues: { username: current.username, full_name: current.full_name, role: current.role, active: current.active, assigned_regions: parseAssignedRegions(current.assigned_regions_json), is_online: Boolean(current.is_online) },
      newValues: { username: nextUsername, full_name: nextFullName, role: nextRole, active: nextActive, assigned_regions: nextRegions, is_online: Boolean(nextOnline), password_changed: Boolean(passwordHash) } });
  }).immediate();
  res.json(serializeUser(db.prepare(`SELECT id, username, full_name, role, active, created_at,
    assigned_regions_json, is_online, last_location_json FROM users WHERE id = ?`).get(id)));
});

router.patch('/:id', updateUser);
router.put('/:id', updateUser);

router.delete('/:id', (req, res) => {
  const id = Number(req.params.id);
  if (!Number.isSafeInteger(id) || id < 1) throw new HttpError(400, 'id must be a positive integer.');
  if (id === requestActorId(req)) throw new HttpError(409, 'You cannot deactivate your own account.');
  const current = db.prepare('SELECT id, username, full_name, role, active, deleted_at, created_at FROM users WHERE id = ? AND deleted_at IS NULL').get(id);
  if (!current) throw new HttpError(404, 'User was not found.');
  const remainingAdmin = db.prepare(`SELECT COUNT(*) AS count FROM users WHERE role = 'admin' AND active = 1 AND deleted_at IS NULL AND id != ?`).get(id).count;
  if (current.role === 'admin' && current.active === 1 && remainingAdmin === 0) throw new HttpError(409, 'At least one active administrator must remain.');
  db.transaction(() => {
    db.prepare('UPDATE users SET active = 0, is_online = 0, deleted_at = CURRENT_TIMESTAMP WHERE id = ?').run(id);
    const deletedUser = db.prepare('SELECT id, full_name, role, active, deleted_at, created_at FROM users WHERE id = ?').get(id);
    syncEmployeeForUser(db, deletedUser, { actorId: requestActorId(req), audit: true });
    db.prepare('UPDATE sessions SET revoked_at = CURRENT_TIMESTAMP WHERE user_id = ? AND revoked_at IS NULL').run(id);
    db.prepare(`UPDATE rep_duty_sessions SET ended_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
      WHERE rep_user_id = ? AND ended_at IS NULL`).run(id);
    recordAudit({ database: db, actorId: requestActorId(req), action: 'deactivate', entityType: 'user', entityId: id,
      oldValues: current, newValues: { active: 0, deleted_at: 'CURRENT_TIMESTAMP' } });
  }).immediate();
  res.json({ id, active: 0 });
});

export default router;
