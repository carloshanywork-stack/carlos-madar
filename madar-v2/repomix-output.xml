    navigator.serviceWorker.register(`/sw.js?v=${encodeURIComponent(__MADAR_BUILD_VERSION__)}`, { scope: '/' }).catch((error) => {
      console.warn('MADAR offline shell could not be installed:', error);
    });
  }, { once: true });
}
