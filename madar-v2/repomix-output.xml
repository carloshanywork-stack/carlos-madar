import { useEffect, useMemo, useState } from 'react';
import { api } from '../../lib/api.js';
import { errorMessage } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import { useToast } from '../../lib/useToast.js';
import Alert from '../../components/ui/Alert.jsx';
import Button from '../../components/ui/Button.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import { Input, Select } from '../../components/ui/Field.jsx';
import Icon from '../../components/ui/Icon.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import Toast from '../../components/ui/Toast.jsx';
import MachineCorrectionReview from './MachineCorrectionReview.jsx';
import MachineDirectoryMap from './MachineDirectoryMap.jsx';
import './machine-directory.css';

const PAGE_SIZE = 50;

export default function MachinesDirectory({ isAdmin = false, initialCorrections = false }) {
  const [search, setSearch] = useState('');
  const [debouncedSearch, setDebouncedSearch] = useState('');
  const [area, setArea] = useState('');
  const [locationStatus, setLocationStatus] = useState('all');
  const [page, setPage] = useState(1);
  const [directoryView, setDirectoryView] = useState(initialCorrections && isAdmin ? 'corrections' : 'machines');
  const query = new URLSearchParams({ page: String(page), limit: String(PAGE_SIZE) });
  if (debouncedSearch) query.set('search', debouncedSearch);
  if (area) query.set('area', area);
  if (locationStatus !== 'all') query.set('locationStatus', locationStatus);
  const { data, loading, error, reload } = useApi(`/api/maintenance/machines?${query.toString()}`);
  const mapQuery = new URLSearchParams();
  if (area) mapQuery.set('area', area);
  if (debouncedSearch) mapQuery.set('search', debouncedSearch);
  if (locationStatus !== 'all') mapQuery.set('locationStatus', locationStatus);
  const { data: mapData, reload: reloadMap } = useApi(`/api/maintenance/machines/map?${mapQuery.toString()}`, { enabled: isAdmin });
  const [modal, setModal] = useState('');
  const [editing, setEditing] = useState(null);
  const [selectedFile, setSelectedFile] = useState(null);
  const [preview, setPreview] = useState(null);
  const [uploadProgress, setUploadProgress] = useState(0);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState('');
  const [geofenceMachine, setGeofenceMachine] = useState(null);
  const [geofenceDraft, setGeofenceDraft] = useState({ latitude: '', longitude: '', areaName: '' });
  const [geofenceError, setGeofenceError] = useState('');
  const [capturingLocation, setCapturingLocation] = useState(false);
  const { notice, showToast, clearToast } = useToast();
  const machines = data?.machines ?? [];
  const pages = Math.max(1, Math.ceil((data?.total ?? 0) / PAGE_SIZE));
  const areaOptions = useMemo(() => data?.areas ?? [], [data?.areas]);

  useEffect(() => {
    if (isAdmin && initialCorrections) setDirectoryView('corrections');
  }, [initialCorrections, isAdmin]);

  useEffect(() => {
    const timer = window.setTimeout(() => { setDebouncedSearch(search.trim()); setPage(1); }, 300);
    return () => window.clearTimeout(timer);
  }, [search]);

  async function saveMachine(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    const payload = { code: form.get('code'), name_ar: form.get('name_ar'), name_en: form.get('name_en') || null, area: form.get('area') };
    try {
      if (editing) await api.patch(`/api/maintenance/machines/${editing.id}`, payload);
      else await api.post('/api/maintenance/machines', payload);
      setModal('');
      setEditing(null);
      await Promise.all([reload(), reloadMap()]);
      showToast(editing ? 'تم تحديث بيانات الماكينة.' : 'تمت إضافة الماكينة.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function deactivate(machine) {
    if (!window.confirm(`هل تريد إيقاف الماكينة ${machine.code}؟ ستظل سجلاتها السابقة محفوظة.`)) return;
    try {
      await api.delete(`/api/maintenance/machines/${machine.id}`);
      await Promise.all([reload(), reloadMap()]);
      showToast('تم إيقاف الماكينة مع الاحتفاظ بسجلها.');
    } catch (caught) { showToast(errorMessage(caught), 'error'); }
  }

  async function captureGeofenceLocation() {
    if (!navigator.geolocation) {
      setGeofenceError('هذا المتصفح لا يدعم تحديد الموقع. أدخل الإحداثيات يدوياً.');
      return;
    }
    setCapturingLocation(true);
    setGeofenceError('');
    try {
      const position = await new Promise((resolve, reject) => navigator.geolocation.getCurrentPosition(resolve, reject, {
        enableHighAccuracy: true,
        maximumAge: 0,
        timeout: 20000,
      }));
      setGeofenceDraft((current) => ({
        ...current,
        latitude: String(position.coords.latitude),
        longitude: String(position.coords.longitude),
      }));
    } catch (caught) {
      setGeofenceError(caught.message || 'تعذر الحصول على GPS الحالي. أدخل الإحداثيات يدوياً أو اسمح بالموقع.');
    } finally {
      setCapturingLocation(false);
    }
  }

  async function saveGeofence(event) {
    event.preventDefault();
    if (!geofenceMachine) return;
    setSaving(true);
    setGeofenceError('');
    try {
      const latitude = Number(geofenceDraft.latitude);
      const longitude = Number(geofenceDraft.longitude);
      if (!geofenceDraft.latitude || !geofenceDraft.longitude || !Number.isFinite(latitude) || !Number.isFinite(longitude)) {
        throw new Error('أدخل إحداثيات GPS صحيحة أو التقط الموقع الحالي.');
      }
      await api.patch(`/api/maintenance/machines/${geofenceMachine.id}/geofence`, {
        latitude,
        longitude,
        areaName: geofenceDraft.areaName,
      });
      setGeofenceMachine(null);
      await Promise.all([reload(), reloadMap()]);
      showToast(`ثُبّت موقع الماكينة ${geofenceMachine.code} ضمن نطاق 50 متراً.`);
    } catch (caught) {
      setGeofenceError(errorMessage(caught));
    } finally {
      setSaving(false);
    }
  }

  async function previewImport(event) {
    const file = event.target.files?.[0] ?? null;
    setSelectedFile(file);
    setPreview(null);
    setFormError('');
    if (!file) return;
    setSaving(true);
    try {
      const form = new FormData();
      form.append('file', file);
      setPreview(await api.upload('/api/maintenance/machines/import/preview', form));
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function importFile() {
    if (!selectedFile) return;
    setSaving(true);
    setUploadProgress(0);
    setFormError('');
    try {
      const form = new FormData();
      form.append('file', selectedFile);
      const counts = await api.uploadWithProgress('/api/maintenance/machines/import', form, setUploadProgress);
      setModal('');
      setSelectedFile(null);
      setPreview(null);
      await Promise.all([reload(), reloadMap()]);
      showToast(`اكتمل الاستيراد: ${counts.added} جديد، ${counts.updated} محدّث، ${counts.skipped} متجاوز.`);
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  return (
    <>
      {isAdmin && <div className="madar-machine-directory-tabs" role="tablist" aria-label="إدارة دليل الماكينات">
        <button type="button" role="tab" aria-selected={directoryView === 'machines'} className={directoryView === 'machines' ? 'active' : ''} onClick={() => setDirectoryView('machines')}>دليل الماكينات والخريطة</button>
        <button type="button" role="tab" aria-selected={directoryView === 'corrections'} className={directoryView === 'corrections' ? 'active' : ''} onClick={() => setDirectoryView('corrections')}>
          بلاغات التصحيح {mapData?.counts?.pending_correction > 0 && <b>{mapData.counts.pending_correction}</b>}
        </button>
      </div>}
      {directoryView === 'corrections' && isAdmin ? <MachineCorrectionReview onToast={showToast} /> : <>
      <div className="madar-list-toolbar madar-section">
        <label className="madar-field madar-search"><Icon name="search" size={15} /><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="بحث بالكود أو الاسم أو المنطقة" aria-label="بحث في دليل الماكينات" /></label>
        <Select label="المنطقة" value={area} onChange={(event) => { setArea(event.target.value); setPage(1); }}>
          <option value="">كل المناطق</option>{areaOptions.map((item) => <option key={item} value={item}>{item}</option>)}
        </Select>
        <Select label="حالة الموقع" value={locationStatus} onChange={(event) => { setLocationStatus(event.target.value); setPage(1); }}>
          <option value="all">كل المواقع</option>
          <option value="located">موقع محدد</option>
          <option value="unlocated">غير محدد</option>
          {isAdmin && <option value="pending_correction">بلاغ تصحيح معلق</option>}
        </Select>
        <div className="madar-inline-wrap"><Button variant="secondary" icon="upload" onClick={() => { setModal('import'); setFormError(''); }}>استيراد Excel / CSV</Button><Button icon="plus" onClick={() => { setEditing(null); setFormError(''); setModal('machine'); }}>إضافة ماكينة جديدة</Button></div>
      </div>
      {error && <div className="madar-section"><Alert tone="error">{error}</Alert></div>}
      {isAdmin && <MachineDirectoryMap machines={mapData?.machines ?? []} counts={mapData?.counts} locationStatus={locationStatus} />}
      <section className="madar-panel madar-section">
        {loading ? <LoadingState label="جارٍ تحميل دليل الماكينات" /> : machines.length ? <>
          <div className="madar-table-wrap"><table className="madar-table">
            <thead><tr><th>كود الماكينة</th><th>الاسم بالعربي</th><th>الاسم بالإنجليزي</th><th>المنطقة</th><th>موقع GPS</th><th>عدد الأوامر</th><th>إجراءات</th></tr></thead>
            <tbody>{machines.map((machine) => <tr key={machine.id}>
              <td><span className="madar-code">{machine.code}</span>{isAdmin && machine.pending_correction_count > 0 && <span className="madar-machine-pending-badge">بلاغ تصحيح معلّق · {machine.pending_correction_count}</span>}</td><td><strong>{machine.name_ar}</strong></td><td>{machine.name_en || '—'}</td><td>{machine.area}</td>
              <td>{machine.is_location_locked && Number.isFinite(machine.latitude) && Number.isFinite(machine.longitude)
                ? <span title={`${machine.latitude}, ${machine.longitude}`}>مثبت · 50م</span>
                : <span style={{ color: 'var(--madar-warning, #9a6813)' }}>بحاجة إلى تثبيت</span>}</td>
              <td>{machine.order_count}</td>
              <td><div className="madar-inline-wrap">
                {isAdmin && <Button variant="ghost" size="small" onClick={() => {
                  setGeofenceMachine(machine);
                  setGeofenceDraft({
                    latitude: machine.latitude ?? '',
                    longitude: machine.longitude ?? '',
                    areaName: machine.area_name || machine.area || '',
                  });
                  setGeofenceError('');
                }}>إعداد الموقع</Button>}
                <Button variant="ghost" size="small" icon="settings" onClick={() => { setEditing(machine); setFormError(''); setModal('machine'); }}>تعديل</Button>
                <Button variant="ghost" size="small" icon="close" onClick={() => deactivate(machine)}>إيقاف</Button>
              </div></td>
            </tr>)}</tbody>
          </table></div>
          <div className="madar-table-footer"><span>إجمالي {data.total} ماكينة</span><div className="madar-inline-wrap"><Button variant="secondary" size="small" disabled={page <= 1} onClick={() => setPage((value) => value - 1)}>السابق</Button><span>صفحة {page} من {pages}</span><Button variant="secondary" size="small" disabled={page >= pages} onClick={() => setPage((value) => value + 1)}>التالي</Button></div></div>
        </> : <EmptyState icon="factory" title="لا توجد ماكينات مطابقة" description="غيّر البحث أو المنطقة، أو أضف ماكينة جديدة." />}
      </section>

      <Modal open={modal === 'machine'} onClose={() => { setModal(''); setEditing(null); }} title={editing ? 'تعديل ماكينة' : 'إضافة ماكينة جديدة'}>
        <form onSubmit={saveMachine}>
          <div className="madar-form-stack">
            <Input label="كود الماكينة *" name="code" required defaultValue={editing?.code ?? ''} maxLength={64} />
            <Input label="الاسم بالعربي *" name="name_ar" required defaultValue={editing?.name_ar ?? ''} maxLength={200} />
            <Input label="الاسم بالإنجليزي" name="name_en" defaultValue={editing?.name_en ?? ''} maxLength={200} />
            <Input
              label="المنطقة *"
              name="area"
              required
              defaultValue={editing?.area ?? ''}
              maxLength={160}
              list="machine-areas-datalist"
              placeholder="اختر منطقة مسجلة أو اكتب اسم منطقة جديدة..."
              autoComplete="off"
            />
            <datalist id="machine-areas-datalist">
              {(areaOptions ?? []).map((areaName) => (
                <option key={areaName} value={areaName} />
              ))}
            </datalist>
          </div>
          {formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setModal('')}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ الحفظ…' : 'حفظ الماكينة'}</Button></div>
        </form>
      </Modal>

      <Modal open={Boolean(geofenceMachine)} onClose={() => { if (!saving) setGeofenceMachine(null); }} title={`تثبيت موقع ${geofenceMachine?.code ?? 'الماكينة'}`} description="يجب تثبيت إحداثيات موثوقة قبل أن يتمكن المندوب من فتح الكاميرا. يقبل الخادم الزيارة داخل 50 متراً فقط.">
        <form onSubmit={saveGeofence}>
          <div className="madar-form-stack">
            <Input label="المحافظة / المنطقة المسجلة" value={geofenceDraft.areaName} onChange={(event) => setGeofenceDraft((current) => ({ ...current, areaName: event.target.value }))} maxLength={160} required />
            <Input label="خط العرض Latitude *" type="number" step="any" value={geofenceDraft.latitude} onChange={(event) => setGeofenceDraft((current) => ({ ...current, latitude: event.target.value }))} required />
            <Input label="خط الطول Longitude *" type="number" step="any" value={geofenceDraft.longitude} onChange={(event) => setGeofenceDraft((current) => ({ ...current, longitude: event.target.value }))} required />
            <p className="madar-muted">نطاق الزيارة ثابت عند 50 متراً. استخدم GPS وأنت بجوار الماكينة، أو أدخل إحداثياتها المسجلة.</p>
            {geofenceError && <Alert tone="error">{geofenceError}</Alert>}
          </div>
          <div className="madar-form-actions">
            <Button variant="secondary" type="button" onClick={() => void captureGeofenceLocation()} disabled={capturingLocation || saving}>{capturingLocation ? 'جارٍ تحديد الموقع…' : 'التقاط GPS الحالي'}</Button>
            <Button variant="secondary" type="button" onClick={() => setGeofenceMachine(null)} disabled={saving}>إلغاء</Button>
            <Button type="submit" disabled={saving || capturingLocation}>{saving ? 'جارٍ الحفظ…' : 'تثبيت الموقع'}</Button>
          </div>
        </form>
      </Modal>

      <Modal open={modal === 'import'} onClose={() => { if (!saving) { setModal(''); setSelectedFile(null); setPreview(null); } }} title="استيراد دليل الماكينات" description="يدعم Excel وCSV. تتم المطابقة على كود الماكينة للحفاظ على المعرفات والارتباطات الحالية.">
        <div className="madar-form-stack">
          <Input label="ملف Excel أو CSV" type="file" accept=".xlsx,.xls,.csv" onChange={previewImport} />
          {preview && <>
            <Alert tone="info">عدد الصفوف: {preview.totalRows} · صفوف مكتملة ضمن المعاينة: {preview.previewValidRows}</Alert>
            {preview.preview.length > 0 && <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>الكود</th><th>الاسم العربي</th><th>الاسم الإنجليزي</th><th>المنطقة</th></tr></thead><tbody>{preview.preview.map((row, index) => <tr key={`${row.code}-${index}`}><td>{row.code || '—'}</td><td>{row.name_ar || '—'}</td><td>{row.name_en || '—'}</td><td>{row.area || '—'}</td></tr>)}</tbody></table></div>}
          </>}
          {saving && selectedFile && <div className="madar-small madar-muted">جارٍ {preview ? 'الاستيراد' : 'قراءة المعاينة'}… {uploadProgress ? `${uploadProgress}%` : ''}</div>}
          {uploadProgress > 0 && <progress value={uploadProgress} max="100" aria-label="تقدم رفع الملف" />}
          {formError && <Alert tone="error">{formError}</Alert>}
        </div>
        <div className="madar-form-actions"><Button variant="secondary" disabled={saving} onClick={() => setModal('')}>إلغاء</Button><Button disabled={!selectedFile || !preview || saving} onClick={importFile} icon="upload">{saving ? 'جارٍ الاستيراد…' : 'تنفيذ الاستيراد'}</Button></div>
      </Modal>
      </>}
      <Toast notice={notice} onClose={clearToast} />
    </>
  );
}
</file>

<file path="client/src/modules/maintenance/MaintenancePage.jsx">
import { useEffect, useMemo, useState } from 'react';
import { Link, useLocation } from 'react-router-dom';
import { api } from '../../lib/api.js';
import { regionAccessLabel } from '../../lib/regions.js';
import { errorMessage, formatDate } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import { useToast } from '../../lib/useToast.js';
import Alert from '../../components/ui/Alert.jsx';
import Badge from '../../components/ui/Badge.jsx';
import Button from '../../components/ui/Button.jsx';
import EmployeeCheckboxList from '../../components/ui/EmployeeCheckboxList.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import { Input, Select, Textarea } from '../../components/ui/Field.jsx';
import Icon from '../../components/ui/Icon.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import PageHeader from '../../components/ui/PageHeader.jsx';
import Tabs from '../../components/ui/Tabs.jsx';
import Toast from '../../components/ui/Toast.jsx';
import AreaMaintenanceDirectory from './AreaMaintenanceDirectory.jsx';
import MachinesDirectory from './MachinesDirectory.jsx';
import MaintenanceReasonsDirectory from './MaintenanceReasonsDirectory.jsx';

const statusItems = [
  { value: 'in_progress', label: 'قيد التنفيذ' },
  { value: 'review', label: 'بانتظار المراجعة' },
  { value: 'archived', label: 'الأرشيف' },
];

export default function MaintenancePage({ isAdmin = false }) {
  const location = useLocation();
  const requestedView = new URLSearchParams(location.search).get('view');
  const initialCorrections = new URLSearchParams(location.search).get('review') === 'corrections';
  const [view, setView] = useState(() => isAdmin && ['machines', 'corrections'].includes(requestedView) ? 'machines' : 'orders');
  const [status, setStatus] = useState('in_progress');
  const { data: orders, loading, error, reload } = useApi(`/api/maintenance/orders?status=${status}`);
  const { data: clients } = useApi('/api/clients');
  const { data: areas } = useApi('/api/maintenance/areas');
  const { data: representatives, loading: representativesLoading } = useApi('/api/maintenance/representatives');
  const [createOpen, setCreateOpen] = useState(false);
  const [employeeIds, setEmployeeIds] = useState([]);
  const [repUserIds, setRepUserIds] = useState([]);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState('');
  const [search, setSearch] = useState('');
  const [selectedAreas, setSelectedAreas] = useState([]);
  const [autoPopulate, setAutoPopulate] = useState(true);
  const selectedAreasQuery = selectedAreas.join('، ');
  const { data: areaMachines } = useApi(selectedAreas.length
    ? `/api/maintenance/machines?area=${encodeURIComponent(selectedAreasQuery)}&limit=1`
    : '', { enabled: selectedAreas.length > 0 });
  const { notice, showToast, clearToast } = useToast();
  const filteredOrders = useMemo(() => (orders ?? []).filter((order) =>
    `${order.order_code} ${order.client_name} ${order.client_code} ${order.area_summary || ''} ${order.area || ''}`
      .toLowerCase()
      .includes(search.toLowerCase())), [orders, search]);

  useEffect(() => {
    if (isAdmin && ['machines', 'corrections'].includes(requestedView)) setView('machines');
  }, [isAdmin, requestedView]);

  async function createOrder(event) {
    event.preventDefault();
    if (!selectedAreas.length) {
      setFormError('اختر منطقة واحدة على الأقل لإنشاء أمر الصيانة.');
      return;
    }
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      const orderPayload = {
        clientId: Number(form.get('clientId')),
        areas: selectedAreas,
        autoPopulateAreaMachines: Boolean(selectedAreas.length && autoPopulate),
        employeeIds,
        notes: form.get('notes') || undefined,
      };
      if (Array.isArray(representatives)) orderPayload.repUserIds = repUserIds;
      await api.post('/api/maintenance/orders', orderPayload);
      setCreateOpen(false);
      setEmployeeIds([]);
      setRepUserIds([]);
      setSelectedAreas([]);
      if (status !== 'in_progress') setStatus('in_progress');
      else await reload();
      showToast('تم إنشاء أمر الصيانة بنجاح.');
    } catch (caught) {
      setFormError(errorMessage(caught));
    } finally {
      setSaving(false);
    }
  }

  async function deleteArchivedOrder(order) {
    if (!window.confirm(`هل تريد حذف أمر الصيانة ${order.order_code} نهائياً من الأرشيف؟ ستُزال ملفاته ويُحفظ سجل تاريخي آمن.`)) return;
    setSaving(true);
    try {
      await api.delete(`/api/maintenance/orders/${order.id}`);
      await reload();
      showToast(`تم حذف أمر الصيانة ${order.order_code} من الأرشيف.`);
    } catch (caught) {
      showToast(errorMessage(caught), 'error');
    } finally {
      setSaving(false);
    }
  }

  return (
    <>
      <PageHeader
        kicker="الخدمة الميدانية · الصيانة"
        title={view === 'reasons' ? 'أسباب الأعطال' : view === 'machines' ? 'قاعدة الماكينات' : view === 'area_notes' ? 'صيانات المناطق' : 'أوامر الصيانة'}
        description={view === 'reasons' ? 'إدارة أسباب الأعطال التي تظهر في بطاقات فحص الصيانة.' : view === 'machines' ? 'دليل الماكينات النشطة ومناطق الخدمة والاستيراد.' : view === 'area_notes' ? 'عرض أحدث الملاحظات الفنية المسجلة لكل ماكينة حسب المنطقة.' : 'من إنشاء أمر الخدمة حتى فحص الآلات، التوثيق بالصور، والمراجعة والأرشفة.'}
        actions={view === 'orders' && <Button icon="plus" onClick={() => { setFormError(''); setEmployeeIds([]); setRepUserIds([]); setSelectedAreas([]); setAutoPopulate(true); setCreateOpen(true); }}>إنشاء أمر صيانة</Button>}
      />
      <div className="madar-section"><Tabs items={[
        { value: 'orders', label: 'أوامر الصيانة (Orders)' },
        { value: 'machines', label: 'قاعدة الماكينات (Machines Directory)' },
        { value: 'reasons', label: 'أسباب الأعطال (Maintenance Reasons)' },
        { value: 'area_notes', label: 'صيانات المناطق (Area Maintenance)' },
      ]} value={view} onChange={setView} ariaLabel="مساحات الصيانة" /></div>
      {view === 'area_notes' ? <AreaMaintenanceDirectory /> : view === 'machines' ? <MachinesDirectory isAdmin={isAdmin} initialCorrections={initialCorrections} /> : view === 'reasons' ? <MaintenanceReasonsDirectory /> : <>
      <div className="madar-list-toolbar madar-section">
        <Tabs items={statusItems.map((item) => ({ ...item, count: status === item.value ? orders?.length : undefined }))} value={status} onChange={setStatus} ariaLabel="حالة أوامر الصيانة" />
        <label className="madar-field madar-search"><Icon name="search" size={15} /><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="بحث برقم الأمر، العميل، أو المنطقة..." aria-label="بحث أوامر الصيانة" /></label>
      </div>
      {error && <div className="madar-section"><Alert tone="error">{error}</Alert></div>}
      <section className="madar-panel madar-section">
        {loading ? <LoadingState label="جارٍ تحميل أوامر الصيانة" /> : filteredOrders.length ? (
          <div className="madar-table-wrap"><table className="madar-table">
            <thead><tr><th>أمر الخدمة</th><th>العميل</th><th>المناطق</th><th>عدد الآلات</th><th>الفنيون</th><th>المناديب</th><th>تاريخ الإنشاء</th><th>الحالة</th><th /></tr></thead>
            <tbody>{filteredOrders.map((order) => (
              <tr key={order.id}>
                <td><Link className="madar-table-link madar-code" to={`/maintenance/${order.id}`}>{order.order_code}</Link></td>
                <td><div className="madar-table-primary">{order.client_name}</div><small className="madar-code">{order.client_code}</small></td>
                <td>
                  {Array.isArray(order.areas) && order.areas.length ? (
                    <div className="madar-inline-wrap" style={{ gap: '4px', maxWidth: '240px', flexWrap: 'wrap' }}>
                      {order.areas.map((areaName, idx) => <span key={`${areaName}-${idx}`} className="madar-badge madar-badge-info" style={{
                        fontSize: '11px', padding: '2px 8px', borderRadius: '6px', background: 'rgba(56, 189, 248, 0.12)',
                        color: '#38bdf8', border: '1px solid rgba(56, 189, 248, 0.25)', fontWeight: 600, whiteSpace: 'nowrap',
                      }}>{areaName}</span>)}
                    </div>
                  ) : order.area ? (
                    <span className="madar-badge madar-badge-info" style={{
                      fontSize: '11px', padding: '2px 8px', borderRadius: '6px', background: 'rgba(56, 189, 248, 0.12)',
                      color: '#38bdf8', border: '1px solid rgba(56, 189, 248, 0.25)', fontWeight: 600, whiteSpace: 'nowrap',
                    }}>{order.area}</span>
                  ) : <span style={{ color: 'var(--madar-muted)' }}>—</span>}
                </td>
                <td>{order.card_count}</td><td>{order.technician_count}</td><td>{order.representative_names || '—'}</td><td>{formatDate(order.created_at)}</td>
                <td><Badge status={order.status} /></td>
                <td>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                    <Link className="madar-button madar-button-ghost madar-button-small" to={`/maintenance/${order.id}`} aria-label="فتح أمر الصيانة"><Icon name="chevron" size={13} /></Link>
                    {status === 'archived' && isAdmin && <button
                      type="button"
                      className="madar-button madar-button-ghost madar-button-small"
                      style={{ color: '#f87171', padding: '4px 6px' }}
                      title="حذف هذا الأمر المؤرشف نهائياً"
                      aria-label={`حذف أمر الصيانة ${order.order_code}`}
                      disabled={saving}
                      onClick={(event) => {
                        event.stopPropagation();
                        void deleteArchivedOrder(order);
                      }}
                    >🗑️</button>}
                  </div>
                </td>
              </tr>
            ))}</tbody>
          </table></div>
        ) : <EmptyState icon="wrench" title={search ? 'لا توجد نتائج' : 'لا توجد أوامر في هذه المرحلة'} description={search ? 'جرّب كلمة بحث أخرى.' : 'يمكنك إنشاء أمر صيانة جديد لبدء الزيارة الميدانية.'} action={status === 'in_progress' && !search && <Button icon="plus" onClick={() => setCreateOpen(true)}>إنشاء أمر صيانة</Button>} />}
      </section>

        <Modal open={createOpen} onClose={() => setCreateOpen(false)} title="إنشاء أمر صيانة" description="أمر ميداني مستقل عن أوامر الإنتاج. عيّن المندوبين لتظهر لهم بطاقات هذا الأمر في التطبيق.">
        <form onSubmit={createOrder}>
          <div className="madar-form-stack">
            <Select label="العميل *" name="clientId" required defaultValue="">
              <option value="" disabled>اختر العميل</option>
              {(clients ?? []).map((client) => <option key={client.id} value={client.id}>{client.name} · {client.code}</option>)}
            </Select>
            <div className="madar-field">
              <span>المنطقة / خط السير * (اختر منطقة أو أكثر)</span>
              {(areas ?? []).length ? <div className="madar-employee-picker madar-area-picker" role="group" aria-label="مناطق أمر الصيانة" aria-required="true">
                {(areas ?? []).map((areaName) => {
                  const checked = selectedAreas.includes(areaName);
                  return <label key={areaName} className={`employee-checkbox-card ${checked ? 'selected' : ''}`}>
                    <input
                      className="madar-checkbox"
                      type="checkbox"
                      checked={checked}
                      onChange={() => setSelectedAreas((current) => checked
                        ? current.filter((area) => area !== areaName)
                        : [...current, areaName])}
                    />
                    <span className="madar-checkbox-title">{areaName}</span>
                  </label>;
                })}
              </div> : <small className="madar-field-hint">لا توجد مناطق نشطة في دليل الماكينات.</small>}
              <small className="madar-field-hint">
                {selectedAreas.length ? `المناطق المحددة: ${selectedAreas.join('، ')}` : 'يجب اختيار منطقة واحدة على الأقل.'}
              </small>
            </div>
            {selectedAreas.length > 0 && <label className="madar-check-row"><input type="checkbox" checked={autoPopulate} onChange={(event) => setAutoPopulate(event.target.checked)} /><span>إدراج جميع ماكينات المناطق المحددة تلقائياً في أمر الصيانة (عدد: {areaMachines?.total ?? 0})</span></label>}
            {Array.isArray(representatives) && <div className="madar-field">
              <span>المناديب المكلّفون بالتطبيق</span>
              {representativesLoading ? <small className="madar-field-hint">جارٍ تحميل حسابات المناديب…</small> : representatives.length ? (
                <div className="madar-employee-picker" role="group" aria-label="المناديب المكلّفون">
                  {representatives.map((rep) => {
                    const selected = repUserIds.includes(Number(rep.id));
                    return <label key={rep.id} className={`employee-checkbox-card ${selected ? 'selected' : ''}`}>
                      <input className="madar-checkbox" type="checkbox" checked={selected}
                        onChange={() => setRepUserIds((current) => selected
                          ? current.filter((userId) => userId !== Number(rep.id))
                          : [...current, Number(rep.id)])} />
                      <span className="madar-checkbox-title">{rep.full_name}</span>
                      <small className="madar-field-hint">{rep.username} · {regionAccessLabel(rep.assignedRegions)}</small>
                    </label>;
                  })}
                </div>
              ) : <small className="madar-field-hint">لا توجد حسابات مندوب نشطة. أنشئ حساباً من الإعدادات أولاً.</small>}
            </div>}
            <EmployeeCheckboxList department="Maintenance" selectedIds={employeeIds} onChange={setEmployeeIds} title="الفنيون المكلّفون (اختياري)" />
            <Textarea label="ملاحظات الخدمة" name="notes" maxLength={10000} placeholder="وصف موجز للزيارة أو نطاق العمل…" />
          </div>
          {formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}
          {!clients?.length && <div className="madar-form-note"><Alert tone="info">أضف ملف عميل أولاً قبل إنشاء أمر صيانة.</Alert></div>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setCreateOpen(false)}>إلغاء</Button><Button type="submit" disabled={saving || !clients?.length}>{saving ? 'جارٍ الإنشاء…' : 'إنشاء الأمر'}</Button></div>
        </form>
      </Modal>
      </>}
      <Toast notice={notice} onClose={clearToast} />
    </>
  );
}
</file>

<file path="client/src/modules/maintenance/MaintenancePptxExportModal.jsx">
import { useEffect, useMemo, useRef, useState } from 'react';
import Alert from '../../components/ui/Alert.jsx';
import Button from '../../components/ui/Button.jsx';
import { Select } from '../../components/ui/Field.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import { errorMessage } from '../../lib/format.js';
import { api, apiUrl } from '../../lib/api.js';
import { useApi } from '../../lib/useApi.js';

function statusLabel(status) {
  return ({ in_progress: 'قيد التنفيذ', review: 'بانتظار المراجعة', archived: 'مؤرشف' })[status] ?? status;
}

function downloadExportUrl(downloadUrl) {
  const anchor = document.createElement('a');
  anchor.href = apiUrl(downloadUrl);
  anchor.rel = 'noopener';
  document.body.append(anchor);
  anchor.click();
  anchor.remove();
}

function createExportId() {
  return window.crypto?.randomUUID?.()
    ?? `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;
}

export default function MaintenancePptxExportModal({
  open,
  onClose,
  currentOrder = null,
  defaultScope = currentOrder ? 'current' : 'archive',
}) {
  const { data: inProgressOrders, loading: inProgressLoading } = useApi('/api/maintenance/orders?status=in_progress', { enabled: open });
  const { data: reviewOrders, loading: reviewLoading } = useApi('/api/maintenance/orders?status=review', { enabled: open });
  const { data: archivedOrders, loading: archivedLoading } = useApi('/api/maintenance/orders?status=archived', { enabled: open });
  const { data: reasons, loading: reasonsLoading, error: reasonsError } = useApi('/api/maintenance/reasons?includeInactive=true', { enabled: open });
  const [scope, setScope] = useState(defaultScope);
  const [selectedOrderIds, setSelectedOrderIds] = useState([]);
  const [reasonId, setReasonId] = useState('');
  const [area, setArea] = useState('');
  const [groupBy, setGroupBy] = useState('area');
  const [showReasonFooter, setShowReasonFooter] = useState(false);
  const [useFixedLogoOnCover, setUseFixedLogoOnCover] = useState(false);
  const [exporting, setExporting] = useState(false);
  const [liveProgress, setLiveProgress] = useState(null);
  const [error, setError] = useState('');
  const progressPollingRef = useRef(null);
  const ordersLoading = inProgressLoading || reviewLoading || archivedLoading;
  const allOrders = useMemo(() => {
    const byId = new Map();
    for (const order of [...(archivedOrders ?? []), ...(reviewOrders ?? []), ...(inProgressOrders ?? []), ...(currentOrder ? [currentOrder] : [])]) {
      byId.set(order.id, order);
    }
    return [...byId.values()].sort((left, right) => String(right.created_at ?? '').localeCompare(String(left.created_at ?? '')) || right.id - left.id);
  }, [archivedOrders, currentOrder, inProgressOrders, reviewOrders]);
  const areas = useMemo(() => [...new Set(allOrders.map((order) => order.area).filter(Boolean))]
    .sort((left, right) => left.localeCompare(right, 'ar')), [allOrders]);

  useEffect(() => {
    if (!open) return;
    setScope(currentOrder ? defaultScope : 'archive');
    setSelectedOrderIds(currentOrder ? [currentOrder.id] : []);
    setReasonId('');
    setArea('');
    setGroupBy('area');
    setShowReasonFooter(false);
    setUseFixedLogoOnCover(false);
    setExporting(false);
    setLiveProgress(null);
    setError('');
  }, [currentOrder?.id, defaultScope, open]);

  useEffect(() => () => {
    const polling = progressPollingRef.current;
    if (!polling) return;
    window.clearInterval(polling.intervalId);
    polling.controller.abort();
    progressPollingRef.current = null;
  }, []);

  function stopProgressPolling() {
    const polling = progressPollingRef.current;
    if (!polling) return;
    window.clearInterval(polling.intervalId);
    polling.controller.abort();
    progressPollingRef.current = null;
  }

  function startProgressPolling(exportId) {
    stopProgressPolling();
    const controller = new AbortController();
    let requestPending = false;
    const poll = async () => {
      if (requestPending || controller.signal.aborted) return;
      requestPending = true;
      try {
        const query = new URLSearchParams({ exportId });
        const response = await fetch(`/api/maintenance/export/pptx/progress?${query}`, {
          credentials: 'include',
          cache: 'no-store',
          signal: controller.signal,
        });
        if (!response.ok) return;
        const progress = await response.json();
        if (!progress || controller.signal.aborted) return;
        if (progress.error) {
          stopProgressPolling();
          setLiveProgress({ ...progress, active: false });
          setError(progress.error);
          setExporting(false);
          return;
        }
        if (progress.ready && progress.downloadUrl) {
          stopProgressPolling();
          setLiveProgress({ active: false, percent: 100, stage: 'اكتمل التجهيز، جارٍ التنزيل...' });
          downloadExportUrl(progress.downloadUrl);
          setExporting(false);
          onClose?.();
          return;
        }
        setLiveProgress(progress);
      } catch {
        // Keep polling through transient network failures; the start request reports submission errors.
      } finally {
        requestPending = false;
      }
    };
    const intervalId = window.setInterval(() => { void poll(); }, 500);
    progressPollingRef.current = { intervalId, controller };
    void poll();
  }

  function toggleSelectedOrder(orderId) {
    setSelectedOrderIds((current) => current.includes(orderId)
      ? current.filter((id) => id !== orderId)
      : [...current, orderId]);
  }

  async function createExport(event) {
    event.preventDefault();
    setError('');
    let orderIds;
    if (scope === 'current') {
      if (!currentOrder?.id) {
        setError('افتح تفاصيل أمر صيانة لاستخدام نطاق الأمر الحالي.');
        return;
      }
      orderIds = [currentOrder.id];
    } else if (scope === 'archive') {
      orderIds = [];
    } else {
      orderIds = selectedOrderIds;
      if (!orderIds.length) {
        setError('حدد أمراً واحداً على الأقل لإنشاء التقرير.');
        return;
      }
    }

    setExporting(true);
    const exportId = createExportId();
    setLiveProgress({ active: true, total: 0, current: 0, percent: 0, stage: 'جارٍ بدء تجهيز التقرير...' });
    startProgressPolling(exportId);
    try {
      const result = await api.post('/api/maintenance/export/pptx', {
        orderIds,
        reasonId: reasonId ? Number(reasonId) : null,
        area: area || null,
        groupBy,
        showReasonFooter,
        useFixedLogoOnCover,
        mode: 'async',
        exportId,
      });
      if (result?.status !== 'processing' || result.exportId !== exportId) {
        throw new Error('لم يؤكد الخادم بدء تجهيز ملف PowerPoint.');
      }
    } catch (caught) {
      stopProgressPolling();
      setError(errorMessage(caught));
      setExporting(false);
    }
  }

  function close() {
    if (!exporting) onClose?.();
  }

  return (
    <Modal open={open} onClose={close} title="خيارات تصدير عرض PowerPoint" description="اختر نطاق الأوامر وتصنيف الشرائح قبل إنشاء التقرير." wide>
      <form className="madar-form-stack madar-pptx-export-form" onSubmit={createExport}>
        {error && <Alert tone="error">{error}</Alert>}
        {reasonsError && <Alert tone="error">تعذر تحميل أسباب الصيانة: {reasonsError}</Alert>}

        <fieldset className="madar-export-fieldset">
          <legend>نطاق الأوامر</legend>
          <div className="madar-export-scope-options">
            {currentOrder && <label className="madar-export-radio-option">
              <input type="radio" name="pptx-scope" value="current" checked={scope === 'current'} onChange={() => setScope('current')} />
              <span><strong>الأمر الحالي فقط</strong><small>{currentOrder.order_code} · {currentOrder.client_name}</small></span>
            </label>}
            <label className="madar-export-radio-option">
              <input type="radio" name="pptx-scope" value="archive" checked={scope === 'archive'} onChange={() => setScope('archive')} />
              <span><strong>كل الأرشيف</strong><small>يشمل أوامر الصيانة المؤرشفة المطابقة للفلاتر</small></span>
            </label>
            <label className="madar-export-radio-option">
              <input type="radio" name="pptx-scope" value="selected" checked={scope === 'selected'} onChange={() => setScope('selected')} />
              <span><strong>تحديد أوامر محددة</strong><small>اختر أكثر من أمر صيانة عند الحاجة</small></span>
            </label>
          </div>
          {scope === 'selected' && <div className="madar-export-order-picker" aria-label="الأوامر المتاحة للتحديد">
            {ordersLoading ? <LoadingState label="جارٍ تحميل أوامر الصيانة" /> : allOrders.length ? allOrders.map((order) => (
              <label className="madar-export-order-option" key={order.id}>
                <input className="madar-checkbox" type="checkbox" checked={selectedOrderIds.includes(order.id)} onChange={() => toggleSelectedOrder(order.id)} />
                <span className="madar-code">{order.order_code}</span>
                <strong>{order.client_name}</strong>
                <small>{order.area || 'منطقة غير محددة'} · {statusLabel(order.status)}</small>
              </label>
            )) : <p className="madar-muted madar-small">لا توجد أوامر متاحة.</p>}
          </div>}
        </fieldset>

        <div className="madar-export-filter-grid">
          <Select label="تصنيف وتصفية الأعطال" value={reasonId} disabled={reasonsLoading} onChange={(event) => setReasonId(event.target.value)}>
            <option value="">جميع الأعطال والأعمال (شامل)</option>
            {(reasons ?? []).map((reason) => <option key={reason.id} value={reason.id}>{reason.name}{reason.active ? '' : ' (معطّل)'}</option>)}
          </Select>
          <Select label="تصفية المنطقة" value={area} onChange={(event) => setArea(event.target.value)}>
            <option value="">كل المناطق</option>
            {areas.map((item) => <option key={item} value={item}>{item}</option>)}
          </Select>
        </div>

        <fieldset className="madar-export-fieldset">
          <legend>ترتيب الشرائح</legend>
          <div className="madar-export-group-options">
            {[
              ['reason', 'تجميع حسب سبب الصيانة'],
              ['area', 'تجميع حسب المنطقة'],
              ['none', 'تسلسلي عادي'],
            ].map(([value, label]) => <label className="madar-export-radio-option madar-export-radio-inline" key={value}>
              <input type="radio" name="pptx-group-by" value={value} checked={groupBy === value} onChange={() => setGroupBy(value)} />
              <span><strong>{label}</strong></span>
            </label>)}
          </div>
          <label className="madar-export-radio-option madar-export-radio-inline madar-export-footer-option">
            <input type="checkbox" checked={showReasonFooter} onChange={(event) => setShowReasonFooter(event.target.checked)} />
            <span><strong>إظهار سبب الصيانة فقط كتذييل لشريحة الماكينة</strong><small>عند التفعيل ينتقل السبب من بيانات الشريحة إلى التذييل، مع بقاء الصور ومعلومات الماكينة في محتوى الشريحة.</small></span>
          </label>
          <label className="madar-export-radio-option madar-export-radio-inline madar-export-footer-option">
            <input type="checkbox" checked={useFixedLogoOnCover} onChange={(event) => setUseFixedLogoOnCover(event.target.checked)} />
            <span><strong>استخدام الشعار الثابت على غلاف التقرير أيضاً</strong><small>يظهر الشعار الثابت على شرائح الماكينات دائماً؛ عند تفعيل هذا الخيار يظهر على الغلاف بدلاً من شعار العميل.</small></span>
          </label>
        </fieldset>

        {exporting && <div className="madar-export-progress-card" role="status" aria-live="polite">
          <div className="madar-export-progress-header">
            <div className="madar-export-progress-machine">
              <strong>{liveProgress?.machineName
                ? `📍 جارٍ معالجة: ${liveProgress.machineName}${liveProgress.machineCode ? ` · ${liveProgress.machineCode}` : ''}`
                : liveProgress?.stage || 'جارٍ بدء تجهيز التقرير...'}</strong>
              {liveProgress?.machineNameEn && <small>{liveProgress.machineNameEn}</small>}
              {liveProgress?.area && <small>{liveProgress.area}</small>}
            </div>
            <span className="madar-export-progress-percent">{liveProgress?.percent ?? 0}٪</span>
          </div>
          <progress value={liveProgress?.percent ?? 0} max="100" aria-label="تقدم إنشاء وتنزيل PowerPoint" />
          <div className="madar-export-progress-details">
            <span>{liveProgress?.total > 0
              ? `(${liveProgress.current ?? 0} من ${liveProgress.total} ماكينة)`
              : 'جارٍ تجهيز قائمة الماكينات...'}</span>
            <span>{typeof liveProgress?.estimatedSeconds === 'number'
              ? `⏱️ الوقت المتبقي التقريبي: ${liveProgress.estimatedSeconds} ثانية`
              : '⏱️ جارٍ تقدير الوقت...'}</span>
            {liveProgress?.speedSecPerMachine && <span>⚡ السرعة: {liveProgress.speedSecPerMachine} ث/ماكينة</span>}
          </div>
        </div>}
        <div className="madar-form-actions">
          <Button variant="secondary" disabled={exporting} onClick={close}>إلغاء</Button>
          <Button type="submit" icon="presentation" disabled={exporting || reasonsLoading || (scope === 'selected' && (ordersLoading || !selectedOrderIds.length))}>
            {exporting ? 'جارٍ إنشاء العرض…' : 'إنشاء وتنزيل ملف PowerPoint'}
          </Button>
        </div>
      </form>
    </Modal>
  );
}
</file>

