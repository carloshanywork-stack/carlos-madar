  logoForm.append('logo', new Blob([pngBytes], { type: 'image/png' }), 'brand.png');
  const uploadedLogo = await request(`/api/clients/${client.id}/logo`, { method: 'POST', body: logoForm });
  assert.equal(uploadedLogo.response.status, 200);
