import { existsSync, lstatSync, readFileSync, realpathSync, statSync } from 'node:fs';
import { join, relative, resolve, sep } from 'node:path';
import { env } from './env.js';
import { assertMountedStorage, resolveStorageLayout } from './storage-layout.js';

export const projectRoot = env.projectRoot;
const storageLayout = resolveStorageLayout({
  projectRoot,
  storageMountPath: env.storageMountPath,
  dataDirectory: env.dataDirectory,
  databasePath: env.databasePath,
  storageRoot: env.storageRoot,
  backupRoot: env.backupRoot,
});

export const storageMountPath = storageLayout.storageMountPath;
export const dataDirectory = storageLayout.dataDirectory;
export const thumbnailCacheDirectory = join(dataDirectory, 'thumbnail-cache');
export const storageRoot = storageLayout.storageRoot;
export const databasePath = storageLayout.databasePath;
export const backupRoot = storageLayout.backupRoot;
export const offlineMapPath = resolve(projectRoot, env.offlineMapPath ?? join(dataDirectory, 'offline-maps.mbtiles'));
export const schemaPath = join(projectRoot, 'server', 'database', 'schema.sql');
export const clientDistPath = join(projectRoot, 'client', 'dist');
export const repApkPath = resolve(
  projectRoot,
  env.repApkPath
    ?? (existsSync(join(projectRoot, 'madar-rep-release.apk'))
      ? 'madar-rep-release.apk'
      : existsSync(join(projectRoot, 'madar-rep.apk'))
        ? 'madar-rep.apk'
        : 'madar-rep-release.apk')
);

function assertExistingPathIsSafe(path, { mountDevice, type, label }) {
  const relativePath = relative(storageMountPath, path);
  if (relativePath === '..' || relativePath.startsWith(`..${sep}`)) {
    throw new Error(`${label} must remain beneath STORAGE_MOUNT_PATH.`);
  }

  let currentPath = storageMountPath;
  const segments = relativePath ? relativePath.split(sep) : [];
  for (let index = 0; index <= segments.length; index += 1) {
    if (index > 0) currentPath = join(currentPath, segments[index - 1]);

    let metadata;
    try {
      metadata = lstatSync(currentPath);
    } catch (error) {
      if (error.code === 'ENOENT') break;
      throw error;
    }

    if (metadata.isSymbolicLink()) {
      throw new Error(`${label} must not pass through a symbolic link (${currentPath}).`);
    }
    if (metadata.dev !== mountDevice) {
      throw new Error(`${label} must remain on the STORAGE_MOUNT_PATH filesystem (${currentPath}).`);
    }

    const isTarget = index === segments.length;
    if (!isTarget && !metadata.isDirectory()) {
      throw new Error(`${label} contains a non-directory path component (${currentPath}).`);
    }
    if (isTarget && type === 'directory' && !metadata.isDirectory()) {
      throw new Error(`${label} must be a directory (${currentPath}).`);
    }
    if (isTarget && type === 'file' && !metadata.isFile()) {
      throw new Error(`${label} must be a regular file (${currentPath}).`);
    }
  }
}

if (storageMountPath) {
  if (process.platform !== 'linux') {
    throw new Error('STORAGE_MOUNT_PATH is supported only on Linux; unset it for local development or run MADAR on Ubuntu.');
  }
  let mountMetadata;
  try {
    mountMetadata = lstatSync(storageMountPath);
  } catch (error) {
    if (error.code === 'ENOENT') {
      throw new Error(`STORAGE_MOUNT_PATH does not exist (${storageMountPath}); refusing to create data on the system partition.`, { cause: error });
    }
    throw error;
  }
  if (mountMetadata.isSymbolicLink() || !mountMetadata.isDirectory()) {
    throw new Error(`STORAGE_MOUNT_PATH must be an existing real directory (${storageMountPath}).`);
  }

  try {
    assertMountedStorage({
      mountPath: storageMountPath,
      mountInfo: readFileSync('/proc/self/mountinfo', 'utf8'),
      mountRealPath: realpathSync(storageMountPath),
      mountDevice: mountMetadata.dev,
      rootDevice: statSync('/').dev,
    });
  } catch (error) {
    throw new Error(`STORAGE_MOUNT_PATH startup check failed: ${error.message}`, { cause: error });
  }

  const mountDevice = mountMetadata.dev;
  for (const [path, label] of [
    [dataDirectory, 'MADAR_V2_DATA_DIR'],
    [thumbnailCacheDirectory, 'thumbnail cache directory'],
    [storageRoot, 'MADAR_V2_STORAGE_ROOT'],
    [backupRoot, 'MADAR_V2_BACKUP_ROOT'],
  ]) {
    assertExistingPathIsSafe(path, { mountDevice, type: 'directory', label });
  }
  assertExistingPathIsSafe(databasePath, { mountDevice, type: 'file', label: 'MADAR_V2_DATABASE_PATH' });
  assertExistingPathIsSafe(offlineMapPath, { mountDevice, type: 'file', label: 'MADAR_V2_OFFLINE_MAP_PATH' });
  assertExistingPathIsSafe(`${databasePath}-wal`, { mountDevice, type: 'file', label: 'SQLite WAL file' });
  assertExistingPathIsSafe(`${databasePath}-shm`, { mountDevice, type: 'file', label: 'SQLite shared-memory file' });

  const legacyDatabasePath = join(projectRoot, 'data', 'madar-v2.sqlite');
  let hasLegacyDatabase = false;
  try {
    lstatSync(legacyDatabasePath);
    hasLegacyDatabase = true;
  } catch (error) {
    if (error.code !== 'ENOENT') throw error;
  }
  let hasMountedDatabase = false;
  try {
    hasMountedDatabase = lstatSync(databasePath).isFile();
  } catch (error) {
    if (error.code !== 'ENOENT') throw error;
  }
  if (databasePath !== legacyDatabasePath && hasLegacyDatabase && !hasMountedDatabase) {
    throw new Error(`An existing V2 database is at ${legacyDatabasePath}, but the mounted database is missing at ${databasePath}. Copy and verify the database before enabling STORAGE_MOUNT_PATH; startup will not create an empty replacement.`);
  }
}
</file>

<file path="server/config/storage-layout.js">
import { isAbsolute, join, posix, relative, resolve, sep } from 'node:path';

function optionalPath(value) {
  return typeof value === 'string' && value.trim() ? value.trim() : undefined;
}

function resolveFromProject(projectRoot, value) {
  return isAbsolute(value) ? resolve(value) : resolve(projectRoot, value);
}

function assertInsideMount(mountPath, configuredPath, label) {
  const relativePath = relative(mountPath, configuredPath);
  if (relativePath === '..' || relativePath.startsWith(`..${sep}`) || isAbsolute(relativePath)) {
    throw new Error(`${label} must resolve beneath STORAGE_MOUNT_PATH (${mountPath}).`);
  }
}

export function resolveStorageLayout({
  projectRoot,
  storageMountPath,
  dataDirectory,
  databasePath,
  storageRoot,
  backupRoot,
}) {
  const project = resolve(projectRoot);
  const configuredMount = optionalPath(storageMountPath);
  if (configuredMount && !isAbsolute(configuredMount)) {
    throw new Error('STORAGE_MOUNT_PATH must be an absolute path.');
  }

  const mount = configuredMount ? resolve(configuredMount) : null;
  const resolvedDataDirectory = resolveFromProject(
    project,
    optionalPath(dataDirectory) ?? (mount ? join(mount, 'data') : './data'),
  );
  const resolvedStorageRoot = resolveFromProject(
    project,
    optionalPath(storageRoot) ?? (mount ? join(mount, 'uploads') : '../storage'),
  );
  const resolvedDatabasePath = optionalPath(databasePath)
    ? resolveFromProject(project, optionalPath(databasePath))
    : join(resolvedDataDirectory, 'madar-v2.sqlite');
  const resolvedBackupRoot = resolveFromProject(
    project,
    optionalPath(backupRoot) ?? (mount ? join(mount, 'Backups') : './Backups'),
  );

  if (mount) {
    assertInsideMount(mount, resolvedDataDirectory, 'MADAR_V2_DATA_DIR');
    assertInsideMount(mount, resolvedDatabasePath, 'MADAR_V2_DATABASE_PATH');
    assertInsideMount(mount, resolvedStorageRoot, 'MADAR_V2_STORAGE_ROOT');
    assertInsideMount(mount, resolvedBackupRoot, 'MADAR_V2_BACKUP_ROOT');
  }

  return {
    storageMountPath: mount,
    dataDirectory: resolvedDataDirectory,
    databasePath: resolvedDatabasePath,
    storageRoot: resolvedStorageRoot,
    backupRoot: resolvedBackupRoot,
  };
}

function decodeMountInfoField(value) {
  return value.replace(/\\([0-7]{3})/g, (_match, octal) => String.fromCharCode(Number.parseInt(octal, 8)));
}

export function isLinuxMountPoint(mountPath, mountInfo) {
  const expectedPath = posix.resolve(mountPath);
  return String(mountInfo).split('\n').some((line) => {
    const fields = line.trim().split(' ');
    return fields.length > 4 && decodeMountInfoField(fields[4]) === expectedPath;
  });
}

export function assertMountedStorage({ mountPath, mountInfo, mountRealPath, mountDevice, rootDevice }) {
  if (!posix.isAbsolute(mountPath)) throw new Error('STORAGE_MOUNT_PATH must be absolute.');
  const expectedPath = posix.resolve(mountPath);
  if (posix.resolve(mountRealPath) !== expectedPath) {
    throw new Error(`STORAGE_MOUNT_PATH must not be a symbolic-link path (${expectedPath}).`);
  }
  if (!isLinuxMountPoint(expectedPath, mountInfo)) {
    throw new Error(`STORAGE_MOUNT_PATH is not an active Linux mount point (${expectedPath}); refusing to use the system partition as storage.`);
  }
  if (mountDevice === rootDevice) {
    throw new Error(`STORAGE_MOUNT_PATH (${expectedPath}) is on the same filesystem device as /; configure a separate mounted filesystem.`);
  }
}
</file>

<file path="server/database/connection.js">
import Database from 'better-sqlite3';
import { mkdirSync } from 'node:fs';
import { dirname, isAbsolute, resolve } from 'node:path';
import { databasePath } from '../config/paths.js';

export function createConnection(filePath = databasePath) {
  if (filePath !== ':memory:' && !filePath.startsWith('file:')) {
    const directory = isAbsolute(filePath) ? dirname(filePath) : dirname(resolve(filePath));
    mkdirSync(directory, { recursive: true });
  }

  const connection = new Database(filePath);
  connection.pragma('foreign_keys = ON');
  connection.pragma('journal_mode = WAL');
  connection.pragma('synchronous = NORMAL');
  connection.pragma('busy_timeout = 5000');
  return connection;
}

export const db = createConnection();

/** Run a synchronous callback atomically, rolling back if it throws. */
export function transaction(callback, ...args) {
  if (typeof callback !== 'function') {
    throw new TypeError('transaction() requires a callback.');
  }

  const run = db.transaction((...callbackArgs) => {
    const result = callback(...callbackArgs);
    if (result && typeof result.then === 'function') {
      throw new TypeError('SQLite transactions must use a synchronous callback.');
    }
    return result;
  });

  return run(...args);
}
</file>

