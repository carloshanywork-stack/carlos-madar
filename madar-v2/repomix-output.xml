                const afterPhotos = visit.afterPhotos ?? (visit.afterPhotoUrl ? [{ url: visit.afterPhotoUrl }] : []);
                return <article className="qa-visit-card" key={visit.id}>
                <div className="qa-visit-heading">
                  <div><span className="qa-machine-code" dir="ltr">{visit.machineCode}</span><h3>{visit.machineName}</h3><p>{visit.regionName} · {visit.orderCode}</p></div>
                  <span className="qa-pending-badge">بانتظار الاعتماد</span>
                </div>
                <div className="qa-photo-pair">
                  {beforePhotos.map((photo, index) => <button key={`before-${index}`} type="button" onClick={() => setSelectedVisit({ ...visit, zoomPhoto: 'before', zoomPhotoIndex: index })} aria-label={`تكبير صورة قبل الصيانة ${index + 1}`}><img src={photo.url} alt={`قبل الصيانة ${visit.machineCode} ${index + 1}`} /><span>قبل الصيانة · {index + 1} ↗</span></button>)}
                  {afterPhotos.length
                    ? afterPhotos.map((photo, index) => <button key={`after-${index}`} type="button" onClick={() => setSelectedVisit({ ...visit, zoomPhoto: 'after', zoomPhotoIndex: index })} aria-label={`تكبير صورة بعد الصيانة ${index + 1}`}><img src={photo.url} alt={`بعد الصيانة ${visit.machineCode} ${index + 1}`} /><span>بعد الصيانة · {index + 1} ↗</span></button>)
                    : <div className="qa-photo-missing" role="note"><strong>لا توجد صور بعد الصيانة</strong><small>توثيق هذه المرحلة اختياري للمندوب.</small></div>}
                </div>
                <div className="qa-visit-meta">
                  <span>المندوب <b>{visit.repName}</b></span>
                  <span>حالة الماكينة <b>{visit.machineCondition === 'faulty' ? 'عطلانة' : visit.machineCondition === 'preventive_maintenance' ? 'صيانة وقائية' : 'تعمل'}</b></span>
                  <span>المدة بين الصورتين <b>{formatDuration(visit.siteDurationSeconds)}</b></span>
                  <span>الرفع <b>{formatTime(visit.capturedAt)}</b></span>
                </div>
                <div className="qa-reasons"><strong>أسباب الصيانة</strong><span>{visit.reasonNames.length ? visit.reasonNames.join('، ') : 'لم يُحدد سبب'}</span></div>
                {visit.notes && <p className="qa-rep-note"><strong>ملاحظة المندوب:</strong> {visit.notes}</p>}
                <label className="qa-review-note"><span>ملاحظة المراجعة <small>مطلوبة عند طلب إعادة التصوير</small></span><textarea value={reviewNotes[visit.id] ?? ''} onChange={(event) => setReviewNotes((current) => ({ ...current, [visit.id]: event.target.value }))} placeholder="مثال: أعد تصوير اللوحة من زاوية أوضح مع إضاءة كافية" maxLength={1000} rows={2} /></label>
                <div className="qa-actions">
                  <button type="button" className="qa-approve" disabled={busyVisit === visit.id} onClick={() => void review(visit, 'approve')}>اعتماد الزيارة ✓</button>
                  <button type="button" className="qa-reshoot" disabled={busyVisit === visit.id || !(reviewNotes[visit.id] ?? '').trim()} onClick={() => void review(visit, 'reshoot')}>طلب إعادة تصوير ↻</button>
                </div>
                </article>;
              })}
            </div>
          )}
        </section>
      </div>

      {selectedVisit?.zoomPhoto && <div className="qa-zoom-backdrop" role="presentation" onClick={() => setSelectedVisit(null)}>
        <section role="dialog" aria-modal="true" aria-label="تكبير صورة الزيارة" onClick={(event) => event.stopPropagation()}>
          <header><strong>ماكينة {selectedVisit.machineCode} · {selectedVisit.zoomPhoto === 'before' ? 'قبل الصيانة' : 'بعد الصيانة'}</strong><button type="button" onClick={() => setSelectedVisit(null)} aria-label="إغلاق">×</button></header>
          {(() => {
            const photos = selectedVisit.zoomPhoto === 'before'
              ? (selectedVisit.beforePhotos ?? (selectedVisit.beforePhotoUrl ? [{ url: selectedVisit.beforePhotoUrl }] : []))
              : (selectedVisit.afterPhotos ?? (selectedVisit.afterPhotoUrl ? [{ url: selectedVisit.afterPhotoUrl }] : []));
            const photo = photos[selectedVisit.zoomPhotoIndex ?? 0] ?? photos[0];
            return photo
              ? <><img src={photo.url} alt={`صورة ${selectedVisit.zoomPhoto} للماكينة ${selectedVisit.machineCode}`} /><small>{formatTime(photo.capturedAt)} · {selectedVisit.repName}</small></>
              : <p className="qa-photo-missing">لا توجد صور بعد الصيانة؛ هذه المرحلة اختيارية.</p>;
          })()}
        </section>
      </div>}
    </div>
  );
}
</file>

<file path="client/src/modules/warehouse/WarehousePage.jsx">
import { useCallback, useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import { api } from '../../lib/api.js';
import { egpToCents, errorMessage, formatDate, formatMoney } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import { useToast } from '../../lib/useToast.js';
import Alert from '../../components/ui/Alert.jsx';
import Badge from '../../components/ui/Badge.jsx';
import Button from '../../components/ui/Button.jsx';
import Checkbox from '../../components/ui/Checkbox.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import { Input, Select, Textarea } from '../../components/ui/Field.jsx';
import Icon from '../../components/ui/Icon.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import PageHeader from '../../components/ui/PageHeader.jsx';
import Tabs from '../../components/ui/Tabs.jsx';
import Toast from '../../components/ui/Toast.jsx';

const inventoryTabs = [
  { value: 'materials', label: 'المخزن الرئيسي' },
  { value: 'offcuts', label: 'المخزن الثانوي' },
  { value: 'movements', label: 'حركة المخزون' },
];

export default function WarehousePage({ canMutate = false, canViewFinancialDetails = false }) {
  const [tab, setTab] = useState('materials');
  const { data: materials, loading: materialsLoading, error: materialsError, reload: reloadMaterials } = useApi('/api/warehouse/materials');
  const { data: offcuts, loading: offcutsLoading, error: offcutsError, reload: reloadOffcuts } = useApi('/api/warehouse/offcuts?status=available');
  const { data: movements, loading: movementsLoading, error: movementsError, reload: reloadMovements } = useApi('/api/warehouse/movements');
  const { data: productionOrders } = useApi('/api/workshop/orders?status=in_production');
  const [modal, setModal] = useState('');
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState('');
  const [sourceWarehouse, setSourceWarehouse] = useState('main');
  const [selectedOffcutIds, setSelectedOffcutIds] = useState([]);
  const [stockCount, setStockCount] = useState(null);
  const [countValues, setCountValues] = useState({});
  const [search, setSearch] = useState('');
  const { notice, showToast, clearToast } = useToast();

  const filteredMaterials = useMemo(() => (materials ?? []).filter((item) =>
    `${item.code} ${item.name} ${item.specification ?? ''}`.toLowerCase().includes(search.toLowerCase())), [materials, search]);
  const filteredOffcuts = useMemo(() => (offcuts ?? []).filter((item) =>
    `${item.name} ${item.material_code ?? ''} ${item.dimensions} ${item.origin_workshop_order_code ?? ''}`.toLowerCase().includes(search.toLowerCase())), [offcuts, search]);

  const refreshInventory = useCallback(async () => {
    await Promise.all([reloadMaterials(), reloadOffcuts(), reloadMovements()]);
  }, [reloadMaterials, reloadMovements, reloadOffcuts]);

  async function createMaterial(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      const unitCostCents = egpToCents(form.get('unitCost'), { allowZero: true });
      await api.post('/api/warehouse/materials', {
        code: form.get('code'), name: form.get('name'), specification: form.get('specification') || undefined,
        unit: form.get('unit'), minStock: Number(form.get('minStock') || 0), unitCostCents,
        initialStock: Number(form.get('initialStock') || 0),
      });
      setModal('');
      await refreshInventory();
      showToast('تم إنشاء بطاقة المادة.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function createOffcut(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      await api.post('/api/warehouse/offcuts', {
        name: form.get('name'), dimensions: form.get('dimensions'), quantity: Number(form.get('quantity')),
        unit: form.get('unit'), materialId: form.get('materialId') ? Number(form.get('materialId')) : undefined,
        unitCostCents: egpToCents(form.get('unitCost') || '0', { allowZero: true }), notes: form.get('notes') || undefined,
      });
      setModal('');
      await refreshInventory();
      showToast('تم تسجيل الباقي في المخزن الثانوي.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function issueMaterial(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    const payload = {
      workshopOrderId: Number(form.get('workshopOrderId')),
      sourceWarehouse,
      quantity: Number(form.get('quantity')),
      notes: form.get('notes') || undefined,
    };
    if (sourceWarehouse === 'main') payload.materialId = Number(form.get('materialId'));
    else payload.offcutId = Number(form.get('offcutId'));
    try {
      await api.post('/api/warehouse/issue', payload);
      setModal('');
      await refreshInventory();
      showToast('تم صرف المادة وربط الحركة بأمر الورشة.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function sellScrap(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      const totalSaleAmountCents = egpToCents(form.get('totalSaleAmount'), { allowZero: false });
      await api.post('/api/warehouse/offcuts/scrap-sales', {
        offcutIds: selectedOffcutIds,
        totalSaleAmountCents,
        buyerName: form.get('buyerName') || undefined,
      });
      setModal('');
      setSelectedOffcutIds([]);
      await refreshInventory();
      showToast('سُجل بيع الخردة وأُضيف المبلغ للخزينة.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function startCount() {
    setFormError('');
    try {
      const session = await api.post('/api/warehouse/stock-counts/start', {});
      const initial = {};
      for (const row of session.lines.main) initial[`main:${row.material_id}`] = String(row.snapshot_quantity);
      for (const row of session.lines.offcuts) initial[`offcut:${row.offcut_id}`] = String(row.snapshot_quantity);
      setStockCount(session);
      setCountValues(initial);
      setModal('count');
    } catch (caught) { showToast(errorMessage(caught), 'error'); }
  }

  async function reconcileCount(event) {
    event.preventDefault();
    if (!stockCount) return;
    setSaving(true);
    setFormError('');
    const main = stockCount.lines.main.map((row) => ({ materialId: row.material_id, countedQuantity: Number(countValues[`main:${row.material_id}`]) }));
    const countOffcuts = stockCount.lines.offcuts.map((row) => ({ offcutId: row.offcut_id, countedQuantity: Number(countValues[`offcut:${row.offcut_id}`]) }));
    try {
      await api.post(`/api/warehouse/stock-counts/${stockCount.id}/reconcile`, { main, offcuts: countOffcuts });
      setModal('');
      setStockCount(null);
      await refreshInventory();
      showToast('أُغلقت جلسة الجرد وسُجلت الفروقات.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  const currentError = tab === 'materials' ? materialsError : tab === 'offcuts' ? offcutsError : movementsError;
  const currentLoading = tab === 'materials' ? materialsLoading : tab === 'offcuts' ? offcutsLoading : movementsLoading;

  return (
    <>
      <PageHeader kicker="المواد · المخازن" title="المخزون والمواد" description="متابعة رصيد الألواح في المخزن الرئيسي والقصاصات القابلة لإعادة الاستخدام في المخزن الثانوي." actions={<>{canViewFinancialDetails && <Button variant="secondary" icon="download" onClick={() => { window.location.href = '/api/warehouse/export.xlsx'; }}>تصدير Excel</Button>}{canMutate && <><Button variant="secondary" icon="check" onClick={startCount}>جلسة جرد</Button>{tab === 'materials' ? <Button icon="plus" onClick={() => { setFormError(''); setModal('material'); }}>مادة جديدة</Button> : <Button icon="plus" onClick={() => { setFormError(''); setModal('offcut'); }}>تسجيل باقي</Button>}</>}</>} />
      <div className="madar-warehouse-toolbar madar-section">
        <Tabs items={inventoryTabs} value={tab} onChange={(value) => { setTab(value); setSearch(''); }} ariaLabel="أقسام المخزون" />
        <label className="madar-field madar-search"><Icon name="search" size={15} /><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="بحث في سجل المخزون" aria-label="بحث المخزون" /></label>
        <div className="madar-inline-wrap">
          {canMutate && tab !== 'movements' && <Button variant="secondary" size="small" icon="arrow" onClick={() => { setFormError(''); setSourceWarehouse('main'); setModal('issue'); }}>صرف لأمر ورشة</Button>}
          {canMutate && tab === 'offcuts' && <Button variant="secondary" size="small" icon="wallet" onClick={() => { setSelectedOffcutIds([]); setFormError(''); setModal('scrap'); }}>بيع خردة محددة</Button>}
        </div>
      </div>
      {currentError && <div className="madar-section"><Alert tone="error">{currentError}</Alert></div>}
      <section className="madar-panel madar-section">
        {currentLoading ? <LoadingState label="جارٍ تحميل سجل المخزون" /> : tab === 'materials' ? (
          filteredMaterials.length ? <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>كود المادة</th><th>المادة والمواصفة</th><th>الرصيد</th><th>حد الطلب</th>{canViewFinancialDetails && <th>تكلفة الوحدة</th>}<th>الحالة</th></tr></thead><tbody>{filteredMaterials.map((item) => <tr key={item.id}><td className="madar-code">{item.code}</td><td><div className="madar-table-primary">{item.name}</div><small className="madar-table-muted">{item.specification || '—'}</small></td><td><strong>{item.stock}</strong> {item.unit}</td><td>{item.min_stock} {item.unit}</td>{canViewFinancialDetails && <td className="madar-money">{formatMoney(item.unit_cost_cents)}</td>}<td>{item.is_low_stock ? <Badge tone="warning">مخزون منخفض</Badge> : <Badge tone="success">متاح</Badge>}</td></tr>)}</tbody></table></div> : <EmptyState icon="boxes" title="لا توجد مواد مسجلة" description="أنشئ بطاقة مادة ثم استخدم فاتورة مشتريات لزيادة الرصيد." action={canMutate && <Button icon="plus" onClick={() => setModal('material')}>إضافة مادة</Button>} />
        ) : tab === 'offcuts' ? (
          filteredOffcuts.length ? <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>الباقي</th><th>الأبعاد</th><th>الكمية</th><th>المادة المرتبطة</th><th>مصدره</th><th>تاريخ التسجيل</th></tr></thead><tbody>{filteredOffcuts.map((item) => <tr key={item.id}><td><div className="madar-table-primary">{item.name}</div><small className="madar-code">#{item.id}</small></td><td>{item.dimensions}</td><td>{item.quantity} {item.unit}</td><td>{item.material_code || 'غير مصنف'}</td><td>{item.origin_workshop_order_code ? <Link className="madar-code madar-table-link" to={`/workshop/${item.origin_workshop_order_id}`}>{item.origin_workshop_order_code}</Link> : 'تسجيل يدوي'}</td><td>{formatDate(item.created_at)}</td></tr>)}</tbody></table></div> : <EmptyState icon="boxes" title="المخزن الثانوي فارغ" description="سجل بواقي الإنتاج القابلة لإعادة الاستخدام من أوامر الورشة أو يدوياً." action={canMutate && <Button icon="plus" onClick={() => setModal('offcut')}>تسجيل باقي</Button>} />
        ) : (
          movements?.length ? <div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>التاريخ</th><th>المادة</th><th>نوع الحركة</th><th>الكمية</th><th>المخزن</th><th>المرجع</th><th>ملاحظات</th></tr></thead><tbody>{movements.filter((movement) => `${movement.material_code ?? ''} ${movement.material_name ?? ''} ${movement.reference ?? ''}`.toLowerCase().includes(search.toLowerCase())).map((movement) => <tr key={movement.id}><td>{formatDate(movement.created_at)}</td><td>{movement.material_name ?? 'باقي خامة'}<small className="madar-code madar-block">{movement.material_code ?? ''}</small></td><td><MovementBadge kind={movement.kind} /></td><td>{movement.quantity}</td><td>{movement.warehouse === 'main' ? 'رئيسي' : 'ثانوي'}</td><td>{movement.workshop_order_code ? <Link className="madar-code madar-table-link" to={`/workshop/${movement.source_id}`}>{movement.workshop_order_code}</Link> : <span className="madar-code">{movement.reference || '—'}</span>}</td><td>{movement.notes || '—'}</td></tr>)}</tbody></table></div> : <EmptyState icon="chart" title="لا توجد حركات مخزون" description="تظهر هنا المشتريات والصرف والجرد وبيع الخردة." />
        )}
      </section>

      <Modal open={modal === 'material'} onClose={() => setModal('')} title="إضافة مادة للمخزن الرئيسي" description="الرصيد الابتدائي يسجل حركة شراء افتتاحية في سجل المخزون." wide>
        <form onSubmit={createMaterial}><div className="madar-form-grid">
          <Input label="كود المادة *" name="code" required maxLength={64} placeholder="ACR-3MM-WHITE" />
          <Input label="اسم المادة *" name="name" required maxLength={200} />
          <Input label="المواصفة" name="specification" maxLength={1000} />
          <Input label="وحدة القياس *" name="unit" required maxLength={50} placeholder="لوح" />
          <Input label="الرصيد الافتتاحي" name="initialStock" type="number" min="0" step="1" defaultValue="0" />
          <Input label="حد إعادة الطلب" name="minStock" type="number" min="0" step="1" defaultValue="0" />
          <Input label="تكلفة الوحدة (جنيه) *" name="unitCost" type="text" inputMode="decimal" required defaultValue="0.00" />
        </div>{formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}<div className="madar-form-actions"><Button variant="secondary" onClick={() => setModal('')}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ الحفظ…' : 'حفظ المادة'}</Button></div></form>
      </Modal>

      <Modal open={modal === 'offcut'} onClose={() => setModal('')} title="تسجيل باقي خامة" description="تبقى القصاصات في المخزن الثانوي ويمكن صرفها جزئياً لأمر ورشة.">
        <form onSubmit={createOffcut}><div className="madar-form-grid">
          <Input label="اسم الباقي *" name="name" required maxLength={200} />
          <Input label="الأبعاد أو الوصف *" name="dimensions" required maxLength={200} />
          <Input label="الكمية *" name="quantity" type="number" step="any" min="0.000001" required />
          <Input label="الوحدة *" name="unit" required maxLength={50} />
          <Select className="madar-form-full" label="المادة المرتبطة (اختياري)" name="materialId" defaultValue=""><option value="">بدون ربط</option>{(materials ?? []).map((item) => <option key={item.id} value={item.id}>{item.code} · {item.name}</option>)}</Select>
          <Input label="تكلفة الوحدة (جنيه)" name="unitCost" type="text" inputMode="decimal" defaultValue="0.00" />
          <Textarea className="madar-form-full" label="ملاحظات" name="notes" maxLength={2000} />
        </div>{formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}<div className="madar-form-actions"><Button variant="secondary" onClick={() => setModal('')}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ التسجيل…' : 'تسجيل الباقي'}</Button></div></form>
      </Modal>

      <Modal open={modal === 'issue'} onClose={() => setModal('')} title="صرف خامة لأمر ورشة" description="يُسجل الصرف على أمر في مرحلة الإنتاج فقط.">
        <form onSubmit={issueMaterial}><div className="madar-form-stack">
          <Select label="أمر الورشة *" name="workshopOrderId" required defaultValue=""><option value="" disabled>اختر أمر الإنتاج</option>{(productionOrders ?? []).map((order) => <option key={order.id} value={order.id}>{order.order_code} · {order.product_name} · {order.client_name}</option>)}</Select>
          <Select label="المخزن المصدر *" value={sourceWarehouse} onChange={(event) => setSourceWarehouse(event.target.value)}><option value="main">المخزن الرئيسي</option><option value="secondary">المخزن الثانوي</option></Select>
          {sourceWarehouse === 'main' ? <Select label="المادة *" name="materialId" required defaultValue=""><option value="" disabled>اختر المادة</option>{(materials ?? []).map((item) => <option key={item.id} value={item.id}>{item.code} · {item.name} ({item.stock} {item.unit})</option>)}</Select> : <Select label="الباقي *" name="offcutId" required defaultValue=""><option value="" disabled>اختر الباقي</option>{(offcuts ?? []).map((item) => <option key={item.id} value={item.id}>{item.name} · {item.quantity} {item.unit}</option>)}</Select>}
          <Input label="الكمية *" name="quantity" type="number" min="0.000001" step={sourceWarehouse === 'main' ? '1' : 'any'} required />
          <Textarea label="ملاحظات" name="notes" maxLength={2000} />
          <Alert tone="info">الصرف من المخزن الرئيسي يكون بوحدات صحيحة. استخدم المخزن الثانوي للقصاصات الجزئية.</Alert>
        </div>{formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}<div className="madar-form-actions"><Button variant="secondary" onClick={() => setModal('')}>إلغاء</Button><Button type="submit" disabled={saving || !productionOrders?.length}>{saving ? 'جارٍ الصرف…' : 'تأكيد الصرف'}</Button></div></form>
      </Modal>

      <Modal open={modal === 'scrap'} onClose={() => setModal('')} title="بيع خردة وبواقي" description="حدد بواقي متاحة، وسيسجل النظام إيراد البيع في الخزينة.">
        <form onSubmit={sellScrap}><div className="madar-form-stack">
          <div className="madar-scrap-picker">{(offcuts ?? []).map((item) => <Checkbox key={item.id} checked={selectedOffcutIds.includes(item.id)} onChange={(event) => setSelectedOffcutIds((current) => event.target.checked ? [...current, item.id] : current.filter((id) => id !== item.id))} title={item.name} description={`${item.dimensions} · ${item.quantity} ${item.unit}`} />)}</div>
          {!offcuts?.length && <EmptyState icon="boxes" title="لا توجد بواقي متاحة" description="حدد بواقي متاحة للبيع أولاً." />}
          <Input label="إجمالي قيمة البيع (جنيه) *" name="totalSaleAmount" type="text" inputMode="decimal" required placeholder="0.00" />
          <Input label="اسم المشتري" name="buyerName" maxLength={200} />
        </div>{formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}<div className="madar-form-actions"><Button variant="secondary" onClick={() => setModal('')}>إلغاء</Button><Button type="submit" disabled={saving || !selectedOffcutIds.length}>{saving ? 'جارٍ التسجيل…' : 'تأكيد البيع'}</Button></div></form>
      </Modal>

      <Modal open={modal === 'count'} onClose={() => setModal('')} title="جلسة جرد فعلي" description={stockCount ? `جلسة رقم ${stockCount.id} · أدخل الكميات الفعلية ثم أكد التسوية.` : ''} wide>
        {stockCount && <form onSubmit={reconcileCount}><div className="madar-count-sections">
          <CountSection title="المخزن الرئيسي" rows={stockCount.lines.main} keyPrefix="main" countValues={countValues} setCountValues={setCountValues} />
          <CountSection title="المخزن الثانوي" rows={stockCount.lines.offcuts} keyPrefix="offcut" countValues={countValues} setCountValues={setCountValues} />
        </div>{formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}<div className="madar-form-actions"><Button variant="secondary" onClick={() => setModal('')}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ التسوية…' : 'حفظ الجرد والتسوية'}</Button></div></form>}
      </Modal>
      <Toast notice={notice} onClose={clearToast} />
    </>
  );
}

function MovementBadge({ kind }) {
  const labels = { purchase: 'شراء / استلام', issue: 'صرف للإنتاج', scrap_sale: 'بيع خردة', variance_gain: 'زيادة جرد', variance_loss: 'نقص جرد' };
  const tones = { purchase: 'success', issue: 'info', scrap_sale: 'warning', variance_gain: 'success', variance_loss: 'danger' };
  return <Badge tone={tones[kind] ?? 'info'}>{labels[kind] ?? kind}</Badge>;
}

function CountSection({ title, rows, keyPrefix, countValues, setCountValues }) {
  return (
    <section className="madar-count-section"><div className="madar-section-head"><h3 className="madar-section-title">{title}</h3><span className="madar-badge">{rows.length}</span></div>
      {rows.length ? <div className="madar-count-list">{rows.map((row) => {
        const rowId = keyPrefix === 'main' ? row.material_id : row.offcut_id;
        const id = `${keyPrefix}:${rowId}`;
        const label = keyPrefix === 'main' ? `${row.material_code} · ${row.material_name}` : `${row.name} · ${row.dimensions}`;
        return <div className="madar-count-row" key={id}><div><strong>{label}</strong><small>الرصيد بالنظام: {row.snapshot_quantity} {row.unit}</small></div><label className="madar-field"><span>المعدود</span><input type="number" min="0" step="any" required value={countValues[id] ?? ''} onChange={(event) => setCountValues((current) => ({ ...current, [id]: event.target.value }))} /></label></div>;
      })}</div> : <div className="madar-picker-empty">لا توجد عناصر في هذا المخزن.</div>}
    </section>
  );
}
</file>

<file path="client/src/modules/workshop/WorkshopOrderDetail.jsx">
import { useCallback, useState } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { api } from '../../lib/api.js';
import { errorMessage, formatDate, formatMoney } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import { useToast } from '../../lib/useToast.js';
import Alert from '../../components/ui/Alert.jsx';
import Badge from '../../components/ui/Badge.jsx';
import Button from '../../components/ui/Button.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import Icon from '../../components/ui/Icon.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import PageHeader from '../../components/ui/PageHeader.jsx';
import Toast from '../../components/ui/Toast.jsx';

export default function WorkshopOrderDetail({ canMutate = false, canViewFinance = false }) {
  const { id } = useParams();
  const navigate = useNavigate();
  const { data: order, loading, error, reload } = useApi(`/api/workshop/orders/${id}`);
  const [saving, setSaving] = useState(false);
  const [dragging, setDragging] = useState(false);
  const { notice, showToast, clearToast } = useToast();

  const uploadDesign = useCallback(async (files) => {
    const file = files?.[0];
    if (!file) return;
    const form = new FormData();
    form.append('file', file);
    setSaving(true);
    try {
      await api.upload(`/api/workshop/orders/${id}/designs`, form);
      await reload();
      showToast('تم رفع ملف التصميم المتجهي.');
    } catch (caught) { showToast(errorMessage(caught), 'error'); }
    finally { setSaving(false); }
  }, [id, reload, showToast]);

  async function markReady() {
    setSaving(true);
    try {
      await api.post(`/api/workshop/orders/${id}/ready`, { offcuts: [] });
      await reload();
      showToast('تم تحويل الأمر إلى جاهز للتسليم.');
    } catch (caught) { showToast(errorMessage(caught), 'error'); }
    finally { setSaving(false); }
  }

  async function deliver() {
    if (!window.confirm(`تأكيد تسليم ${order.order_code}؟ سيتم إنشاء فاتورة بيع وتحصيلها نقداً.`)) return;
    setSaving(true);
    try {
      const result = await api.post(`/api/workshop/orders/${id}/deliver`, {});
      await reload();
      showToast(canViewFinance && result.invoice
        ? `تم التسليم وتسجيل التحصيل النقدي. رقم الفاتورة ${result.invoice.code}.`
        : 'تم التسليم وتسجيل قيمة البيع نقداً في الخزينة.');
    } catch (caught) { showToast(errorMessage(caught), 'error'); }
    finally { setSaving(false); }
  }

  if (loading && !order) return <LoadingState label="جارٍ تحميل أمر الورشة" />;
  if (error) return <><PageHeader title="أمر الورشة" actions={<Button variant="secondary" onClick={() => navigate('/workshop')}>العودة للقائمة</Button>} /><Alert tone="error">{error}</Alert></>;

  return (
    <>
      <PageHeader kicker="تفاصيل الإنتاج" title={order.order_code} description="مواصفات المنتج وملفات التصميم ومسار التسليم." actions={<Button variant="secondary" icon="arrow" onClick={() => navigate('/workshop')}>كل أوامر الورشة</Button>} />
      <section className="madar-panel madar-order-hero">
        <div>
          <div className="madar-inline"><h2 className="madar-order-client">{order.product_name}</h2><Badge status={order.status} /></div>
          <div className="madar-order-meta">
            <span>العميل <strong>{order.client?.name}</strong></span><span>الآلة <strong>{order.machine_type}</strong></span>
            <span>موعد التسليم <strong>{formatDate(order.target_delivery_date)}</strong></span>{canViewFinance && <span>السعر <strong className="madar-money">{formatMoney(order.sale_price_cents)}</strong></span>}
            <span>الفنيون <strong>{order.technicians.map((item) => item.name).join('، ') || 'غير معيّنين'}</strong></span>
          </div>
          {order.description && <p className="madar-order-notes">{order.description}</p>}
        </div>
        <div className="madar-inline-wrap">
          {canMutate && order.status === 'in_production' && <Button icon="check" disabled={saving} onClick={markReady}>جاهز للتسليم</Button>}
          {canMutate && order.status === 'ready' && <Button icon="arrow" disabled={saving} onClick={deliver}>تسليم وتحصيل نقدي</Button>}
        </div>
      </section>
      {canViewFinance && order.salesInvoice && <div className="madar-alert madar-alert-success madar-section"><Icon name="file" size={15} /> فاتورة البيع <strong className="madar-code">{order.salesInvoice.code}</strong> · {formatMoney(order.salesInvoice.total_cents)} · <Badge status={order.salesInvoice.payment_status} /></div>}

      <section className="madar-panel madar-section">
        <div className="madar-panel-header"><div><h2>ملفات التصميم المتجهي</h2><p>ملفات جاهزة للتنزيل لمشغلي CNC وLaser · DXF, CDR, AI, PDF</p></div>{order.status !== 'delivered_archived' && <span className="madar-badge madar-badge-info">حد أقصى 40 MB</span>}</div>
        <div className="madar-panel-body madar-stack">
          {order.designFiles.length ? <div className="madar-file-list">{order.designFiles.map((file) => (
            <a className="madar-file-link" href={file.download_url} key={file.id}><span className="madar-file-type">{file.extension.slice(1).toUpperCase()}</span><span className="madar-file-copy"><strong>{file.original_name}</strong><small>{(file.byte_size / 1024 / 1024).toFixed(2)} MB · {formatDate(file.created_at)}</small></span><Icon name="download" size={15} /></a>
          ))}</div> : <EmptyState icon="file" title="لا توجد ملفات تصميم" description="ارفع ملف الرسم المتجهي المرتبط بهذا الأمر." />}
          {canMutate && order.status !== 'delivered_archived' && <label className={`madar-upload-zone ${dragging ? 'dragging' : ''}`} onDragOver={(event) => { event.preventDefault(); setDragging(true); }} onDragLeave={() => setDragging(false)} onDrop={(event) => { event.preventDefault(); setDragging(false); uploadDesign(event.dataTransfer.files); }}>
            <input className="madar-visually-hidden" type="file" accept=".dxf,.cdr,.ai,.pdf,application/pdf" onChange={(event) => { uploadDesign(event.target.files); event.target.value = ''; }} disabled={saving} />
            <span><Icon name="upload" size={22} /><strong>{saving ? 'جارٍ رفع الملف…' : 'اسحب ملف التصميم هنا أو اختر ملفاً'}</strong><small>الامتدادات المسموحة: .dxf · .cdr · .ai · .pdf</small></span>
          </label>}
        </div>
      </section>

      {order.materialConsumption?.length > 0 && <section className="madar-panel madar-section"><div className="madar-panel-header"><div><h2>حركة المواد المرتبطة</h2><p>مصدر الصرف ومخزون الورشة</p></div></div><div className="madar-table-wrap"><table className="madar-table"><thead><tr><th>المادة</th><th>المخزن</th><th>المرجع</th><th>التاريخ</th></tr></thead><tbody>{order.materialConsumption.map((movement) => <tr key={movement.id}><td>{movement.material_name} · {movement.material_code ?? ''}</td><td>{movement.warehouse === 'main' ? 'رئيسي' : 'ثانوي'}</td><td className="madar-code">{movement.reference}</td><td>{formatDate(movement.created_at)}</td></tr>)}</tbody></table></div></section>}
      <Toast notice={notice} onClose={clearToast} />
    </>
  );
}
</file>

<file path="client/src/modules/workshop/WorkshopPage.jsx">
import { useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import { api } from '../../lib/api.js';
import { egpToCents, errorMessage, formatDate, formatMoney } from '../../lib/format.js';
import { useApi } from '../../lib/useApi.js';
import { useToast } from '../../lib/useToast.js';
import Alert from '../../components/ui/Alert.jsx';
import Badge from '../../components/ui/Badge.jsx';
import Button from '../../components/ui/Button.jsx';
import Checkbox from '../../components/ui/Checkbox.jsx';
import EmployeeCheckboxList from '../../components/ui/EmployeeCheckboxList.jsx';
import EmptyState from '../../components/ui/EmptyState.jsx';
import { Input, Select, Textarea } from '../../components/ui/Field.jsx';
import Icon from '../../components/ui/Icon.jsx';
import LoadingState from '../../components/ui/LoadingState.jsx';
import Modal from '../../components/ui/Modal.jsx';
import PageHeader from '../../components/ui/PageHeader.jsx';
import Tabs from '../../components/ui/Tabs.jsx';
import Toast from '../../components/ui/Toast.jsx';

const stages = [
  { value: 'in_production', label: 'قيد التشغيل' },
  { value: 'ready', label: 'جاهز للتسليم' },
  { value: 'delivered_archived', label: 'تم التسليم ومؤرشف' },
];
const machineLabels = { cnc_router: 'CNC Router', laser: 'Laser', both: 'Both', manual: 'Manual' };

export default function WorkshopPage({ canMutate = false, canViewFinance = false }) {
  const [stage, setStage] = useState('in_production');
  const { data: orders, loading, error, reload } = useApi(`/api/workshop/orders?status=${stage}`);
  const { data: clients } = useApi('/api/clients');
  const { data: materials } = useApi('/api/warehouse/materials');
  const [createOpen, setCreateOpen] = useState(false);
  const [readyOrder, setReadyOrder] = useState(null);
  const [selectedTechnicians, setSelectedTechnicians] = useState([]);
  const [registerOffcut, setRegisterOffcut] = useState(false);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState('');
  const [search, setSearch] = useState('');
  const { notice, showToast, clearToast } = useToast();
  const filtered = useMemo(() => (orders ?? []).filter((order) =>
    `${order.order_code} ${order.client_name} ${order.product_name}`.toLowerCase().includes(search.toLowerCase())), [orders, search]);

  async function createOrder(event) {
    event.preventDefault();
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      const salePriceCents = egpToCents(form.get('salePrice'), { allowZero: true });
      await api.post('/api/workshop/orders', {
        clientId: Number(form.get('clientId')),
        productName: form.get('productName'),
        description: form.get('description') || undefined,
        machineType: form.get('machineType'),
        targetDeliveryDate: form.get('targetDeliveryDate'),
        salePriceCents,
        technicianIds: selectedTechnicians,
      });
      setCreateOpen(false);
      setSelectedTechnicians([]);
      if (stage !== 'in_production') setStage('in_production');
      else await reload();
      showToast('تم إنشاء أمر تشغيل جديد.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function markReady(event) {
    event.preventDefault();
    if (!readyOrder) return;
    setSaving(true);
    setFormError('');
    const form = new FormData(event.currentTarget);
    try {
      const offcuts = registerOffcut ? [{
        name: form.get('offcutName'),
        dimensions: form.get('offcutDimensions'),
        quantity: Number(form.get('offcutQuantity')),
        unit: form.get('offcutUnit'),
        materialId: form.get('materialId') ? Number(form.get('materialId')) : undefined,
      }] : [];
      await api.post(`/api/workshop/orders/${readyOrder.id}/ready`, { offcuts });
      setReadyOrder(null);
      setRegisterOffcut(false);
      await reload();
      showToast('تم تحويل الأمر إلى جاهز للتسليم.');
    } catch (caught) { setFormError(errorMessage(caught)); }
    finally { setSaving(false); }
  }

  async function deliverOrder(order) {
    if (!window.confirm(`تأكيد تسليم ${order.order_code}؟ سيتم إنشاء فاتورة بيع تلقائياً.`)) return;
    setSaving(true);
    try {
      const delivered = await api.post(`/api/workshop/orders/${order.id}/deliver`, {});
      if (stage !== 'delivered_archived') setStage('delivered_archived');
      else await reload();
      showToast(canViewFinance
        ? `تم التسليم والتحصيل النقدي. أُنشئت الفاتورة ${delivered.invoice.code} بقيمة ${formatMoney(delivered.invoice.total_cents)}.`
        : 'تم التسليم وتسجيل قيمة البيع نقداً في الخزينة.');
    } catch (caught) { showToast(errorMessage(caught), 'error'); }
    finally { setSaving(false); }
  }

  return (
    <>
      <PageHeader kicker="الإنتاج · الورشة" title="أوامر تشغيل الورشة" description="ثلاث مراحل واضحة من بدء التصنيع حتى تحصيل قيمة البيع نقداً عند التسليم والأرشفة." actions={canMutate && <Button icon="plus" onClick={() => { setFormError(''); setSelectedTechnicians([]); setCreateOpen(true); }}>إنشاء أمر تشغيل</Button>} />
      <div className="madar-list-toolbar madar-section">
        <Tabs items={stages.map((item) => ({ ...item, count: stage === item.value ? orders?.length : undefined }))} value={stage} onChange={setStage} ariaLabel="مراحل تشغيل الورشة" />
        <label className="madar-field madar-search"><Icon name="search" size={15} /><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="ابحث برقم الأمر أو العميل أو المنتج" aria-label="بحث أوامر الورشة" /></label>
      </div>
      {error && <div className="madar-section"><Alert tone="error">{error}</Alert></div>}
      <section className="madar-panel madar-section">
        {loading ? <LoadingState label="جارٍ تحميل أوامر الورشة" /> : filtered.length ? (
          <div className="madar-table-wrap"><table className="madar-table">
            <thead><tr><th>أمر التشغيل</th><th>العميل</th><th>المنتج</th><th>نوع الآلة</th><th>موعد التسليم</th>{canViewFinance && <th>السعر</th>}<th>التصميم</th><th>الحالة</th><th>إجراء</th></tr></thead>
            <tbody>{filtered.map((order) => (
              <tr key={order.id}>
                <td><Link className="madar-table-link madar-code" to={`/workshop/${order.id}`}>{order.order_code}</Link></td>
                <td><div className="madar-table-primary">{order.client_name}</div><small className="madar-code">{order.client_code}</small></td>
                <td>{order.product_name}</td><td>{machineLabels[order.machine_type] ?? order.machine_type}</td>
                <td>{formatDate(order.target_delivery_date)}</td>{canViewFinance && <td className="madar-money">{formatMoney(order.sale_price_cents)}</td>}
                <td>{order.design_file_count}</td><td><Badge status={order.status} /></td>
                <td>{canMutate && order.status === 'in_production' ? <Button size="small" variant="secondary" icon="check" onClick={() => { setFormError(''); setReadyOrder(order); }}>جاهز</Button> : canMutate && order.status === 'ready' ? <Button size="small" icon="arrow" disabled={saving} onClick={() => deliverOrder(order)}>تسليم</Button> : <span className="madar-table-muted">—</span>}</td>
              </tr>
            ))}</tbody>
          </table></div>
        ) : <EmptyState icon="factory" title={search ? 'لا توجد نتائج مطابقة' : 'لا توجد أوامر في هذه المرحلة'} description={search ? 'راجع كلمة البحث ثم حاول مرة أخرى.' : canMutate ? 'أنشئ أمر تشغيل لتسجيل المنتج والآلة وموعد التسليم.' : 'لا توجد أوامر تشغيل مسجلة في هذه المرحلة.'} action={canMutate && stage === 'in_production' && !search && <Button icon="plus" onClick={() => setCreateOpen(true)}>إنشاء أمر تشغيل</Button>} />}
      </section>

      {canMutate && <Modal open={createOpen} onClose={() => setCreateOpen(false)} title="إنشاء أمر تشغيل" description="تُحفظ الأسعار بالجنيه إلى سنتات صحيحة، وتُسجل فاتورة البيع ومتحصلها النقدي معاً عند التسليم فقط." wide>
        <form onSubmit={createOrder}>
          <div className="madar-form-grid">
            <Select className="madar-form-full" label="العميل *" name="clientId" required defaultValue=""><option value="" disabled>اختر العميل</option>{(clients ?? []).map((client) => <option key={client.id} value={client.id}>{client.name} · {client.code}</option>)}</Select>
            <Input label="اسم المنتج *" name="productName" required maxLength={300} placeholder="مثال: لوحة واجهة أكريليك" />
            <Select label="نوع الآلة *" name="machineType" required defaultValue="cnc_router"><option value="cnc_router">CNC Router</option><option value="laser">Laser</option><option value="both">Both</option><option value="manual">Manual</option></Select>
            <Input label="موعد التسليم المتوقع *" name="targetDeliveryDate" type="date" required />
            <Input label="سعر البيع (جنيه) *" name="salePrice" type="text" inputMode="decimal" required placeholder="0.00" hint="حتى منزلتين عشريتين. تُسجل الفاتورة والتحصيل النقدي معاً عند التسليم." />
            <Textarea className="madar-form-full" label="وصف أو مواصفات" name="description" maxLength={10000} />
            <div className="madar-form-full"><EmployeeCheckboxList department="Workshop" selectedIds={selectedTechnicians} onChange={setSelectedTechnicians} title="الفنيون المكلّفون (اختياري)" /></div>
          </div>
          {formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}
          {!clients?.length && <div className="madar-form-note"><Alert tone="info">أضف ملف عميل أولاً قبل إنشاء أمر تشغيل.</Alert></div>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setCreateOpen(false)}>إلغاء</Button><Button type="submit" disabled={saving || !clients?.length}>{saving ? 'جارٍ الإنشاء…' : 'إنشاء أمر التشغيل'}</Button></div>
        </form>
      </Modal>}

      {canMutate && <Modal open={readyOrder !== null} onClose={() => { setReadyOrder(null); setRegisterOffcut(false); }} title="إنهاء مرحلة التصنيع" description={readyOrder ? `${readyOrder.order_code} · يمكنك تسجيل بواقي الخامة في المخزن الثانوي.` : ''}>
        <form onSubmit={markReady}>
          <div className="madar-form-stack">
            <Checkbox checked={registerOffcut} onChange={(event) => setRegisterOffcut(event.target.checked)} label="تسجيل باقي خامة قابل لإعادة الاستخدام" />
            {registerOffcut && <div className="madar-form-grid madar-offcut-form">
              <Input label="اسم الخامة *" name="offcutName" required maxLength={200} />
              <Input label="الأبعاد أو الوصف *" name="offcutDimensions" required maxLength={200} />
              <Input label="الكمية *" name="offcutQuantity" type="number" step="any" min="0.000001" required />
              <Input label="الوحدة *" name="offcutUnit" required maxLength={50} placeholder="لوح، متر، كجم…" />
              <Select className="madar-form-full" label="ربط بمادة (اختياري)" name="materialId" defaultValue=""><option value="">بدون ربط</option>{(materials ?? []).map((material) => <option key={material.id} value={material.id}>{material.code} · {material.name}</option>)}</Select>
            </div>}
          </div>
          {formError && <div className="madar-form-error"><Alert tone="error">{formError}</Alert></div>}
          <div className="madar-form-actions"><Button variant="secondary" onClick={() => setReadyOrder(null)}>إلغاء</Button><Button type="submit" disabled={saving}>{saving ? 'جارٍ التحديث…' : 'تأكيد الجاهزية'}</Button></div>
        </form>
      </Modal>}
      <Toast notice={notice} onClose={clearToast} />
    </>
  );
}
</file>

<file path="client/src/styles/auth.css">
#madar-app .auth-screen,
#madar-app .auth-unavailable {
  --auth-ink: #17263c;
  --auth-muted: #738197;
  --auth-border: #e3e9ee;
  --auth-card: #fff;
  --auth-canvas: #f4f6f7;
  --auth-soft: #f7f9fa;
  --auth-green: #167b68;
  --auth-green-dark: #116552;
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  padding: 26px clamp(20px, 6vw, 88px) 22px;
  overflow: hidden;
  color: var(--auth-ink);
  background: var(--auth-canvas);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  transition: background .2s ease, color .2s ease;
}

#madar-app[data-theme="dark"] .auth-screen,
#madar-app[data-theme="dark"] .auth-unavailable {
  --auth-ink: #ecf1f6;
  --auth-muted: #9caabd;
  --auth-border: #2b3a4b;
  --auth-card: #182434;
  --auth-canvas: #101925;
  --auth-soft: #202e3f;
  --auth-green: #62c5a7;
  --auth-green-dark: #3da889;
}

#madar-app .auth-header,
#madar-app .auth-footer {
  z-index: 1;
  display: flex;
  width: min(100%, 1240px);
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-inline: auto;
}

#madar-app .auth-wordmark { display: inline-flex; align-items: center; gap: 11px; }
#madar-app .auth-brand-mark { display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid #d5b773; border-radius: 14px; color: #f2c76e; background: #19283b; box-shadow: 0 8px 20px rgba(17, 35, 54, .12); font-size: 16px; font-weight: 900; letter-spacing: -.08em; }
#madar-app .auth-brand-copy { display: grid; gap: 2px; }
#madar-app .auth-brand-copy strong { color: var(--auth-ink); font-size: 28px; font-weight: 900; letter-spacing: .16em; line-height: 1.1; }
#madar-app .auth-brand-copy small { color: var(--auth-muted); font-size: 9px; font-weight: 750; letter-spacing: 0; }
#madar-app .auth-theme-toggle { display: inline-flex; min-height: 38px; align-items: center; gap: 8px; padding: 0 13px; border: 1px solid var(--auth-border); border-radius: 999px; color: var(--auth-muted); background: var(--auth-card); cursor: pointer; font-size: 11px; font-weight: 700; transition: border-color .15s, color .15s, transform .15s; }
#madar-app .auth-theme-toggle:hover { border-color: var(--auth-green); color: var(--auth-green); transform: translateY(-1px); }
#madar-app .auth-theme-toggle span { color: var(--auth-green); font-size: 17px; line-height: 1; }

#madar-app .auth-layout { display: grid; width: min(100%, 1120px); min-height: 620px; flex: 1; grid-template-columns: 1.04fr .96fr; align-items: stretch; margin: 28px auto 30px; border: 1px solid var(--auth-border); border-radius: 25px; background: var(--auth-card); box-shadow: 0 28px 85px rgba(23, 38, 60, .09); }
#madar-app .auth-story { position: relative; display: flex; min-height: 620px; flex-direction: column; justify-content: space-between; overflow: hidden; padding: clamp(34px, 5vw, 64px); border-radius: 24px 0 0 24px; color: #edf3f7; background: radial-gradient(ellipse at 15% 12%, rgba(46, 123, 105, .29), transparent 42%), linear-gradient(145deg, #192b40 0%, #142235 55%, #102031 100%); }
#madar-app .auth-story::after { position: absolute; right: -140px; bottom: -220px; width: 490px; height: 490px; border: 1px solid rgba(216, 177, 103, .17); border-radius: 50%; content: ""; box-shadow: 0 0 0 38px rgba(216, 177, 103, .025), 0 0 0 78px rgba(216, 177, 103, .02); }
#madar-app .auth-story-orbit { position: absolute; z-index: 0; border: 1px solid rgba(225, 190, 122, .16); border-radius: 50%; pointer-events: none; }
#madar-app .auth-story-orbit-one { top: 82px; right: -44px; width: 180px; height: 180px; }
#madar-app .auth-story-orbit-two { top: 122px; right: -5px; width: 100px; height: 100px; border-color: rgba(105, 196, 164, .25); }
#madar-app .auth-story-content { position: relative; z-index: 1; max-width: 450px; margin-block: auto; }
#madar-app .auth-eyebrow { display: inline-flex; align-items: center; gap: 9px; color: #a7c4c2; font-size: 9px; font-weight: 800; letter-spacing: .17em; }
#madar-app .auth-eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: #6bd2ae; box-shadow: 0 0 0 4px rgba(107, 210, 174, .12); }
#madar-app .auth-story h1 { max-width: 430px; margin: 24px 0 14px; color: #f4f6f8; font-size: clamp(33px, 4vw, 48px); font-weight: 680; letter-spacing: -.055em; line-height: 1.1; }
#madar-app .auth-story-content > p { max-width: 365px; margin: 0; color: #b3c1cf; font-size: 13px; line-height: 1.8; }
#madar-app .auth-story-points { display: grid; gap: 15px; margin-top: 37px; }
#madar-app .auth-story-points span { display: flex; align-items: center; gap: 12px; color: #d1dae3; font-size: 11px; }
#madar-app .auth-story-points i { display: grid; width: 27px; height: 27px; place-items: center; border: 1px solid rgba(255,255,255,.12); border-radius: 8px; color: #8bd0bb; font-size: 8px; font-style: normal; font-weight: 800; }
#madar-app .auth-story-foot { position: relative; z-index: 1; display: flex; justify-content: space-between; gap: 15px; color: #8193a8; font-size: 8px; font-weight: 800; letter-spacing: .15em; }
#madar-app .auth-story-foot span:last-child { color: #d5b873; }

#madar-app .auth-card-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: clamp(25px, 5vw, 62px); }
#madar-app .auth-card { width: min(100%, 390px); }
#madar-app .auth-card-kicker { margin-bottom: 11px; color: var(--auth-green); font-size: 9px; font-weight: 850; letter-spacing: .17em; }
#madar-app .auth-card h2 { margin: 0; color: var(--auth-ink); font-size: clamp(25px, 3vw, 31px); font-weight: 760; letter-spacing: -.04em; line-height: 1.2; }
#madar-app .auth-card-description { margin: 10px 0 26px; color: var(--auth-muted); font-size: 12px; line-height: 1.7; }
#madar-app .auth-account-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin: -10px 0 13px; padding: 4px; border: 1px solid var(--auth-border); border-radius: 11px; background: var(--auth-soft); }
#madar-app .auth-account-switch button { min-height: 38px; border-radius: 8px; color: var(--auth-muted); background: transparent; cursor: pointer; font-size: 10px; font-weight: 800; }
#madar-app .auth-account-switch button.active { color: #fff; background: var(--auth-green); box-shadow: 0 3px 9px rgba(12,88,68,.16); }
#madar-app .auth-server-status { display: flex; min-height: 35px; align-items: center; gap: 8px; margin-bottom: 14px; padding: 0 10px; border: 1px solid #ead4a4; border-radius: 9px; color: #745313; background: #fff8e6; font-size: 9px; font-weight: 750; }
#madar-app .auth-server-status i { width: 8px; height: 8px; border-radius: 50%; background: #bd8419; }
#madar-app .auth-server-status.online { border-color: #bbd9cb; color: #165d47; background: #edf7f1; }
#madar-app .auth-server-status.online i { background: #198267; box-shadow: 0 0 0 3px rgba(25,130,103,.12); }
#madar-app .auth-server-status.checking i { animation: madar-auth-pulse 1s ease infinite; }
@keyframes madar-auth-pulse { 50% { opacity: .35; } }
#madar-app .auth-form { display: grid; gap: 16px; }
#madar-app .auth-field { display: grid; gap: 7px; color: var(--auth-ink); font-size: 10px; font-weight: 750; }
#madar-app .auth-field > input,
#madar-app .auth-password-input input { width: 100%; min-height: 46px; padding: 0 13px; border: 1px solid var(--auth-border); border-radius: 10px; outline: none; color: var(--auth-ink); background: var(--auth-card); font-size: 12px; transition: border-color .15s, box-shadow .15s; }
#madar-app .auth-field input::placeholder { color: #a5afbc; }
#madar-app .auth-field > input:focus,
#madar-app .auth-password-input:focus-within input { border-color: var(--auth-green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--auth-green) 14%, transparent); }
#madar-app .auth-password-input { position: relative; display: block; }
#madar-app .auth-password-input input { padding-right: 58px; }
#madar-app .auth-password-input button { position: absolute; top: 0; right: 9px; min-height: 46px; padding: 0 5px; color: var(--auth-green); background: transparent; cursor: pointer; font-size: 10px; font-weight: 800; }
#madar-app .auth-field small { color: var(--auth-muted); font-size: 9px; font-weight: 500; line-height: 1.6; }
#madar-app .auth-error { margin: -2px 0 0; padding: 10px 12px; border: 1px solid #f0d1d2; border-radius: 9px; color: #a64549; background: #fff5f5; font-size: 10px; line-height: 1.5; }
#madar-app .auth-submit { display: flex; width: 100%; min-height: 47px; align-items: center; justify-content: center; gap: 10px; margin-top: 2px; border-radius: 10px; color: #fff; background: linear-gradient(100deg, var(--auth-green), #1b8b74); box-shadow: 0 8px 16px rgba(22, 123, 104, .18); cursor: pointer; font-size: 11px; font-weight: 800; transition: transform .15s, box-shadow .15s, opacity .15s; }
#madar-app .auth-submit:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 11px 22px rgba(22, 123, 104, .23); }
#madar-app .auth-submit:disabled { cursor: wait; opacity: .65; }
#madar-app .auth-submit span { font-size: 16px; }
#madar-app .auth-submit .auth-submit-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.42); border-top-color: #fff; border-radius: 50%; animation: madar-auth-spin .7s linear infinite; }
@keyframes madar-auth-spin { to { transform: rotate(360deg); } }
#madar-app .auth-security-note { display: flex; align-items: center; gap: 11px; margin-top: 25px; padding-top: 19px; border-top: 1px solid var(--auth-border); }
#madar-app .auth-security-icon { display: grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; border-radius: 10px; color: var(--auth-green); background: color-mix(in srgb, var(--auth-green) 11%, transparent); font-size: 20px; }
#madar-app .auth-security-note > span:last-child { display: grid; gap: 2px; }
#madar-app .auth-security-note strong { color: var(--auth-ink); font-size: 9px; }
#madar-app .auth-security-note small { color: var(--auth-muted); font-size: 8px; }
#madar-app .auth-local-note { display: inline-flex; align-items: center; gap: 7px; margin: 24px 0 0; color: var(--auth-muted); font-size: 8px; font-weight: 800; letter-spacing: .13em; }
#madar-app .auth-local-note > span { width: 6px; height: 6px; border-radius: 50%; background: var(--auth-green); }
#madar-app .auth-local-note b { color: #c5ccd4; }
#madar-app .auth-footer { color: #9aa5b3; font-size: 8px; font-weight: 750; letter-spacing: .12em; }

#madar-app .auth-unavailable { align-items: center; justify-content: center; }
#madar-app .auth-unavailable-card { width: min(100%, 420px); padding: 36px; border: 1px solid var(--auth-border); border-radius: 18px; background: var(--auth-card); box-shadow: 0 20px 60px rgba(23, 38, 60, .1); }
#madar-app .auth-unavailable-card .auth-brand-mark { margin-bottom: 23px; }
#madar-app .auth-unavailable-card .auth-eyebrow { display: block; color: var(--auth-green); }
#madar-app .auth-unavailable-card h1 { margin: 10px 0; color: var(--auth-ink); font-size: 25px; }
#madar-app .auth-unavailable-card p:not(.auth-eyebrow) { margin-bottom: 20px; color: var(--auth-muted); font-size: 12px; line-height: 1.7; }

@media (max-width: 880px) {
  #madar-app .auth-screen { padding-inline: 22px; }
  #madar-app .auth-layout { grid-template-columns: 1fr; max-width: 600px; margin-block: 22px; }
  #madar-app .auth-story { min-height: 280px; padding: 31px; border-radius: 24px 24px 0 0; }
  #madar-app .auth-story-content { margin-block: 8px 20px; }
  #madar-app .auth-story h1 { max-width: 460px; margin-top: 16px; font-size: 34px; }
  #madar-app .auth-story-points { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 22px; }
  #madar-app .auth-story-points span { align-items: flex-start; gap: 7px; font-size: 9px; line-height: 1.5; }
  #madar-app .auth-story-points i { width: 23px; height: 23px; flex: 0 0 auto; }
  #madar-app .auth-card-wrap { padding: 37px 30px 30px; }
  #madar-app .auth-footer { max-width: 600px; }
}

@media (max-width: 520px) {
  #madar-app .auth-screen { padding: 17px 14px 16px; }
  #madar-app .auth-brand-mark { width: 38px; height: 38px; border-radius: 12px; }
  #madar-app .auth-brand-copy strong { font-size: 23px; }
  #madar-app .auth-brand-copy small { font-size: 7px; }
  #madar-app .auth-theme-toggle { min-height: 35px; padding-inline: 10px; font-size: 9px; }
  #madar-app .auth-layout { margin-block: 18px 20px; border-radius: 18px; }
  #madar-app .auth-story { min-height: 260px; padding: 24px 21px; border-radius: 17px 17px 0 0; }
  #madar-app .auth-story h1 { max-width: 330px; font-size: 30px; }
  #madar-app .auth-story-content > p { font-size: 11px; }
  #madar-app .auth-story-points { gap: 7px; }
  #madar-app .auth-story-points span { display: grid; grid-template-columns: 23px 1fr; font-size: 8px; }
  #madar-app .auth-story-foot { font-size: 7px; }
  #madar-app .auth-card-wrap { padding: 29px 21px 24px; }
  #madar-app .auth-card h2 { font-size: 25px; }
  #madar-app .auth-footer { font-size: 7px; }
}

@media (prefers-reduced-motion: reduce) {
  #madar-app .auth-screen *, #madar-app .auth-screen *::before, #madar-app .auth-screen *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
}
</file>

<file path="client/src/styles/base.css">
#madar-app a { color: inherit; text-decoration: none; }
#madar-app button { border: 0; }
#madar-app [hidden] { display: none !important; }
#madar-app h1, #madar-app h2, #madar-app h3, #madar-app p { margin-top: 0; }
#madar-app .madar-app-shell { min-height: 100vh; }
#madar-app .madar-sidebar {
  position: fixed;
  z-index: 30;
  inset: 0 0 0 auto;
  display: flex;
  width: 260px;
  flex-direction: column;
  padding: 24px 16px 18px;
  color: #e9f0f6;
  background: var(--madar-ink);
  box-shadow: -8px 0 28px rgba(19, 37, 60, .08);
}
#madar-app .madar-brand { display: flex; align-items: center; gap: 12px; padding: 0 10px 25px; }
#madar-app .madar-brand-mark {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid rgba(220, 170, 82, .55);
  border-radius: 14px;
  color: #f4c873;
  background: rgba(220, 170, 82, .1);
