# MADAR storage migration — Windows (PowerShell).
#
# Mirrors the Linux script: robocopy (copy -> verify -> rename -> junction).
# NOTHING is deleted. The original storage folder is renamed to
# storage_pre_migration_backup before the junction is created.
#
# Run from the repository root (or anywhere; the root is detected from git):
#   powershell -ExecutionPolicy Bypass -File madar-v2\scripts\migrate-storage-to-d.ps1
# Dry run (shows what would happen, copies nothing):
#   .\migrate-storage-to-d.ps1 -DryRun

[CmdletBinding()]
param(
  [string]$TargetRoot = 'D:\madar-storage',
  [string[]]$Pm2Apps = @('madar-v2', 'madar-autodeploy'),
  [switch]$DryRun
)

$ErrorActionPreference = 'Stop'
$repoRoot = (& git -C $PSScriptRoot rev-parse --show-toplevel).Trim()
$src = Join-Path $repoRoot 'storage'
$backup = Join-Path $repoRoot 'storage_pre_migration_backup'
$dest = $TargetRoot

Write-Host "[migrate-storage] repo: $repoRoot"
Write-Host "[migrate-storage] source: $src"
Write-Host "[migrate-storage] destination (D:): $dest"

if (-not (Test-Path -LiteralPath $src -PathType Container)) { throw "storage folder not found: $src" }
$srcItem = Get-Item -LiteralPath $src -Force
if ($srcItem.LinkType) { Write-Host "[migrate-storage] storage is already a link ($($srcItem.LinkType)); nothing to do."; exit 0 }
if (Test-Path -LiteralPath $backup) { throw "backup path already exists, refusing to overwrite it: $backup" }
if (-not (Test-Path -LiteralPath (Split-Path $dest))) { throw "drive not found or path invalid: $dest" }
if (-not (Test-Path -LiteralPath $dest)) { New-Item -ItemType Directory -Path $dest | Out-Null }

# --- 1. Stop the application -------------------------------------------------
if ($DryRun) {
  Write-Host "[dry-run] would stop PM2 apps: $($Pm2Apps -join ', ')"
} else {
  & pm2 stop @Pm2Apps 2>$null
  if ($LASTEXITCODE -ne 0) { Write-Warning '[migrate-storage] pm2 stop did not complete; check apps manually' }
}

# --- 2. Copy and verify -------------------------------------------------------
$robocopyArgs = @($src, $dest, '/E', '/COPYALL', '/R:2', '/W:2', '/LOG+:C:\madar-storage-migration.log')
if ($DryRun) { $robocopyArgs += '/L' }
Write-Host "[migrate-storage] robocopy $src -> $dest"
& robocopy @robocopyArgs
$robocopyExit = $LASTEXITCODE
if ($robocopyExit -ge 8) { throw "robocopy failed with code $robocopyExit (see C:\madar-storage-migration.log); original untouched" }

function count-and-bytes($path) {
  $files = (Get-ChildItem -LiteralPath $path -Recurse -File -Force)
  $bytes = ($files | Measure-Object -Property Length -Sum).Sum
  [pscustomobject]@{ Files = $files.Count; Bytes = $bytes }
}
$a = count-and-bytes $src
$b = count-and-bytes $dest
Write-Host "[migrate-storage] files: source=$($a.Files) destination=$($b.Files)"
Write-Host "[migrate-storage] bytes: source=$($a.Bytes) destination=$($b.Bytes)"
if ($a.Files -ne $b.Files) { throw 'file count mismatch; original untouched' }
if ($a.Bytes -ne $b.Bytes) { throw 'byte total mismatch; original untouched' }

# --- 3. Rename original, create junction -------------------------------------
if ($DryRun) {
  Write-Host "[dry-run] would rename $src -> $backup"
  Write-Host "[dry-run] would create junction $src -> $dest"
  Write-Host "[dry-run] would start PM2 apps: $($Pm2Apps -join ', ')"
  exit 0
}
Rename-Item -LiteralPath $src -NewName (Split-Path $backup -Leaf)
& cmd.exe /c mklink /J "`"$src`"" "`"$dest`"" | Out-Null
if ($LASTEXITCODE -ne 0) { throw "mklink /J failed; rename already done — restore manually: Rename-Item $backup $(Split-Path $src -Leaf)" }
if (-not (Test-Path -LiteralPath (Join-Path $src 'Areas'))) { throw "junction read check failed: $src\Areas is not visible" }
Write-Host "[migrate-storage] bridge created: $src -> $dest"

# --- 4. Restart application and probe health ----------------------------------
& pm2 start @Pm2Apps 2>$null
try { (Invoke-WebRequest -Uri 'http://127.0.0.1:3000/api/health' -TimeoutSec 5 -UseBasicParsing).StatusCode }
catch { Write-Warning '[migrate-storage] health check failed; see pm2 logs madar-v2' }

Write-Host "[migrate-storage] done. Backup kept at: $backup"
</file>

<file path="scripts/migrate-storage-to-d.sh">
#!/usr/bin/env bash
set -euo pipefail

# MADAR storage relocation — non-destructive, Linux only.
#
# Copies <repo>/storage to the dedicated ext4 "D:" drive, verifies it, renames
# the original to storage_pre_migration_backup, and replaces it with a symlink
# so the running app keeps using the same path. Nothing is deleted.
#
# Requirements: bash, rsync, find, sha256sum, sudo (to mount the drive).
# Safe to re-run: it aborts if the storage folder is already a symlink, and it
# aborts before touching the original folder if verification fails.

STORAGE_UUID="${MADAR_STORAGE_UUID:-41478fcd-4b9f-4b92-90dc-58a5505424eb}"  # label "d"
MOUNT_POINT="${MADAR_STORAGE_MOUNT:-/mnt/madar-storage}"
DEST_DIR="${MADAR_STORAGE_DEST:-$MOUNT_POINT/madar-storage}"
REPO_ROOT="$(git -C "${MADAR_REPO_ROOT:-$PWD}" rev-parse --show-toplevel)"
SRC="$REPO_ROOT/storage"
BACKUP_DIR="$REPO_ROOT/storage_pre_migration_backup"
PM2_APPS="${MADAR_STORAGE_PM2_APPS:-madar-v2 madar-autodeploy}"

log() { printf '[migrate-storage] %s\n' "$*"; }
die() { printf '[migrate-storage] ERROR: %s\n' "$*" >&2; exit 1; }

run_sudo() {
  if [ "$(id -u)" -eq 0 ]; then "$@"; else
    if [ -n "${MADAR_STORAGE_SUDO_PASS_FILE:-}" ]; then
      printf '%s\n' "$(cat "$MADAR_STORAGE_SUDO_PASS_FILE")" | sudo -S -p '' "$@"
    else
      sudo "$@"
    fi
  fi
}

[ -d "$REPO_ROOT/.git" ] || die "not a repository root: $REPO_ROOT"
[ -e "$SRC" ] || die "storage folder does not exist: $SRC"
if [ -L "$SRC" ]; then
  log "storage is already a symlink -> $(readlink -f "$SRC"); nothing to do."
  exit 0
fi
[ -d "$SRC" ] || die "storage is not a directory: $SRC"
[ ! -e "$BACKUP_DIR" ] || die "backup path already exists, refusing to overwrite it: $BACKUP_DIR"

# --- 1. Make sure the D drive is mounted ...................................
if ! findmnt -n -T "$MOUNT_POINT" >/dev/null 2>&1; then
  log "mounting UUID=$STORAGE_UUID at $MOUNT_POINT"
  run_sudo mkdir -p "$MOUNT_POINT"
  run_sudo mount -U "$STORAGE_UUID" "$MOUNT_POINT"
  run_sudo chown "$(id -u):$(id -g)" "$MOUNT_POINT"
fi
MOUNT_DEVICE="$(findmnt -n -T "$MOUNT_POINT" -o SOURCE)"
LOG_SRC_DEVICE="$(findmnt -n -T "$REPO_ROOT" -o SOURCE)"
[ "$MOUNT_DEVICE" != "$LOG_SRC_DEVICE" ] || die "$MOUNT_POINT is on the same filesystem as the repo; refusing to proceed"
log "source filesystem: $LOG_SRC_DEVICE"
log "destination filesystem: $MOUNT_DEVICE ($MOUNT_POINT)"

run_sudo mkdir -p "$DEST_DIR"
run_sudo chown -R "$(id -u):$(id -g)" "$DEST_DIR"

# --- 2. Stop the application so no file changes mid-copy .....................
if command -v pm2 >/dev/null 2>&1; then
  log "stopping PM2 apps: $PM2_APPS"
  pm2 stop $PM2_APPS || log "warning: could not stop PM2 apps (already stopped?)"
fi

# --- 3. Copy (non-destructive) and verify ------------------------------------
log "copying $SRC -> $DEST_DIR (rsync -aH)"
rsync -aH --info=stats "$SRC"/ "$DEST_DIR"/

SRC_FILES=$(find "$SRC" -type f -printf . | wc -c)
DST_FILES=$(find "$DEST_DIR" -type f -printf . | wc -c)
SRC_DIRS=$(find "$SRC" -type d -printf . | wc -c)
DST_DIRS=$(find "$DEST_DIR" -type d -printf . | wc -c)
SRC_BYTES=$(du -sb "$SRC" | awk '{print $1}')
DST_BYTES=$(du -sb "$DEST_DIR" | awk '{print $1}')
log "files: source=$SRC_FILES destination=$DST_FILES"
log "directories: source=$SRC_DIRS destination=$DST_DIRS"
log "bytes: source=$SRC_BYTES destination=$DST_BYTES"
[ "$SRC_FILES" = "$DST_FILES" ] || die "file count mismatch; original left untouched"
[ "$SRC_DIRS" = "$DST_DIRS" ] || die "directory count mismatch; original left untouched"
[ "$SRC_BYTES" = "$DST_BYTES" ] || die "apparent size mismatch; original left untouched"

log "comparing SHA-256 of every file (this re-reads both trees)"
mapfile -t DIFFS < <(
  diff <(cd "$SRC" && find . -type f -printf '%P\0' | sort -z | xargs -0 -r sha256sum) \
       <(cd "$DEST_DIR" && find . -type f -printf '%P\0' | sort -z | xargs -0 -r sha256sum)
)
if [ "${#DIFFS[@]}" -ne 0 ]; then
  printf '%s\n' "${DIFFS[@]}" >&2
  die "checksum mismatch; original left untouched"
fi

# --- 4. Swap the original for a symlink bridge -------------------------------
log "renaming $SRC -> $BACKUP_DIR"
mv "$SRC" "$BACKUP_DIR"
ln -s "$DEST_DIR" "$SRC"
log "bridge created: $SRC -> $(readlink -f "$SRC")"
[ -d "$SRC/Areas" ] || die "bridge read check failed ($SRC/Areas not visible)"
ls "$SRC"

# --- 5. Restart the application and check health -----------------------------
if command -v pm2 >/dev/null 2>&1; then
  log "starting PM2 apps: $PM2_APPS"
  pm2 start $PM2_APPS || log "warning: could not restart PM2 apps"
fi
if command -v curl >/dev/null 2>&1; then
  sleep 2
  if curl -fsS -m 5 http://127.0.0.1:3000/api/health; then log "health check OK"; else log "warning: health check failed (see: pm2 logs madar-v2)"; fi
fi

log "migration complete. Backup kept at: $BACKUP_DIR"
log "Data on D: lives at: $DEST_DIR"
</file>

<file path="scripts/watcher.cjs">
// Runs the pull-based deploy check every 30 seconds.
// .cjs is required: madar-v2/package.json sets "type": "module".
const { execFile } = require('node:child_process');
const path = require('node:path');

const script = path.join(__dirname, 'auto-pull.sh');
const INTERVAL_MS = 30_000;
let running = false;

function check() {
  if (running) return;
  running = true;
  // Invoke through bash rather than executing the file directly: this repo is
  // checked out with core.fileMode=false, so a fresh clone may lack the exec
  // bit and a direct exec would fail with EACCES.
  execFile('/bin/bash', [script], { timeout: 600_000 }, (error, stdout, stderr) => {
    running = false;
    const out = String(stdout).trim();
    const err = String(stderr).trim();
    if (out) console.log(out);
    if (err) console.error(err);
    if (error) console.error('auto-pull failed:', error.message);
  });
}

check();
setInterval(check, INTERVAL_MS);
console.log(`MADAR auto-deploy watcher started (every ${INTERVAL_MS / 1000}s)`);
</file>

