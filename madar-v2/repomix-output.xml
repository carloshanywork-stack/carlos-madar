    try {
      await api.post(`/api/maintenance/orders/${id}/cards/${card.id}/photos/move`, {
        fromPhase,
        toPhase,
        filename,
      });
      await reload();
      showToast(`تم نقل الصورة إلى مرحلة ${toPhase === 'before' ? 'قبل الصيانة' : 'بعد الصيانة'}.`);
      return true;
    } catch (caught) {
      showToast(errorMessage(caught), 'error');
      return false;
    } finally {
      setSaving(false);
