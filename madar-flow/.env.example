# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# Database
DATABASE_URL=postgres://madar:madar@localhost:5432/madar_flow

# Cache / queue
VALKEY_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
# مطلوب في الإنتاج: مفتاح AES-256-GCM بصيغة base64 (32 بايت)
# توليده: openssl rand -base64 32
CREDENTIALS_KEK=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_GRACE_SECONDS=10
COOKIE_SECURE=false

# Web
CORS_ORIGIN=http://localhost:5173

# Docker Compose infrastructure
POSTGRES_USER=madar
POSTGRES_PASSWORD=madar
POSTGRES_DB=madar_flow
