# Copy this file to .env in the project root before starting the application.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100

# Relative paths are resolved from this project root. Keep storage outside system/.
STORAGE_ROOT_PATH=./storage
DATABASE_URL=file:./system/data/madar.sqlite

# Total multipart request bytes and concurrent authenticated multi-photo uploads.
PHOTO_UPLOAD_MAX_REQUEST_BYTES=1073741824
PHOTO_UPLOAD_MAX_CONCURRENT=2
# Only marked application-owned photo-upload workspaces older than this are cleaned on startup.
PHOTO_UPLOAD_STALE_TEMP_MS=86400000

# Set to true only when serving behind HTTPS in production.
COOKIE_SECURE=false

# Required: set once to at least 32 random bytes; keep this value private and stable.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
