{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "chrome-devtools", "effect": "allow" },
    { "action": "skill", "resource": "capacitor-android-engineer", "effect": "allow" },
    { "action": "skill", "resource": "sqlite-wal-dba", "effect": "allow" },
    { "action": "skill", "resource": "code-review", "effect": "allow" },
    { "action": "skill", "resource": "madar-closed-loop-refactor", "effect": "allow" },
    { "action": "skill", "resource": "madar-erp-core-guidelines", "effect": "allow" }
  ],
  "instructions": [
    ".opencode/skills/madar-erp-core-guidelines/SKILL.md"
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0",
          "--no-usage-statistics",
          "--no-performance-crux"
        ],
        "environment": {
          "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth"
      }
    }
  }
}
